#!/usr/bin/env bash
# Commit gate for raw design values (D-100). Called by pre-commit; covers every tool (Claude, Codex, a person).
# Lints the staged version of each staged .css in lint scope (design-system/src/, projects/*/app/; scope rules
# live in design-system/scripts/check_tokens.py --scoped). Missing linter -> warn and allow (collaborators).
set -u
top=$(git rev-parse --show-toplevel)
checker="$top/design-system/scripts/check_tokens.py"
[ -f "$checker" ] || exit 0
files=()
while IFS= read -r f; do
  case "$f" in design-system/src/*.css|projects/*/app/*.css) files+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#files[@]} -eq 0 ] && exit 0
if [ ! -d "$top/design-system/tools/node_modules" ]; then
  echo "Warning: token lint skipped (design-system/tools/node_modules missing; run: npm install --prefix design-system/tools)." >&2
  exit 0
fi
# Lint what is staged, not the working copy: export staged blobs to a temp tree that mirrors the repo paths.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/tm-staged-css-XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
args=()
for f in "${files[@]}"; do
  mkdir -p "$tmp/$(dirname "$f")"
  git show ":$f" > "$tmp/$f" || { echo "Commit refused: couldn't read staged $f" >&2; exit 1; }
  args+=("$top/$f")
done
# check_tokens reports paths relative to the repo; swap the staged copies in only for the lint call.
out=$(cd "$top" && TM_STAGED_ROOT="$tmp" python3 "$checker" --scoped "${args[@]}" 2>&1); rc=$?
[ $rc -eq 3 ] && { echo "Warning: token lint skipped (linter not installed)." >&2; exit 0; }
[ $rc -eq 0 ] && exit 0
echo "$out" >&2
echo "Commit refused: raw design values in staged CSS. Fix: use a --tm-* token, or add /* raw-ok: <reason> */ on the same line." >&2
exit 1
