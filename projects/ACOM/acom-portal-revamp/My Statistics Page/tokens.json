{
  "$meta": {
    "name": "Acom Agent Portal — My Statistics",
    "source": "Sampled from truemeds.in brand assets (logo + CDN icon SVGs); neutrals and status colours derived to match.",
    "note": "Values marked derived:true were not present on the storefront and were added because a data-dense portal needs them."
  },
  "color": {
    "brand": {
      "blue600": { "value": "#1B69DE", "derived": false, "use": "Primary action, active states, selected tab" },
      "blue700": { "value": "#0F55BC", "derived": true, "use": "Primary hover" },
      "blue800": { "value": "#0A4193", "derived": true, "use": "Primary active, emphasised numeric" },
      "blue300": { "value": "#8DB4EF", "derived": true, "use": "Info icon border on tinted ground" },
      "blue200": { "value": "#C5D9F7", "derived": false, "use": "Funnel stage 1 bar, secondary button border" },
      "blue100": { "value": "#E6EFFC", "derived": false, "use": "Selected chip fill, conversion badge, focus ring" },
      "blue050": { "value": "#F4F8FE", "derived": true, "use": "Row hover" },
      "green600": { "value": "#22B573", "derived": false, "use": "Live dot, shift badge border, funnel stage 3 bar" },
      "green700": { "value": "#22935B", "derived": false, "use": "Positive numerics, delivered, savings" },
      "green100": { "value": "#C8EDDC", "derived": false, "use": "Positive delta badge fill" },
      "sky300": { "value": "#52C7FF", "derived": false, "use": "Illustration only — never text or borders" }
    },
    "ink": {
      "ink900": { "value": "#0F1724", "derived": true, "use": "Primary text, dev bar ground" },
      "ink700": { "value": "#33415C", "derived": true, "use": "Body text, inactive tab label" },
      "ink500": { "value": "#64748B", "derived": true, "use": "Metric labels, metadata, footer" },
      "ink300": { "value": "#94A3B8", "derived": true, "use": "Tertiary hints, section rule grey" }
    },
    "line": {
      "line200": { "value": "#E2E8F0", "derived": true, "use": "Segmented control track" },
      "line150": { "value": "#DCE2EA", "derived": true, "use": "Divider under period bar, chip border, note card border" },
      "line100": { "value": "#EEF2F7", "derived": true, "use": "Bar track, card internal divider, tertiary button fill" }
    },
    "surface": {
      "card": { "value": "#FFFFFF", "derived": false },
      "canvas": { "value": "#F1F2F6", "derived": false, "use": "Portal page ground (matches current portal)" },
      "tile": { "value": "#F7F9FC", "derived": true, "use": "Metric tile inside expanded accordion" },
      "outer": { "value": "#E9ECF2", "derived": true, "use": "Area outside the portal frame (prototype only)" }
    },
    "status": {
      "warningText": { "value": "#8A5A00", "derived": true, "use": "Orders on hold numeric" },
      "warningRule": { "value": "#F2A93B", "derived": true, "use": "Needs-attention section rule" },
      "dangerText": { "value": "#A5170F", "derived": true, "use": "Cancelled, RTO, error heading" },
      "danger600": { "value": "#D93025", "derived": true, "use": "Error card top border" }
    }
  },
  "typography": {
    "fontFamilyUI": "Manrope, system-ui, sans-serif",
    "fontFamilyMono": "'IBM Plex Mono', ui-monospace, monospace",
    "monoRationale": "All numerics use mono so digits are fixed-width and columns of figures stay aligned between period switches.",
    "scale": {
      "pageTitle": { "size": 28, "weight": 700, "lineHeight": 1.2, "tracking": "-0.01em" },
      "sectionTitle": { "size": 16, "weight": 700 },
      "accordionTitle": { "size": 15, "weight": 700 },
      "cardValueXL": { "size": 38, "weight": 700, "lineHeight": 1.1, "font": "mono" },
      "cardValueL": { "size": 30, "weight": 700, "font": "mono" },
      "funnelStage": { "size": 26, "weight": 700, "lineHeight": 1.1, "font": "mono" },
      "tileValue": { "size": 24, "weight": 700, "font": "mono" },
      "convBadge": { "size": 16, "weight": 700, "font": "mono" },
      "stepRate": { "size": 13, "weight": 700, "font": "mono" },
      "bodyLabel": { "size": 13, "weight": 600 },
      "metricLabel": { "size": 12, "weight": 500 },
      "eyebrow": { "size": 11, "weight": 700, "tracking": "0.06em", "transform": "uppercase" }
    }
  },
  "space": { "base": 4, "scale": [4, 6, 8, 10, 12, 14, 18, 20, 26, 32], "cardPadding": "16px 20px 20px", "sectionGap": 26, "cardGap": 14 },
  "radius": { "sm": 6, "md": 8, "lg": 10, "xl": 12, "pill": 99 },
  "shadow": {
    "header": "0 1px 3px rgba(15,23,36,0.07)",
    "card": "0 1px 3px rgba(15,23,36,0.07)",
    "raised": "0 4px 14px rgba(15,23,36,0.16)",
    "frame": "0 8px 30px rgba(15,23,36,0.10)"
  },
  "layout": {
    "designWidth": 1440,
    "verifiedWidths": [1440, 1180, 980, 780],
    "kpiRow": "flex-wrap; funnel card flex:2 1 520px, value card flex:1 1 320px — side by side 1440→980, stacked at 780",
    "attentionGrid": "grid repeat(auto-fit, minmax(260px, 1fr))",
    "accordionGrid": "grid repeat(auto-fit, minmax(180px, 1fr)) — 5 cols at 1440/1180, 4 at 980, 3 at 780",
    "minTouchTarget": 36
  }
}
