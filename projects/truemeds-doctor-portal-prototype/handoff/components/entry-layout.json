 "rules": [
  {
   "section": "Design rules 8.2",
   "text": "**Side margin:** `--tm-space-page` (**16**, the design team's standard — changed from 24 on 2026-10-26, D-67) on every mobile screen, including the header, sheets and the action bar. Every block — fields, notices, cards, code boxes, buttons — shares the same left and right edges."
  },
  {
   "section": "Design rules 8.3",
   "text": "**Spacing is measured on what the eye sees — three gaps only (D-108, 2026-11-11; replaces the box-gap rule).** Measure between **visible edges**, never between layout boxes:"
  },
  {
   "section": "Design rules 8.4",
   "text": "**Screens with text entry:** the primary button sits inline directly under the content, so it stays visible above the keyboard without moving."
  },
  {
   "section": "Design rules 8.10",
   "text": "**Titles:** no full stop at the end of a screen title. Titles wrap balanced (L8)."
  },
  {
   "section": "Design rules L8",
   "text": "L8 — Screen titles wrap balanced — never a single word alone on the last line (D-47)."
  }
 ],
