export function busyBtn(label, cls) {
  return h("button", { type: "button", class: `tm-btn ${cls} tm-btn--busy`, disabled: true, "aria-busy": "true" },
    h("span", { class: "tm-spinner", "aria-hidden": "true" }), label);
}

// Notices: kind error | warning | neutral; role alert for errors, status otherwise.
const NOTICE_ICON = { error: "alert-circle", warning: "alert-triangle", neutral: "info-circle", success: "circle-check" };
export function notice(kind, text, { iconName, role, cls = "" } = {}) {
  return h("div", { class: `tm-notice tm-notice--${kind}${cls ? " " + cls : ""}`, role: role || (kind === "error" ? "alert" : "status") },
    icon(iconName || NOTICE_ICON[kind]), h("span", { text }));
}
export function statusLine(text) {
  return h("div", { class: "tm-status-line", role: "status" }, h("span", { class: "tm-spinner", "aria-hidden": "true" }), text);
}

// The pinned action bar: an optional bar notice (the edge-to-edge band, A-19) above its buttons.
export function actionBar(children, { notice: band = null, cls = "", id } = {}) {
  return h("div", { class: `tm-actionbar${cls ? " " + cls : ""}`, id }, band, ...[].concat(children));
}

// Bottom sheet over the screen (RULES §9.4): scrim, header (title + ✕), body, pinned actions. Returns the overlay element.
// onClose: ✕ and a tap on the scrim. closeDisabled: busy sheets keep ✕ greyed (D-81 F9).
// beforeActions: a result notice that sits between the body and the buttons (callback save failure, K3).
export function sheet({ title, subtitle, body = [], actions = [], onClose, closeDisabled = false, id, label, cls = "", beforeActions = null }) {
  const titleId = `sh-${Math.random().toString(36).slice(2, 7)}`;
  const close = h("button", { type: "button", class: "tm-btn tm-btn--quiet tm-btn--icon tm-sheet__close", "aria-label": MSG("common.close"), disabled: closeDisabled, onclick: () => onClose && onClose() }, icon("x"));
  // D-109 §2: a subtitle sits 8 under the title inside the header (.tm-sheet__heading); the title line stays centred on the ✕.
  const titleEl = h("h2", { class: "tm-sheet__title", id: titleId, text: title });
  const box = h("section", { class: `tm-sheet${cls ? " " + cls : ""}`, role: "dialog", "aria-modal": "true", "aria-labelledby": titleId, tabindex: "-1", id },
    h("header", { class: "tm-sheet__header" },
      subtitle ? h("div", { class: "tm-sheet__heading" }, titleEl, h("p", { class: "tm-sheet__subtitle", text: subtitle })) : titleEl, close),
    // A confirmation sheet whose only words are the subtitle has no body: header → actions (24, the actions' own margin).
    label || [].concat(body).some(Boolean) ? h("div", { class: "tm-sheet__body" }, label ? h("div", { class: "tm-sheet__label", text: label }) : null, ...[].concat(body)) : null,
    beforeActions,
    actions.length ? h("div", { class: "tm-sheet__actions" }, ...actions) : null);
  const overlay = h("div", { class: "tm-overlay app-overlay" }, box);
  overlay.addEventListener("click", (e) => { if (e.target === overlay && !closeDisabled && onClose) onClose(); });
  return overlay;
}
// Reason list (Disable, Unavailable, Skip HA): tapping a row applies it (no extra button).
// The title names the button; the line under it describes it (screen readers read the name, then the description).
let optSeq = 0;
export function option(title, desc, onclick) {
  const id = `opt-${++optSeq}`;
  return h("button", { type: "button", class: "tm-option", onclick, "aria-labelledby": `${id}-t`, "aria-describedby": desc ? `${id}-d` : null },
    h("span", { class: "tm-option__title", id: `${id}-t`, text: title }), desc ? h("span", { class: "tm-option__desc", id: `${id}-d`, text: desc }) : null);
}

export function toast(text, cls = "") { return h("div", { class: `tm-toast${cls ? " " + cls : ""}`, role: "status" }, text); }

// Compact case header (D-49): Back (only where allowed), patient name, Help; age · gender; order line. "Case", never "order",
// for the doctor's unit of work — the customer order ID line stays (CLAUDE.md wording rule).
export function caseHeader(c, { back = true, onBack, onHelp, loading = false } = {}) {
  const row = h("div", { class: "tm-header-task__row" },
    back ? h("button", { type: "button", class: "tm-btn tm-btn--quiet tm-btn--icon", id: "ch-back", "aria-label": MSG("common.back"), onclick: onBack }, icon("arrow-left")) : null,
    loading ? null : h("h1", { class: "tm-header-task__title", id: "ch-name", text: c.patient }),
    h("button", { type: "button", class: "tm-btn tm-btn--quiet tm-btn--icon", id: "ch-help", "aria-label": MSG("common.help"), onclick: onHelp }, icon("help-circle")));
  return h("header", { id: "case-head", class: `tm-header-task--compact${back ? "" : " tm-header-task--no-back"}` }, row,
    loading ? null : h("p", { class: "tm-header-task__meta", id: "ch-meta1", text: MSG("case.patientMeta", { age: c.age, gender: c.gender }) }),
    loading ? null : h("p", { class: "tm-header-task__meta", id: "ch-meta2", text: MSG("case.orderMeta", { id: c.order, total: c.total }) }));
}

// Medicine row (app-logic §8): form icon, name + strength, Qty and status tag; tap → Prescribe. Read-only rows: no arrow.
const FORM_ICON = { tablet: "tablet", capsule: "pill", injection: "vaccine", syrup: "syrup", drops: "eye-drops", cream: "ointment-tube", inhaler: "inhaler" };
const TAG = { prescribed: ["tm-tag--success", "case.statusPrescribed"], pending: ["tm-tag--warning", "case.statusPending"], disabled: ["tm-tag--neutral", "case.statusDisabled"] };
export function medicineRow(m, { readonly = false, onOpen } = {}) {
  const [tagCls, tagKey] = TAG[m.status] || TAG.pending;
  const row = h("div", { class: `tm-row medicine-item${m.status === "disabled" ? " disabled" : ""}${readonly ? " tm-row--readonly" : ""}`,
    role: readonly ? null : "button", tabindex: readonly ? "-1" : "0", "aria-label": MSG("case.editMedicine", { name: m.name }), "data-med-id": String(m.id) },
    h("div", { class: "tm-thumb med-icon" }, icon(FORM_ICON[m.form] || "tablet", "tm-icon--24")),
    h("div", { class: "tm-row__main med-info" },
      h("div", { class: "tm-row__title med-name", text: `${m.name} ${m.strength}` }),
      h("div", { class: "tm-row__line" }, h("span", { class: "tm-row__fact", text: MSG("case.qty", { n: m.qty }) }),
        h("span", { class: `tm-tag tm-tag--md ${tagCls} tm-tag--fixed`, text: MSG(tagKey) }))),
    readonly ? null : icon("chevron-right", "tm-icon--16"));
  if (!readonly && onOpen) {
    row.addEventListener("click", () => onOpen(m.id));
    row.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); onOpen(m.id); } });
  }
  return row;
}

// Focus the sheet when it opens (Round 3 guard 4.7) without scrolling the page behind it.
export function focusSheet(overlay) { const s = overlay && overlay.querySelector(".tm-sheet"); if (s) s.focus({ preventScroll: true }); }

// Keyboard rule (D-81): the focused field scrolls into view above the keyboard with its label and helper, 16 clear of it.
export function revealAboveKeyboard(scroller, field, keyboard) {
  if (!scroller || !field || !keyboard) return;
  const gap = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--tm-space-lg")) || 0;
  const d = field.getBoundingClientRect().bottom + gap - keyboard.getBoundingClientRect().top;
  if (d > 0) scroller.scrollTop += d;
}

// Keyboard rule (D-81) on a phone: the pinned bar hides while the keyboard is open and returns when it closes. The keyboard is
// "open" when a text field has focus and the visual viewport is clearly shorter than the tallest seen (the keyboard took it).
export function watchKeyboard(root, alive) {
  const vv = window.visualViewport; if (!vv) return;
  let tallest = vv.height;
  const check = () => {
    if (!alive()) { vv.removeEventListener("resize", check); return; }
    tallest = Math.max(tallest, vv.height);
    const field = document.activeElement && root.contains(document.activeElement) && /^(TEXTAREA|INPUT)$/.test(document.activeElement.tagName);
    root.classList.toggle("kb-real", !!field && vv.height < tallest * 0.8);
  };
  vv.addEventListener("resize", check); root.addEventListener("focusin", check); root.addEventListener("focusout", () => setTimeout(check, 0));
}
// Home, availability and Profile (plan v3.2 step 2). Markup and classes lifted from ui-screens/home/home-reference.js
// (header, band, panel, wheel picker, action bar footer, add / end sheets, Profile page, Log out sheet); styles in home.css.
// Behaviour: app-logic §3 (pull model, availability window, add / end, Prescriptions today, Profile, Log out) and the Home rows
// of docs/feedback-state-map.md. Every word through MSG(). A state opened directly (?s=home_<state>) shows the picture's
// moment, then behaves live (requests resolve, the clock runs) — except capture, which stays on the picture's moment.
import { MSG } from "../core/msg.js";
import { push, replace, reset as resetNav, back as navBack, depth, setScreenBack, saveCurrent } from "../core/nav.js";
import { store } from "../core/store.js";
import { clock } from "../core/clock.js";
import { h } from "../core/dom.js";
import { value } from "../core/settings.js";
import { storageFor } from "../core/storage.js";
import { promptAnswer, deviceOf } from "../core/unlock.js";
import { fasterState, setEnabled } from "../core/faster-signin.js";
import { work, saveWork, resetWork, availability, setAvailability, addTime, endAvailability, startRequest, clearRequest, openCase } from "../core/session.js";
import { SAMPLE_DOCTOR } from "../data/doctor.js";
import { PICTURE_NUMBER } from "../data/test-numbers.js";
import { icon, paint as paintIcons, btn, busyBtn, notice, statusLine, actionBar, sheet, toast, focusSheet } from "./parts.js";
import { newLife } from "./entry-ctx.js";
import { wheelColumn, syncWheels, commitWheels } from "./wheel.js";
import { band } from "./band.js";
import { parts } from "../core/dom.js";

const MIN = 60 * 1000;
// Picture moments (home-reference.js STATES). left: minutes remaining; rx: Prescriptions today; bar: the bar result notice.
const FIXTURES = {
  "setup-wheel": { setup: true, rx: 0 },
  setting: { setup: true, rx: 0, busy: "setting" },
  "setup-failed": { setup: true, rx: 0, bar: "setup-failed" },
  active: { left: 30 },
  requesting: { left: 30, request: true, busy: "requesting" },
  "no-cases": { left: 30, bar: "no-cases" },
  "request-failed": { left: 30, bar: "request-failed" },
  offline: { left: 30, offline: true },
  "near-expiry": { left: 5 },
  "add-wheel": { left: 5, sheet: "add" },
  adding: { left: 5, sheet: "add", busy: "adding" },
  "add-failed": { left: 5, sheet: "add", addFailed: true },
  added: { left: 35, toast: true },
  "end-confirmation": { left: 30, sheet: "end" },
  "stop-pending": { left: 30, request: true, stopping: true },
  "expired-pending": { left: 0, request: true },
  "idle-expired": { setup: true, ended: "idle" },
  "manually-ended": { setup: true, ended: "manual" },
  "unknown-result": { left: 30, request: true, unknown: true },
  profile: { left: 30, page: "profile" },
  "profile-case-open": { left: 30, page: "profile", caseOpen: true },
  "logout-confirm": { left: 30, page: "profile", sheet: "logout" },
};
export const STATES = Object.keys(FIXTURES).map((k) => `home_${k}`);
const PRESETS = [15, 30, 45, 60, 120, 180];
const presetLabel = (n) => n < 60 ? MSG("home.presetMinutes", { n }) : n === 60 ? MSG("home.presetHour") : MSG("home.presetHours", { n: n / 60 });
// "Add 9 h 45 min": minutes under an hour, hours and minutes from 60 min up (D-106).
export const durationLabel = (n) => n < 60 ? MSG("home.durMinutes", { m: n }) : n % 60 ? MSG("home.durHoursMinutes", { h: Math.floor(n / 60), m: n % 60 }) : MSG("home.durHours", { h: n / 60 });
// "7:45 PM": the end of the window on the setup caption ("Available until {time}").
const clockTime = (t) => new Date(t).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
// The 10-hour cap (D-106) and the 15-minute minimum and step, in minutes. The wheel is in real minutes in every mode.
const CAP = value("availabilityMaximum", "review") / MIN, MIN_LEN = value("availabilityMinimum", "review") / MIN, STEP = value("availabilityStep", "review") / MIN;
// Wheel values for a top limit in minutes: hours 0 … top; at 0 h the minutes start at 15; at the top hour they stop at the limit.
const hoursFor = (max) => Array.from({ length: Math.floor(max / 60) + 1 }, (_, n) => n);
const minutesFor = (hh, max) => [0, 15, 30, 45].filter((m) => (hh > 0 || m >= MIN_LEN) && hh * 60 + m <= max);
// Snaps a wanted length onto the wheel: at least 15 min, at most the limit, on the 15-minute step.
const clampLen = (n, max) => Math.max(MIN_LEN, Math.min(Math.floor(max / STEP) * STEP, n));
// Timer: m:ss below an hour, h:mm:ss from one hour up (D-53).
export function formatLeft(ms) {
  const s = Math.max(0, Math.ceil(ms / 1000)), hh = Math.floor(s / 3600), mm = Math.floor((s % 3600) / 60), ss = s % 60;
  const p = (n) => String(n).padStart(2, "0");
  return hh ? `${hh}:${p(mm)}:${p(ss)}` : `${mm}:${p(ss)}`;
}

// Applies a picture moment to the session (fixtures are where a jump or ?s= starts; the session then plays on from there).
function applyFixture(fx, mode) {
  const now = clock.now();
  const rx = fx.rx ?? 3;
  const patch = { rxToday: rx, ended: fx.ended || null, stopping: !!fx.stopping, request: fx.request ? { at: now } : null, openCase: null };
  patch.avail = fx.setup ? null : { endsAt: now + fx.left * MIN };
  resetWork(patch);
  if (fx.caseOpen) openCase(store.get().scenario || "cat4", "normal");
}

export function render(host, id, { mode, params = {} }) {
  const key = id.replace(/^home_/, "");
  const fx = FIXTURES[key];
  if (!fx) return null;
  const life = newLife(host, mode);
  const live = !!params.live;
  const capture = mode === "capture";
  if (!live && !params.saved) applyFixture(fx, mode);
  // An open case comes first: Home (opened live) goes straight back into it (D-48, app-logic §4 "reopening goes back into the case").
  if (live && work().openCase && !fx.page) { queueMicrotask(() => replace(null, { s: "t01-ready", live: true })); return { journey: "caseView" }; }

  const story = () => store.get().story || {};
  const v = (k) => value(k, mode);
  const ui = {
    page: fx.page || "home",
    sheet: live ? null : fx.sheet || null,
    busy: live ? (work().request ? "requesting" : null) : fx.busy || null,
    bar: live ? null : fx.bar || null,
    unknown: !live && !!fx.unknown,
    offlineFx: !live && !!fx.offline,
    addFailed: !live && !!fx.addFailed,
    duration: 30, addDuration: 30,
    toastUntil: !live && fx.toast ? (capture ? Number.MAX_SAFE_INTEGER : Date.now() + v("toastDuration")) : 0,
    profileError: null, fasterBusy: false,
    ...(params.saved || {}),
  };
  const offline = () => ui.offlineFx || store.get().offline === "yes";

  const root = h("div", { class: "home-screen tm" });
  host.replaceChildren(root);

  // ---------- pieces ----------
  // A real swipe wheel per column (F-04, D-40): wheel.js. Busy (Setting… / Adding…) blocks it.
  function wheel(name, values, current, col) {
    const busy = ui.busy === "setting" || ui.busy === "adding";
    return wheelColumn({ name, col, values, current, disabled: busy, onPick: (val, o) => pickWheel(col, val, o && o.focus) });
  }
  // The top of the wheel (D-106): setup 10 h; Add time what is left of the 10 hours in total, on the 15-minute step.
  function maxFor(target) {
    if (target === "duration") return CAP;
    return Math.max(0, Math.floor((CAP * MIN - availability().left) / (STEP * MIN)) * STEP);
  }
  // One duration picker (D-106, RULES "Entry and home screens"): "Quick picks" (6 chips) → 32 → "Custom" → column heads 4 → wheel.
  // No range text; the add-time sheet has the hint "Up to 10 hours in total" on the Custom line.
  function picker(target) {
    const max = maxFor(target);
    ui[target] = clampLen(ui[target], max);
    const d = ui[target], hours = Math.floor(d / 60), minutes = d % 60;
    const busy = ui.busy === "setting" || ui.busy === "adding";
    pickTarget = target;
    const qp = `qp-${target}`;
    return h("div", { class: "picker" },
      h("div", { class: "group" }, h("p", { class: "lbl", id: qp, text: MSG("home.quickPicks") }),
        h("div", { class: "presets", role: "group", "aria-labelledby": qp }, PRESETS.map((n) => h("button", { type: "button", class: "tm-chip tm-chip--lg", "aria-pressed": String(d === n), disabled: busy || n > max,
          onclick: () => { ui[target] = n; draw(); } }, presetLabel(n))))),
      h("div", { class: "group" },
        h("div", { class: "lbl-row" }, h("p", { class: "lbl", text: MSG("home.custom") }),
          target === "addDuration" ? h("p", { class: "hint", id: "add-hint", text: MSG("home.addHint") }) : null),
        h("div", { class: "col-heads", "aria-hidden": "true" }, h("span", { text: MSG("home.hours") }), h("span", { text: MSG("home.minutes") })),
        h("div", { class: "columns" }, h("div", { class: "wheel-band", "aria-hidden": "true" }),
          wheel(MSG("home.hours"), hoursFor(max), hours, "h"), wheel(MSG("home.minutes"), minutesFor(hours, max), minutes, "m"))));
  }
  let pickTarget = "duration";
  function pickWheel(col, val, focus) {
    if (ui.busy === "setting" || ui.busy === "adding") return;
    const max = maxFor(pickTarget);
    const d = ui[pickTarget];
    let hh = Math.floor(d / 60), mm = d % 60;
    if (col === "h") hh = val; else mm = val;
    // Moving the hours keeps the minutes where the new hour allows them (0 h: from 15; the top hour: up to the limit).
    const mins = minutesFor(hh, max);
    if (!mins.includes(mm)) mm = mm > mins[mins.length - 1] ? mins[mins.length - 1] : mins[0];
    ui[pickTarget] = clampLen(hh * 60 + mm, max);
    draw(focus ? col : null);
  }
  const NOTE = {
    "setup-failed": () => notice("error", MSG("home.setupFailed"), { cls: "status" }),
    "request-failed": () => notice("error", MSG("home.requestFailed"), { cls: "status" }),
    "no-cases": () => notice("neutral", MSG("home.noCases"), { cls: "status" }),
  };
  // Bar notice (A-19, lane-request 7): offline and the result of the bar's own action sit in the bar; near expiry too.
  function barNotice(a) {
    if (offline() && a.state !== "none") return notice("warning", MSG("home.offline"), { cls: "status" });
    if (ui.bar && NOTE[ui.bar]) return NOTE[ui.bar]();
    if (a.state === "near" && !ui.sheet) return notice("warning", MSG("home.endingSoon"), { iconName: "clock", cls: "status" });
    return null;
  }
  // Standing notice at the top of the panel: ended (idle / by the doctor), ending after the open request, expired with it.
  function topNotice(a) {
    const w = work();
    if (a.state === "stopping") return notice("neutral", MSG("home.stopPending"), { cls: "status" });
    if (a.state === "expired-pending") return notice("neutral", MSG("home.expiredPending"), { cls: "status" });
    if (a.state === "none" && w.ended === "idle") return notice("neutral", MSG("home.idleExpired"), { cls: "status" });
    if (a.state === "none" && w.ended === "manual") return notice("neutral", MSG("home.manuallyEnded"), { cls: "status" });
    return null;
  }
  function footer(a) {
    const lg = "tm-btn--lg tm-btn--block";
    const t = Date.now() < ui.toastUntil ? toast(MSG("home.added"), "home-toast") : null;
    if (ui.unknown) return actionBar([statusLine(MSG("home.unknownResult")), t], { cls: "footer" });
    const setup = a.state === "none";
    const busyLabel = { setting: "home.setting", requesting: "home.requesting", adding: "home.adding" }[ui.busy];
    let primary;
    const waiting = a.state === "stopping" || a.state === "expired-pending";   // the open request is honoured; no new one (stop-pending picture: disabled)
    if (busyLabel && ui.busy !== "adding" && !waiting) primary = busyBtn(MSG(busyLabel), `tm-btn--primary ${lg}`);
    else if (setup) primary = btn(MSG("home.setAvailability"), `tm-btn--primary ${lg}`, onSet, { "data-confirm": "" });
    else primary = btn(MSG("home.requestCase"), `tm-btn--primary ${lg}`, onRequest, { "data-confirm": "", disabled: offline() || a.state === "stopping" || a.state === "expired-pending" || !!ui.busy });
    // Setup: "Available until {time}", 8 above Set availability (D-106; bar caption, RULES "Entry and home screens").
    const until = setup ? h("p", { class: "until", id: "home-until" }, parts("home.availableUntil", { time: h("b", { text: clockTime(clock.now() + ui.duration * MIN) }) }, MSG)) : null;
    let secondary = null;
    if (!setup && !ui.sheet && a.state !== "expired-pending") {
      secondary = a.state === "stopping" ? btn(MSG("home.ending"), `tm-btn--quiet ${lg}`, null, { "data-secondary": "" })
        : btn(MSG("home.endAvailability"), `tm-btn--quiet ${lg}`, () => openSheet("end"), { "data-secondary": "", disabled: offline() });   // D-81 F13
    }
    return actionBar([until, primary, secondary, t], { notice: barNotice(a), cls: "footer" });
  }
  // Prescriptions written today: one card row that opens Profile (D-106). On ended Home it shows above the picker when above 0.
  function rxRow() {
    return h("button", { class: "srow srow--link", id: "home-rx", type: "button", onclick: toProfile },
      icon("prescription", "srow__icon"),
      h("span", { class: "srow__txt" }, h("span", { class: "srow__label", text: MSG("home.rxToday") }),
        h("span", { class: "srow__line" }, h("span", { class: "tm-value-display srow__value", text: String(work().rxToday) }))),
      icon("chevron-right", "srow__chev"));
  }
  // Available: one tm-card, two rows of one anatomy (grey icon · 16/24 label · L9 value) — Time remaining with + Add time on the
  // value line, always shown (greyed offline; also greyed when less than 15 minutes fit under the cap), and Prescriptions written
  // today → Profile. Ending (stop-pending) shows no time row (D-47); ran out with a request open shows 0:00 (D-53) and no Add time
  // (the window has ended; Request a case is off).
  function statusCard(a) {
    const timed = a.state === "active" || a.state === "near" || a.state === "expired-pending";
    const canAdd = maxFor("addDuration") >= MIN_LEN;
    const addBtn = a.state === "expired-pending" ? null : h("button", { id: "add", class: "tm-btn tm-btn--secondary add-time", type: "button", disabled: offline() || !canAdd, onclick: () => openSheet("add") },
      icon("plus", "tm-icon--16"), MSG("home.addTime"));
    return h("div", { class: "tm-card home-card" },
      timed ? h("div", { class: "srow" }, icon("clock", "srow__icon"),
        h("div", { class: "srow__txt" }, h("p", { class: "srow__label", text: MSG("home.timeRemaining") }),
          h("div", { class: "srow__line" },
            h("p", { class: "tm-value-display srow__value time", id: "home-time", "aria-live": "off", text: formatLeft(a.left) }), addBtn))) : null,
      rxRow());
  }
  function addSheet() {
    const busy = ui.busy === "adding";
    return sheet({
      title: MSG("home.addTitle"), subtitle: MSG("home.addSub"), closeDisabled: busy, onClose: closeSheet,
      body: [picker("addDuration")],
      // D-106: the error sits in the pinned actions, 16 above Add (visible on arrival at 360 × 640).
      actions: [ui.addFailed ? notice("error", MSG("home.addFailed"), { cls: "sheet-feedback" }) : null,
        busy ? busyBtn(MSG("home.adding"), "tm-btn--primary tm-btn--lg tm-btn--block")
        : btn(MSG("home.addConfirm", { duration: durationLabel(ui.addDuration) }), "tm-btn--primary tm-btn--lg tm-btn--block", onAdd, { "data-confirm": "" }),
        btn(MSG("home.cancel"), "tm-btn--quiet tm-btn--lg tm-btn--block", closeSheet, { "data-secondary": "", disabled: busy })],
    });
  }
  function endSheet() {
    return sheet({ title: MSG("home.endTitle"), subtitle: MSG("home.endSub"), onClose: closeSheet,
      actions: [btn(MSG("home.endAvailability"), "tm-btn--destructive tm-btn--lg tm-btn--block", onEnd, { "data-confirm": "" }),
        btn(MSG("home.keepAvailable"), "tm-btn--quiet tm-btn--lg tm-btn--block", closeSheet, { "data-secondary": "" })] });
  }
  function logoutSheet() {
    return sheet({ title: MSG("profile.logoutTitle"), subtitle: MSG("profile.logoutConfirm"), onClose: closeSheet,
      actions: [btn(MSG("profile.logout"), "tm-btn--destructive tm-btn--lg tm-btn--block", onLogout, { "data-confirm": "" }),
        btn(MSG("profile.staySignedIn"), "tm-btn--quiet tm-btn--lg tm-btn--block", closeSheet, { "data-secondary": "" })] });
  }

  function homePage(a) {
    const setup = a.state === "none";
    const title = setup ? "home.titleSetup" : a.state === "expired-pending" ? "home.titleEnded" : a.state === "stopping" ? "home.titleStopping" : "home.titleActive";
    const sub = setup ? "home.subSetup" : a.state === "expired-pending" || a.state === "stopping" ? "home.subNoNewCases" : "home.subActive";
    const rx = work().rxToday;
    const actions = [["bell", "home.notifications", toPlaceholder], ["help-circle", "common.help", toPlaceholder], ["user-circle", "home.profile", toProfile]]
      .map(([ic, label, fn]) => h("button", { class: "tm-btn tm-btn--quiet tm-btn--icon", type: "button", "aria-label": MSG(label), onclick: fn }, icon(ic)));
    // The one band (D-107; Home header actions = variant 1) · panel: standing notice → 32 → content (D-108) · the pinned bar.
    return h("div", { class: "home-bg", inert: ui.sheet ? "" : null },
      band({ title: MSG(title), subtitle: MSG(sub), actions, tag: "div" }),
      h("div", { class: "entry-panel panel" }, topNotice(a),
        h("div", { class: "scroll" },
          setup ? [work().ended && rx > 0 ? h("div", { class: "tm-card home-card" }, rxRow()) : null, picker("duration")] : statusCard(a)),
        footer(a)));
  }
  function profilePage() {
    const caseOpen = !!work().openCase;
    const auth = storageFor(mode).get("auth");
    const number = (auth && auth.number) || PICTURE_NUMBER;
    const enabled = live ? fasterState(number, { db: storageFor(mode) }).enabled : true;
    if (ui.fasterOn === undefined) ui.fasterOn = enabled;
    const earned = (work().rxToday * v("earningsPerConfirmedRx")).toFixed(2);   // D-81 F10: ₹20 per confirmed prescription
    const toggle = h("input", { class: "tm-toggle", type: "checkbox", role: "switch", "aria-checked": String(!!ui.fasterOn), "aria-label": MSG("profile.fasterSignIn"), disabled: ui.fasterBusy });
    toggle.checked = !!ui.fasterOn;
    toggle.addEventListener("change", () => onFaster(toggle.checked, number));
    const noLock = deviceOf(story(), mode) === "none";   // hidden if the phone has no screen lock at all (D-64)
    return h("div", { class: "profile-page", inert: ui.sheet ? "" : null },
      h("header", { class: "tm-header-task profile-header" }, h("div", { class: "tm-header-task__row" },
        h("button", { class: "tm-btn tm-btn--quiet tm-btn--icon", id: "profile-back", type: "button", "aria-label": MSG("common.back"), onclick: profileBack }, icon("arrow-left")),
        h("h1", { class: "tm-header-task__title", text: MSG("profile.title") }))),
      h("div", { class: "profile-body" },
        h("div", { class: "tm-card profile-identity" }, h("div", { class: "profile-avatar", "aria-hidden": "true", text: SAMPLE_DOCTOR.initials }),
          h("div", {}, h("p", { class: "pt-t", text: MSG("profile.doctorName", { name: SAMPLE_DOCTOR.fullName }) }), h("p", { class: "pt-d", text: SAMPLE_DOCTOR.role }))),
        h("div", { class: "tm-card profile-earnings" }, h("p", { class: "profile-label", text: MSG("profile.earnings") }),
          h("div", { class: "profile-earnings-row" },
            h("div", {}, h("p", { class: "pt-d", text: MSG("profile.earned") }), h("p", { class: "pt-t", text: MSG("profile.amount", { amount: earned }) })),
            h("div", {}, h("p", { class: "pt-d", text: MSG("profile.incentive") }), h("p", { class: "pt-t", text: MSG("profile.amount", { amount: (0).toFixed(2) }) })))),
        h("div", { class: "tm-card profile-rows" },
          h("button", { class: "profile-row", type: "button", onclick: toPlaceholder }, h("span", { class: "profile-row-label" }, icon("book"), MSG("profile.userManual")), icon("chevron-right")),
          noLock ? null : h("label", { class: "profile-row" }, h("span", { class: "profile-row-label" }, icon("fingerprint"), MSG("profile.fasterSignIn")), toggle)),
        ui.profileError ? notice(ui.profileError === "unavailable" ? "warning" : "error", MSG(ui.profileError === "unavailable" ? "unlock.unavailable" : "offer.enableFailed")) : null,
        h("div", { class: "profile-logout" }, caseOpen ? notice("neutral", MSG("profile.logoutBlocked"))
          : btn(MSG("profile.logout"), "tm-btn--destructive tm-btn--lg tm-btn--block", () => openSheet("logout"), { "data-logout": "" }))));
  }

  // ---------- draw ----------
  let lastKey = "";
  function draw(wheelFocus) {
    const a = availability();
    lastKey = drawKey(a);
    const page = ui.page === "profile" ? profilePage() : homePage(a);
    const overlay = ui.sheet === "add" ? addSheet() : ui.sheet === "end" ? endSheet() : ui.sheet === "logout" ? logoutSheet() : null;
    root.replaceChildren(page, overlay || "");
    root.classList.toggle("is-profile", ui.page === "profile");
    paintIcons(root);
    syncWheels(root, wheelFocus);   // each wheel shows its value in the band
    if (overlay && !capture && !wheelFocus) focusSheet(overlay);
  }
  const drawKey = (a) => [a.state, ui.busy, ui.sheet, ui.bar, offline(), work().rxToday, Date.now() < ui.toastUntil].join("|");

  // ---------- behaviour ----------
  function openSheet(which) {
    if (which === "add") { ui.addDuration = 30; ui.addFailed = false; }
    ui.sheet = which; saveCurrent({ saved: snapshot() }); draw();
  }
  function closeSheet() { if (ui.busy === "adding") return; ui.sheet = null; ui.addFailed = false; draw(); }
  const snapshot = () => ({ duration: ui.duration, addDuration: ui.addDuration, page: ui.page });
  function onSet() {
    if (ui.busy) return;
    commitWheels(root);   // tapped before the wheel came to rest: the value in the band is the one set
    ui.busy = "setting"; ui.bar = null; draw();
    life.later(() => {
      ui.busy = null;
      if (offline()) { ui.bar = "setup-failed"; draw(); return; }   // known failure: the selection is kept (feedback-state-map home.setup-failed)
      setAvailability(ui.duration * MIN); draw();
    });
  }
  function onRequest() {
    if (ui.busy || offline()) return;
    ui.bar = null; ui.busy = "requesting"; startRequest(); draw();
    resolveRequest();
  }
  // The server's answer to the open request. Review / play: the story's "request" answer; demo: a case.
  function resolveRequest() {
    if (capture) return;
    life.later(() => {
      if (!work().request) return;
      const r = mode === "demo" ? "accepted" : story().request || "accepted";
      ui.busy = null; ui.unknown = false;
      if (r === "accepted") {
        const s = store.get();
        openCase(mode === "demo" ? "cat4" : s.scenario || "cat4", mode === "demo" ? "normal" : story().caseKind || "normal");
        availability();   // a stop / expiry waiting on this request ends now (app-logic §3: honoured, then ends)
        resetNav(); push(null, { s: "t01-ready", live: true });
        return;
      }
      clearRequest();
      ui.bar = r === "failed" ? "request-failed" : "no-cases";   // no cases: no auto re-check (OQ-019)
      draw();
    });
  }
  function onAdd() {
    if (ui.busy) return;
    commitWheels(root);   // as onSet: the value in the band is the one added
    ui.busy = "adding"; ui.addFailed = false; draw();
    life.later(() => {
      ui.busy = null;
      if (offline()) { ui.addFailed = true; draw(); return; }   // home.add-failed: sheet and selection kept, deadline unchanged
      addTime(ui.addDuration * MIN); ui.sheet = null;
      ui.toastUntil = Date.now() + v("toastDuration");   // about 4 s (RULES §9.5 toast)
      draw();
    });
  }
  function onEnd() { ui.sheet = null; endAvailability(); draw(); }
  function onLogout() {
    ui.sheet = null;
    const db = storageFor(mode);
    db.set("auth", null); resetWork();   // B12: Log out clears what the phone remembers about the session
    resetNav(); push(null, { s: "sign-in_default", live: true, number: "" });
  }
  function onFaster(on, number) {
    ui.profileError = null;
    if (!on) { ui.fasterOn = false; if (live) setEnabled(number, { db: storageFor(mode), story: story(), mode }, false); draw(); return; }   // off: no prompt (D-70)
    ui.fasterBusy = true; ui.fasterOn = false; draw();
    life.later(() => {
      ui.fasterBusy = false;
      const r = promptAnswer("enable", story(), mode);
      if (r === "enabled") { ui.fasterOn = true; setEnabled(number, { db: storageFor(mode), story: story(), mode }, true); }
      else if (r === "enable-failed" || r === "unavailable") ui.profileError = r;   // cancelled: stays off, no message
      draw();
    }, "phonePromptDelay");
  }
  function toProfile() { saveCurrent({ saved: snapshot() }); push(null, { s: work().openCase ? "home_profile-case-open" : "home_profile", live: true }); }
  function toPlaceholder() { saveCurrent({ saved: snapshot() }); push(null, { s: "placeholder", text: "placeholder.linkPending" }); }   // Help / bell / User manual: blank page [OPEN DECISION] (D-88)
  function profileBack() { if (depth() > 1) { setScreenBack(null); navBack(); } else { resetNav(); push(null, { s: "home_active", live: true }); } }

  // A request in flight (opened on Requesting…, Ending…, expired-pending, Checking…) gets its answer.
  if (work().request && !ui.busy && !fx.page && !ui.unknown && ["active", "near"].includes(availability().state)) ui.busy = "requesting";
  if (work().request && !fx.page) resolveRequest();
  // The clock: the timer reads it; when the window ends the screen changes (idle-expired, expired-pending, stop-pending → ended).
  if (!capture) life.every(() => {
    const a = availability();
    const t = root.querySelector("#home-time");
    if (drawKey(a) !== lastKey) draw(); else if (t) t.textContent = formatLeft(a.left);
    const until = root.querySelector("#home-until b");   // the setup caption follows the clock without redrawing the wheel
    if (until) until.textContent = clockTime(clock.now() + ui.duration * MIN);
  }, 250);
  let lastOffline = store.get().offline;
  const unsub = store.subscribe((st) => {
    if (!life.alive()) { unsub(); return; }
    if (st.offline !== lastOffline) { lastOffline = st.offline; ui.offlineFx = false; }   // the reviewer's switch replaces the picture moment
    if (drawKey(availability()) !== lastKey) draw();
  });

  // Phone back (B13): an open sheet closes first; then Profile goes back; Home is a root (phone back stays in the app).
  setScreenBack(() => { if (ui.sheet) { closeSheet(); return; } if (ui.page === "profile") profileBack(); });
  draw();
  // "Request next case" on a closed case: Home asks for the next case straight away (app-logic §4 closed stage).
  if (live && params.request && !capture && ["active", "near"].includes(availability().state)) onRequest();
  return { journey: "home" };
}
// Case page (plan v3.2 step 3) and the host of Prescribe (step 4), the Rx viewer and calling (step 5). Markup and classes lifted
// from ui-screens/case/case.html as the approved pictures render it (compact header D-49, case tools card with Order details and
// View Rx, outcome card, end-of-call script, medicines card, notes card, pinned action bar with its notice band, leave / callback /
// unavailable sheets, Rx viewer); styles in case.css. Every word through MSG().
// Behaviour: app-logic §4 (stages, Back, leave / release, empty case), §5 (calls, the gate, the state table), §6 (final buttons),
// §7 (callback, patient unavailable), §8 (medicine rows), §9 (order details, View Rx, notes), §10 (loading, failures, offline).
// Calling stages come from the calling engine (core/call-engine.js), polled on the app clock; this file only draws them.
import { MSG } from "../core/msg.js";
import { push, reset as resetNav, setScreenBack, saveCurrent } from "../core/nav.js";
import { store } from "../core/store.js";
import { h } from "../core/dom.js";
import { clock } from "../core/clock.js";
import { value } from "../core/settings.js";
import { event } from "../core/events.js";
import { EV } from "../core/call-events.js";
import { work, saveWork, currentCase, openCase, updateMedicine, releaseCase, countConfirmed, availability, keepRecord, addHold } from "../core/session.js";
import { route, scriptKey, startAttempt, stillTalking, callEnded, submitConfirm, submitForward, confirmLive, skipHa, closeUnavailable, stepCall } from "../core/call-engine.js";
import { defaultAttempt } from "../data/story-schema.js";
import { icon, paint, btn, busyBtn, notice, statusLine, actionBar, sheet, toast, caseHeader, medicineRow, focusSheet, revealAboveKeyboard, watchKeyboard } from "./parts.js";
import { newLife } from "./entry-ctx.js";
import { prescribeScreen } from "./prescribe.js";
import { rxViewer } from "./rx-viewer.js";
import { callbackSheet } from "./callback-sheet.js";
import { unavailableSheet } from "./unavailable-sheet.js";
import { skipHaSheet } from "./skip-ha-sheet.js";
import { slotLabel } from "../data/callback-slots.js";
import { mockTextKeyboard } from "../shell/mock-keyboard.js";
import { TYPED } from "../data/cases.js";

const MIN = 60 * 1000;
const CB15 = { day: "today", time: "15:00" };   // the pictures' callback choice (Today, 3:00 PM)
// Picture moments (case.html fixtures). kind: the case variation; overlay: leave | rx | callback | unavailable; bar: the bar's
// result notice; stage / outcome: the calling stage (call-engine.js); fxCall: the simulator answer the picture implies, kept until
// the reviewer changes the Call simulator; scenario: the picture's case (capture only — review keeps the story's case).
const CASE_FX = {
  "t01-ready": {}, "a-top": {}, "a-scrolled": { scroll: true }, "a-order-details": { expanded: true },
  "a-rx-viewer": { overlay: "rx" }, "d-rx-failed": { overlay: "rx", rxFailed: true },
  "a-notes-typing": { typing: "symptoms", symptoms: TYPED.symptoms },
  "a-leave-sheet": { overlay: "leave" }, "s7e-leave-sheet": { overlay: "leave" }, "a-releasing": { overlay: "leave", releasing: true },
  "a-release-failed": { bar: "release-failed" }, "a-loading": { loading: true }, "a-load-failed": { loadFailed: true },
  "a-offline": { offline: true }, "a-offline-action": { bar: "offline-action" },
  "a-no-medicines": { kind: "empty" }, "a-long-content": { kind: "long-names" }, "s-10-medicines": { kind: "ten-medicines" },
  "s-medicine-disabled": { disable: 2 }, "s-optional-empty": { noDetails: true },
  "a-back-blocked": { stage: "calling", toast: true },
  "a-confirm-busy": { stage: "valid", allRx: true, confirming: true }, "a-confirm-failed": { stage: "valid", allRx: true, bar: "confirm-failed" },
  "t10a-confirmed": { stage: "closed", allRx: true }, "e-availability-ended": { stage: "closed", allRx: true, availEnded: true },
  // step 5 (calling, Cat4 and Pilot HA skipped)
  "t02-calling": { stage: "calling" }, "s7a-calling": { stage: "calling" },
  "t03-not-through": { stage: "not-through" }, "t04-doctor-missed": { stage: "doctor-missed" },
  "t05-result-wait": { stage: "result-wait", fxCall: { record: "never" }, scenario: "pilot_ha_free" },
  "t06-ended-early": { stage: "ended-early" },
  "s7b-still-on-call": { stage: "still-on-call", fxCall: { record: "never" } },
  "s7d-result-missing": { stage: "result-missing", allRx: true, fxCall: { record: "never" } },
  "s7d-unavailable-sheet": { stage: "result-missing", allRx: true, fxCall: { record: "never" }, overlay: "unavailable" },
  "s7f-submitted": { stage: "closed", outcome: "submitted", allRx: true, fxCall: { record: "never" } },
  "t08a-valid-cat4": { stage: "valid", allRx: true }, "t08c-confirm-blocked": { stage: "valid", bar: "confirm-blocked" },
  "t09-patient-unavailable": { stage: "closed", outcome: "unavailable" },
  "e-callback-scheduled": { stage: "closed", outcome: "callback" },
  "c-callback": { stage: "ended-early", overlay: "callback" },
  "c-callback-error": { stage: "ended-early", overlay: "callback", cb: { error: "case.callbackPickBoth" } },
  "c-callback-failed": { stage: "ended-early", overlay: "callback", cb: { ...CB15, notice: "case.callbackFailed" } },
  "c-callback-refused": { stage: "ended-early", overlay: "callback", cb: { ...CB15, notice: "callback.notReached" } },
  // step 6 (Pilot Fallback B). pilot: the picture's Pilot scenario, used when the story's case has no HA call (and in capture).
  // A live-call picture's call is past the gate and still live; it ends at the next poll once the reviewer reports a hang-up
  // or a result (no result until then: fxCall).
  "g0-calling-pilot": { stage: "calling", pilot: "pilot_ha_free" },
  "g1-generic-confirm": { stage: "live", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "c-skip-ha": { stage: "live", allRx: true, fxCall: { record: "never" }, overlay: "skip", pilot: "pilot_ha_free" },   // the sheet over B1 (launch); the picture shows it over 12 (version A)
  "g2-checking-ha": { stage: "checking-ha", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "t13-connecting-ha": { stage: "transferring", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "g3b-forwarded": { stage: "forwarded-live", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "t15-ha-no-join": { stage: "forwarded-live", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "g3b-after-hangup": { stage: "closed", outcome: "forwarded-ended", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "t15-after-hangup": { stage: "closed", outcome: "forwarded-ended", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
  "t14-transferred": { stage: "closed", outcome: "transferred", allRx: true, pilot: "pilot_ha_free" },
  "t10b-forwarded": { stage: "closed", outcome: "forwarded", allRx: true, pilot: "pilot_no_ha_free" },
  "t16-transfer-missed": { stage: "transfer-missed", allRx: true, endedBy: "doctor", pilot: "pilot_ha_free" },
  "t16b-transfer-missed-patient": { stage: "transfer-missed", allRx: true, endedBy: "patient", pilot: "pilot_ha_free" },
  "t16c-transfer-missed-unknown": { stage: "transfer-missed", allRx: true, endedBy: "unknown", pilot: "pilot_ha_free" },
  "t17-skip-ha-wait": { stage: "skip-ha-wait", allRx: true, fxCall: { record: "never" }, skipped: true, pilot: "pilot_ha_free" },
  "s7d-result-missing-pilot": { stage: "result-missing", allRx: true, fxCall: { record: "never" }, pilot: "pilot_ha_free" },
};
// Pilot stages where the call is still live past the gate (Fallback B).
const LIVE_PAST_GATE = ["live", "checking-ha", "transferring", "forwarded-live", "skip-ha-wait"];
const WHO_ENDED = { doctor: "call.transferMissedDoctor", patient: "call.transferMissedPatient", unknown: "call.transferMissed" };   // 16 / 16b / 16c
// Prescribe moments (prescribe/d-*): which medicine, the backend's schedule for it, what the doctor has done on the screen.
const D_FX = {
  "d-default": { med: 1 }, "d-header-white": { med: 1 }, "d-scrolled": { med: 1, scroll: true },
  "d-error-dose": { med: 1, edit: { interval: "daily", m: 0, a: 0, n: 0 }, validate: true },
  "d-error-other": { med: 4, edit: { doseOther: true, doseOtherVal: "7..5" }, validate: true, kb: "decimal" },
  "d-sos-on": { med: 1, edit: { sos: true } }, "d-notes-keyboard": { med: 1, kb: "text" },
  "d-discard-sheet": { med: 1, edit: { note: TYPED.note }, sheet: "discard" }, "d-disable-sheet": { med: 1, sheet: "disable" },
  "d-injection-default": { med: 4 }, "d-syrup": { med: 5 },
  "d-drops": { scenario: "pilot_ha_free", med: 3 }, "d-cream": { scenario: "pilot_no_ha_free", med: 4 }, "d-inhaler": { scenario: "pilot_ha_skipped_customer", med: 3 },
  "d-every-x-hours": { med: 1, medPatch: { interval: "every_x_hours", hours: 6 } }, "d-sos-only": { med: 2, medPatch: { interval: "sos" } },
  "d-weekly": { med: 3, medPatch: { interval: "weekly" } }, "d-alt-days": { med: 1, medPatch: { interval: "alt_days" } }, "d-monthly": { med: 1, medPatch: { interval: "monthly" } },
  "d-duration-picker": { med: 1, edit: { durOpen: true }, scroll: "duration" }, "d-food-selected": { med: 1, edit: { food: "before_food" }, scroll: "food" },
  "d-disabled": { med: 1, medPatch: { status: "disabled", disableReason: "prescribe.reasonDeclined" } },
};
export const STATES = [...Object.keys(CASE_FX), ...Object.keys(D_FX)];

// The call history a calling picture implies (B8: time stamps, never counters). Earlier calls sit 10 min back, inside the
// talk-time window; a 7b picture is one no-result timeout after the tap.
function fixtureCall(c, fx, now, v) {
  const st = fx.stage;
  if (!st || st === "ready") return;
  const gate = v("gate");
  const past = now - 10 * MIN;
  const pilot = route(c) === "pilot" || !!fx.skipped;   // the call was placed on the Pilot route (17: before the Skip HA)
  const done = (talk) => ({ at: past, polled: true, done: true, counted: talk >= v("minCountedCall"), reported: talk, endsAt: past + talk });
  // A Pilot call live past the gate: its default "over the gate" length ends one poll from now (B1, B2, 13, B3 / 15, 17).
  const liveLength = gate + v("pilotTalkAfterGate");
  let a;
  if (st === "calling") a = { at: now, done: false };
  else if (st === "still-on-call") a = { at: now - v("noResultTimeout"), polled: true, done: false };
  else if (LIVE_PAST_GATE.includes(st)) a = { at: now + v("pollingInterval") - liveLength, polled: true, done: false };
  else if (st === "closed" && fx.outcome === "forwarded-ended") a = { at: now - v("pollingInterval") - liveLength, polled: true, done: true, endsAt: now - v("pollingInterval") };
  else if (st === "result-wait" || st === "result-missing" || (st === "closed" && fx.outcome === "submitted")) a = { at: past, polled: true, done: false };
  else if (st === "not-through" || st === "doctor-missed") a = { at: past, polled: true, done: true };
  else if (st === "ended-early") a = done(Math.round(gate / 2));
  else a = done(gate + 1000);
  a.pilot = pilot;
  c.call = { attempts: [a], askAt: (LIVE_PAST_GATE.includes(st) ? now : a.at) + v("noResultTimeout"), checkAt: st === "result-wait" ? now + v("mockServerDelay") : null,
    fx: fx.fxCall || null, fxEdits: store.get().callEdits || 0 };
  if (st === "checking-ha" || st === "transferring") c.call.haAt = now;
  if (st === "skip-ha-wait") c.call.resume = "skip-ha-wait";
  if (fx.endedBy) c.call.endedBy = fx.endedBy;
  if (fx.outcome === "submitted" || fx.outcome === "forwarded-ended") c.call.submit = { at: now, done: false };   // the record still settles it (CW-D3, CW-F2)
}

function applyFixture(fx, d, mode) {
  const st = store.get();
  const v = (k) => value(k, mode);
  let scenario = (d && d.scenario) || (mode === "capture" && fx.scenario) || (fx.kind || d ? "cat4" : st.scenario || "cat4");
  // A Fallback B picture needs a Pilot case with an HA call: the story's, if it is one; else (and in capture) the picture's.
  if (fx.pilot && (mode === "capture" || !["pilot_ha_free", "pilot_no_ha_free"].includes(scenario))) scenario = fx.pilot;
  // A case only arrives while the doctor is available: a fixture keeps the session's availability, or starts 30 min [MOCK ASSUMPTION].
  if (!work().avail || availability().state === "none") saveWork({ avail: fx.availEnded ? null : { endsAt: clock.now() + 30 * MIN }, ended: fx.availEnded ? "idle" : null, stopping: false });
  if (fx.availEnded) saveWork({ avail: null, ended: "idle" });
  if (work().rxToday === 0) saveWork({ rxToday: 3 });
  const kind = fx.kind || (!d && (st.story || {}).caseKind) || "normal";
  const c = openCase(scenario, kind === "rx-failed" || kind === "release-refused" ? "normal" : kind);
  c.fxKind = kind;
  if (fx.disable) Object.assign(c.medicines[fx.disable - 1], { status: "disabled", disableReason: MSG("prescribe.reasonDeclined") });
  if (fx.allRx) c.medicines.forEach((m) => { m.status = "prescribed"; });
  // Story "Pending blocks confirm": the doctor reaches Confirm with a medicine still Pending (Flag 5) [MOCK ASSUMPTION, review tool].
  if (fx.allRx && mode !== "capture" && (st.story || {}).prescribe === "pending-blocks-confirm" && c.medicines.length) c.medicines[c.medicines.length - 1].status = "pending";
  if (fx.skipped) { c.ha = "skipped-doctor"; c.haSkipReason = MSG("skipHa.notRequired"); }   // 17: the doctor skipped the HA call on the live call
  if (fx.noDetails) { c.created = ""; c.delivery = ""; c.payment = ""; }
  if (fx.symptoms) c.notes.symptoms = fx.symptoms;
  if (d && d.medPatch) Object.assign(c.medicines.find((m) => m.id === d.med), d.medPatch, d.medPatch.disableReason ? { disableReason: MSG(d.medPatch.disableReason) } : {});
  c.stage = fx.stage || "ready";
  if (c.stage === "closed") c.outcome = fx.outcome || "confirmed";
  if (c.outcome === "callback") c.callback = { ...CB15 };
  if (c.outcome === "unavailable") c.unavailable = { by: "auto", cause: "no-answer" };
  c.attempted = !["ready", "not-through", "doctor-missed"].includes(c.stage);   // 3 / 4 pictures: the patient was never reached (Back shows)
  fixtureCall(c, fx, clock.now(), v);
  saveWork();
  return c;
}

export function render(host, id, { mode, params = {} }) {
  const fx = CASE_FX[id] || (D_FX[id] ? {} : null);
  if (!fx) return null;
  const d = D_FX[id] || null;
  const life = newLife(host, mode);
  const live = !!params.live;
  const capture = mode === "capture";
  let c = live && currentCase() ? currentCase() : applyFixture(fx, d, mode);
  if (!c) { resetNav(); push(null, { s: "home_active", live: true }); return { journey: "home" }; }
  if (!capture) saveCurrent({ live: true });   // Back to this step (from Help) comes back to the case as it is, not to the picture
  const story = () => store.get().story || {};
  const v = (k) => value(k, mode);

  const ui = {
    overlay: live ? null : fx.overlay || (d ? "prescribe" : null),
    releasing: !live && !!fx.releasing, bar: live ? null : fx.bar || null,
    loading: !live && !!fx.loading, loadFailed: !live && !!fx.loadFailed,
    offlineFx: !live && !!fx.offline, expanded: !live && !!fx.expanded,
    rxFailed: !live && (!!fx.rxFailed || c.fxKind === "rx-failed"), confirming: !live && !!fx.confirming,
    toastUntil: !live && fx.toast ? (capture ? Number.MAX_SAFE_INTEGER : Date.now() + v("toastDuration")) : 0,
    typing: !live && capture ? fx.typing || null : null,
    medId: d ? d.med : null,
    cb: { day: null, time: null, error: null, notice: null, busy: false, ...(live ? {} : fx.cb || {}) },   // callback sheet state (kept on failure)
  };
  const offline = () => ui.offlineFx || store.get().offline === "yes";
  const first = () => c.patient.split(" ")[0];
  const closed = () => c.stage === "closed";
  const empty = () => c.medicines.length === 0;
  // Header Back on 1, 3 and 4 only, while the patient has never been reached (D-80 pt 1, D-81 F21)
  const backAllowed = () => ["ready", "not-through", "doctor-missed"].includes(c.stage) && !c.attempted && !ui.loading;
  const callbackAllowed = () => ["ended-early", "result-missing"].includes(c.stage) && !ui.confirming;   // only on 6 and 7d (CW-A1, CW-C3)
  const unavailableAllowed = () => c.stage === "result-missing" && !ui.confirming;   // the doctor marks unavailable only on 7d (D-58 pt 23)
  // Skip HA (D-59): only after the gate, on a Pilot case with an HA call: B1 and 16 (8b and 12 are version A). Never while confirming.
  const skipAllowed = () => ["live", "transfer-missed"].includes(c.stage) && route(c) === "pilot" && !ui.confirming;
  // From the tap while a call may be live, hidden once it has ended (D-58 pt 24); B3 / 15 keep it (the doctor is still on the line).
  const scriptShown = () => ["calling", "still-on-call", ...LIVE_PAST_GATE].includes(c.stage);
  // Read-only content: a closed case, Confirming… / Transferring… (D-81 F24–F25), and B3 / 15 (the prescription is confirmed).
  const contentLocked = () => closed() || ui.confirming || ["transferring", "forwarded-live"].includes(c.stage);
  const busyHa = () => ["checking-ha", "transferring"].includes(c.stage);   // B2 / 13: everything but the busy line is frozen

  const root = h("div", { class: "case-screen tm" });
  host.replaceChildren(root);
  const symptoms = h("textarea", { id: "symptoms-input", placeholder: MSG("case.symptomsPlaceholder"), rows: "3" });
  const doctorNotes = h("textarea", { id: "doctor-notes-input", placeholder: MSG("case.doctorNotesPlaceholder"), rows: "3" });
  // Notes are editable until Confirm and kept if the connection drops (app-logic §9); saved with the case only on confirm.
  symptoms.addEventListener("input", () => { c.notes.symptoms = symptoms.value; saveWork(); });
  doctorNotes.addEventListener("input", () => { c.notes.doctor = doctorNotes.value; saveWork(); });
  const scroller = h("div", { class: "case-scroll", id: "case-scroll" });

  // ---------- pieces ----------
  function tools() {
    const details = !!(c.created || c.delivery || c.payment);   // hidden when the order has none of these (app-logic §9)
    const readonly = contentLocked();
    const card = h("div", { id: "case-tools", class: `tm-card${readonly ? " tm-readonly" : ""}${details ? "" : " ct--no-details"}` },
      h("div", { class: "ct-row" },
        details ? h("button", { class: "ct-details", id: "ct-details", type: "button", "aria-expanded": String(ui.expanded), onclick: () => { ui.expanded = !ui.expanded; draw(); } },
          h("span", { text: MSG("case.orderDetails") }), icon("info-circle")) : null,
        h("span", { id: "ct-actions" }, h("button", { id: "pdb-view-rx-btn", class: "tm-btn tm-btn--secondary", type: "button", onclick: () => { if (!ui.confirming) openOverlay("rx"); } },   // keeps its outlined look while confirming (D-81 F24–F25), takes no tap (app-logic §9)
          icon("clipboard-text", "tm-icon--16"), MSG("case.viewRx")))));
    if (details && ui.expanded) card.append(h("div", { id: "pdb-order-expand" },
      [["case.orderCreated", c.created, "display-order-created"], ["case.expectedDelivery", c.delivery, "display-order-delivery"], ["case.payment", c.payment, "display-payment-mode"]]
        .filter(([, val]) => val).map(([k, val, idv]) => h("div", { class: "pdb-expand-item" }, h("span", { class: "pdb-expand-label", text: MSG(k) }), h("span", { class: "pdb-expand-value", id: idv, text: val })))));
    return card;
  }
  function scriptCard() {   // end-of-call script (D-58 pts 18, 21): Cat4 / HA skipped, or the neutral Pilot line
    return h("div", { id: "action-zone", class: "tm-card" }, h("h2", { class: "tm-section-title section-title--inline", text: MSG("case.scriptTitle") }),
      h("div", { id: "pre-call-brief", class: "tm-notice", role: "status" }, h("div", { class: "pcb-body" }, h("div", { class: "pcb-text", id: "pcb-text", text: MSG(scriptKey(c)) }))));
  }
  function medicines() {
    const readonly = contentLocked();
    const n = c.medicines.length;
    return h("div", { id: "medicines-section" },
      h("div", { id: "medicines-header", class: readonly ? "tm-readonly" : null },
        h("h2", { class: "tm-section-title section-title--inline", text: MSG(closed() || c.stage === "forwarded-live" ? "case.medicinesTitleClosed" : "case.medicinesTitle") }),
        empty() ? null : h("span", { id: "medicines-count", text: n === 1 ? MSG("case.medicinesCountOne") : MSG("case.medicinesCount", { n }) })),
      h("div", { id: "medicines-list", class: readonly ? "tm-readonly" : null }, c.medicines.map((m) => medicineRow(m, { readonly, onOpen: (mid) => { if (!busyHa()) openOverlay("prescribe", mid); } }))));   // B2 looks as approved, takes no tap
  }
  function notes() {
    const ro = contentLocked() || busyHa();
    symptoms.readOnly = ro; doctorNotes.readOnly = ro;
    const off = !!ui.confirming || busyHa();   // Confirming… / B2 / 13: everything else disabled (app-logic §6)
    symptoms.disabled = off; doctorNotes.disabled = off;
    if (document.activeElement !== symptoms) symptoms.value = c.notes.symptoms;
    if (document.activeElement !== doctorNotes) doctorNotes.value = c.notes.doctor;
    const field = (lbl, forId, ta) => h("div", { class: `tm-field${ro ? " tm-field--readonly" : ""}` }, h("label", { class: "tm-field__label", for: forId, text: MSG(lbl) }), h("div", { class: "tm-field__control" }, ta));
    return h("div", { id: "notes-section" }, h("h2", { class: "tm-section-title", text: MSG("case.notesTitle") }),
      field("case.symptomsLabel", "symptoms-input", symptoms), field("case.doctorNotesLabel", "doctor-notes-input", doctorNotes));
  }
  // Outcome card under Order details (D-58 pt 16): tinted (D-62); the icon says what happened (B-22).
  const OUTCOME = {
    confirmed: () => ["success", "circle-check", MSG("case.confirmedTitle"), null],
    submitted: () => ["neutral", "clock", MSG("call.submittedTitle"), MSG("call.submittedText")],
    unavailable: () => ["neutral", "phone-off", MSG("case.unavailableTitle"), null],
    callback: () => ["neutral", "calendar", MSG("callback.scheduled", { day: MSG(c.callback.day === "today" ? "callback.dayToday" : "callback.dayTomorrow"), time: slotLabel(c.callback.time) }), null],
    transferred: () => ["success", "circle-check", MSG("case.transferredTitle"), null],   // 14
    forwarded: () => ["success", "circle-check", MSG("case.forwardedTitle"), null],   // 10b
    // B3 / 15 after the hang-up: neutral, title only, no body line (MAIN-CHECK 2, D-85)
    "forwarded-ended": () => ["neutral", "info-circle", MSG("case.forwardedTitle"), null],
    // B3 / 15 while live: amber card "Forwarded to Health Advisor · Read the script, then end the call." (D-62, CW-E1)
    "forwarded-live": () => ["warning", "alert-triangle", MSG("case.forwardedTitle"), MSG("call.transferFailed")],
  };
  function closedCard() {
    const [tone, ic, title, text] = (OUTCOME[c.stage === "forwarded-live" ? "forwarded-live" : c.outcome] || OUTCOME.confirmed)();
    return h("div", { id: "success-toast", class: `tm-status-card tm-status-card--${tone}${text ? " concept-has-text" : ""}`, role: "status" },
      h("div", { class: "tm-status-card__icon" }, icon(ic, "tm-icon--24")),
      h("div", { class: "tm-status-card__body" }, h("div", { class: "tm-status-card__title", text: title }), text ? h("div", { class: "tm-status-card__text", text }) : null));
  }
  const pending = () => c.medicines.filter((m) => m.status === "pending").length;
  const BAR = {
    "release-failed": () => notice("error", MSG("case.releaseFailed")),
    "offline-action": () => notice("error", MSG("case.offlineAction")),
    "confirm-failed": () => notice("error", MSG("case.confirmFailed")),
    "confirm-blocked": () => notice("error", pending() === 1 ? MSG("case.confirmBlockedOne") : MSG("case.confirmBlocked", { n: pending() })),
  };
  // The bar's own notice per calling stage (app-logic §5 state table, D-54 #4: the reason sits in the pinned bar).
  const STAGE_NOTICE = {
    "not-through": () => notice("error", MSG("call.notThrough")),
    "doctor-missed": () => notice("warning", MSG("call.doctorMissed"), { iconName: "phone-off" }),
    "ended-early": () => notice("warning", MSG("call.endedEarly"), { iconName: "phone-off" }),
    "result-missing": () => notice("warning", MSG("call.resultMissing")),
    "still-on-call": () => notice("neutral", MSG("call.stillOnCall"), { iconName: "phone", cls: "tm-notice--question" }),
    "transfer-missed": () => notice("warning", MSG(WHO_ENDED[(c.call && c.call.endedBy) || "unknown"] || WHO_ENDED.unknown), { iconName: "phone-off" }),   // 16 names who ended it
    "skip-ha-wait": () => notice("neutral", MSG("call.skipHa")),   // 17: grey note (D-85)
  };
  function bar() {
    const lg = "tm-btn--lg tm-btn--block";
    const t = Date.now() < ui.toastUntil ? h("div", { class: "case-toast" }, toast(blockedText())) : null;
    let band = ui.bar && BAR[ui.bar] ? BAR[ui.bar]() : null;
    if (!band && STAGE_NOTICE[c.stage] && !ui.loadFailed) band = STAGE_NOTICE[c.stage]();
    if (offline() && !closed() && !ui.bar) band = notice("warning", MSG("case.offline"));   // D-54: offline blocks the main action
    const callAgain = () => btn([icon("phone"), MSG("case.callAgain")], `tm-btn--primary ${lg}`, onCall, { id: "call-initiate-btn" });
    const callbackBtn = () => btn([icon("calendar", "tm-icon--16"), MSG("case.callback")], "tm-btn--secondary tm-btn--lg", () => openOverlay("callback"), { id: "schedule-callback-btn", disabled: !!ui.confirming });   // Confirming…: everything else disabled
    // The final button follows the route (app-logic §6, CW-D2): Confirm & forward on 16 and the Pilot 7d; else Confirm prescription.
    const forward = c.stage === "transfer-missed" || (c.stage === "result-missing" && route(c) === "pilot");
    const confirmBtn = () => (ui.confirming ? busyBtn(MSG("case.confirming"), `tm-btn--primary ${lg}`) : btn(MSG(forward ? "case.confirmForward" : "case.confirmPrescription"), `tm-btn--primary ${lg}`, onConfirm, { id: "main-cta-btn" }));
    // Skip HA: alone, full width, under the main button; greyed and disabled while the HA is checked or transferred (K11, K13).
    const skipRow = (disabled) => h("div", { class: "tm-btn-pair case-pair--single" },
      btn([icon("player-track-next", "tm-icon--16"), MSG("case.skipHa")], "tm-btn--secondary tm-btn--lg", () => openOverlay("skip"), { id: "skip-ha-btn", disabled }));
    const slotLine = (text) => { const el = statusLine(text); el.classList.add("case-status--slot"); return el; };   // B-02: centred in the button's slot
    let kids;
    if (ui.loadFailed) kids = [btn(MSG("common.tryAgain"), `tm-btn--primary ${lg}`, onRetryLoad)];
    else if (closed()) {
      const ended = availability().state === "none";
      kids = ended ? [btn(MSG("case.backToHome"), `tm-btn--primary ${lg}`, () => toHome(), { id: "concept-back-home" })]
        : [btn([MSG("case.requestNext"), " ", icon("arrow-right")], `tm-btn--primary ${lg}`, () => toHome(true), { id: "next-order-btn" }), btn(MSG("case.backToHome"), `tm-btn--quiet ${lg}`, () => toHome(), { id: "concept-back-home" })];
    } else if (c.stage === "calling") kids = [statusLine(MSG("call.calling", { name: first() }))];   // D-74: no Callback, no End call on a live call (CW-A1)
    else if (c.stage === "result-wait") kids = [statusLine(MSG("call.resultWait"))];   // 5 and 7c (D-91)
    else if (c.stage === "still-on-call") kids = [h("div", { class: "tm-btn-pair" }, btn(MSG("case.stillTalking"), "tm-btn--secondary tm-btn--lg", onStillTalking), btn(MSG("case.callEnded"), "tm-btn--secondary tm-btn--lg", onCallEnded))];
    else if (c.stage === "not-through" || c.stage === "doctor-missed") kids = [callAgain()];
    else if (c.stage === "ended-early") kids = [callAgain(), h("div", { class: "tm-btn-pair case-pair--single" }, callbackBtn())];   // Call again · Callback, no Unavailable (D-58 pt 23)
    else if (c.stage === "result-missing") kids = [confirmBtn(), h("div", { class: "tm-btn-pair" }, callbackBtn(),   // CW-D2: Cat4 / HA skipped → Confirm prescription
      btn([icon("phone-off", "tm-icon--16"), MSG("case.unavailable")], "tm-btn--destructive tm-btn--lg", () => openOverlay("unavailable"), { id: "az-unavail-btn", disabled: !!ui.confirming }))];
    else if (c.stage === "valid") kids = [confirmBtn()];   // 8a: Confirm prescription only (CW-C3)
    // Fallback B (app-logic §5, §6): B1 Confirm prescription · Skip HA; B2 checking; 13 Transferring…; B3 / 15 wait for the
    // hang-up; 17 the grey note (band) + Getting call result…; 16 Confirm & forward · Skip HA. No Callback on any of them (CW-A1).
    else if (c.stage === "live") kids = [confirmBtn(), skipRow(!skipAllowed())];
    else if (c.stage === "checking-ha") kids = [slotLine(MSG("call.checkingHa")), skipRow(true)];
    else if (c.stage === "transferring") kids = [busyBtn(MSG("call.connectingHa"), `tm-btn--primary ${lg}`), skipRow(true)];
    else if (c.stage === "forwarded-live") kids = [statusLine(MSG("call.waitingForHangup"))];
    else if (c.stage === "skip-ha-wait") kids = [statusLine(MSG("call.resultWait"))];
    else if (c.stage === "transfer-missed") kids = [confirmBtn(), skipRow(!skipAllowed())];
    else if (empty()) kids = [ui.releasing ? busyBtn(MSG("case.releasing"), `tm-btn--primary ${lg}`) : btn(MSG("case.releaseCase"), `tm-btn--primary ${lg}`, () => onRelease(true))];
    else kids = [btn([icon("phone"), MSG("case.callPatient")], `tm-btn--primary ${lg}`, onCall, { id: "call-initiate-btn" })];
    return actionBar([...kids, t], { notice: band, cls: "case-bar", id: "case-actionbar" });
  }
  function blockedText() {   // the toast breaks between its two sentences (B-21)
    const text = MSG("case.backBlocked"), at = text.indexOf(". ");
    return at < 0 ? text : [text.slice(0, at + 1) + " ", h("br"), text.slice(at + 2)];
  }
  function leaveSheet() {
    const busy = ui.releasing;
    return sheet({ title: MSG("case.leaveTitle"), subtitle: MSG("case.leaveSub"), closeDisabled: busy, onClose: closeOverlay, id: "cl-sheet",
      actions: [busy ? busyBtn(MSG("case.releasing"), "tm-btn--primary tm-btn--lg tm-btn--block") : btn(MSG("case.releaseCase"), "tm-btn--primary tm-btn--lg tm-btn--block", () => onRelease(false), { id: "cl-release" }),
        btn(MSG("case.stay"), "tm-btn--quiet tm-btn--lg tm-btn--block", closeOverlay, { id: "cl-stay", disabled: busy })] });
  }
  function skeleton() {   // D-81 F28: an Order details row, Medicines and Notes blocks, in the same places; no text, no actions
    return h("div", { class: "case-skeleton", role: "status", "aria-label": MSG("case.loadingLabel") },
      h("div", { class: "case-skel case-skel--details" }), h("div", { class: "case-skel case-skel--medicines" }), h("div", { class: "case-skel case-skel--notes" }));
  }
  function overlayEl() {
    if (ui.overlay === "leave") return leaveSheet();
    if (ui.overlay === "rx") return rxViewer(c, { mode, failed: ui.rxFailed, onClose: closeOverlay, onRetry: onRxRetry, later: life.later });
    if (ui.overlay === "callback") return callbackSheet(ui.cb, { onDay: (x) => pickCb({ day: x }), onTime: (x) => pickCb({ time: x }), onConfirm: onCallbackConfirm, onClose: closeOverlay });
    if (ui.overlay === "unavailable") return unavailableSheet({ onReason: onUnavailableReason, onClose: closeOverlay });
    if (ui.overlay === "skip") return skipHaSheet({ onReason: onSkipReason, onClose: closeOverlay });
    return null;
  }

  // ---------- draw ----------
  let prescribeEl = null;
  function draw() {
    const focused = document.activeElement === symptoms ? symptoms : document.activeElement === doctorNotes ? doctorNotes : null;
    const head = caseHeader(c, { back: backAllowed() && !closed(), onBack: onBack, onHelp: toHelp, loading: ui.loading });
    let content;
    if (ui.loading) content = [skeleton()];
    else if (ui.loadFailed) content = [h("div", { class: "tm-card" }, notice("error", MSG("case.loadFailed")))];
    else content = [empty() && !closed() ? h("div", { class: "tm-card case-empty" }, notice("warning", MSG("case.noMedicines"))) : null,
      tools(), closed() || c.stage === "forwarded-live" ? closedCard() : null, scriptShown() ? scriptCard() : null, medicines(), notes()];
    const top = scroller.scrollTop;
    scroller.replaceChildren(...content.filter(Boolean));
    scroller.scrollTop = top;
    const overlay = overlayEl();
    if (ui.overlay !== "prescribe") prescribeEl = null;
    const kb = ui.typing ? mockTextKeyboard() : null;
    root.replaceChildren(head, scroller, ui.loading ? "" : bar(), overlay || "", ui.overlay === "prescribe" ? prescribeEl || (prescribeEl = makePrescribe()) : "", kb || "");
    root.classList.toggle("is-closed", closed());
    root.classList.toggle("kb-open", !!kb);
    root.classList.toggle("is-loading", ui.loading);
    paint(root);
    if (focused) focused.focus({ preventScroll: true });
    if (overlay && ["leave", "callback", "unavailable", "skip"].includes(ui.overlay) && !capture && overlay !== lastSheet) focusSheet(overlay);
    lastSheet = overlay;
  }
  let lastSheet = null;
  function makePrescribe() {
    const med = c.medicines.find((m) => m.id === ui.medId);
    if (!med) { ui.overlay = null; return ""; }
    return prescribeScreen(med, {
      mode, fixture: live ? null : d, later: life.later,
      onSave(patch) { updateMedicine(med.id, { ...patch, status: "prescribed", disableReason: null }); closeOverlay(); },   // re-enables a disabled medicine (D-20)
      onDisable(reason) { updateMedicine(med.id, { status: "disabled", disableReason: reason }); closeOverlay(); },   // removed from the order (D-59)
      onClose: closeOverlay,
    });
  }

  // ---------- behaviour ----------
  function openOverlay(which, medId) {
    if (closed() && which === "prescribe") return;
    if (which === "prescribe" && (busyHa() || contentLocked())) return;
    if ((which === "callback" && !callbackAllowed()) || (which === "unavailable" && !unavailableAllowed()) || (which === "skip" && !skipAllowed())) return;
    if (which === "callback") ui.cb = { day: null, time: null, error: null, notice: null, busy: false };
    ui.overlay = which; ui.medId = medId ?? ui.medId; ui.rxFailed = which === "rx" && c.fxKind === "rx-failed"; draw();
  }
  function closeOverlay() { if (ui.releasing || ui.cb.busy) return; ui.overlay = null; draw(); }
  function onRxRetry() { ui.rxFailed = c.fxKind === "rx-failed" && story().caseKind === "rx-failed"; draw(); }   // retry follows the story: still failing, or loads
  function onBack() {
    if (!backAllowed()) return;
    if (empty()) { onRelease(true); return; }   // empty case: Back releases directly, no sheet (D-83 CW-A6)
    ui.bar = null; ui.overlay = "leave"; draw();
  }
  // Release (OQ-024 backend): one request; refused when our call request was accepted (D-80) — the story's "release refused".
  function onRelease(direct) {
    if (ui.releasing) return;
    if (offline()) { ui.overlay = null; ui.bar = "offline-action"; draw(); return; }
    ui.releasing = true; draw();
