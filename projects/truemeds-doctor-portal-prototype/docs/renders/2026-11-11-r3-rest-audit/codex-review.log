.tm-toast {
  /* Round 4 (2026-11-02): a screen with a pinned action bar sets --tm-toast-offset to the bar's height + 16 so the toast sits above the bar. */
  position: fixed; left: 50%; bottom: var(--tm-toast-offset, var(--tm-space-xl)); transform: translateX(-50%);   /* raw-ok: 50% centring (geometry) */
  background: var(--tm-surface-inverse); color: var(--tm-content-inverse);
  /* RULES §9.5 (2026-10-15): dark, 14/20, 12×16 padding, medium radius, one line (two at most). Was 12/16 with 4×8 padding — too small to notice. */
  font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-medium);
  padding: var(--tm-space-md) var(--tm-space-lg); border-radius: var(--tm-radius-md); box-shadow: var(--tm-shadow-secondary);
  width: max-content; max-width: calc(100% - 2 * var(--tm-space-xl)); text-align: center; z-index: var(--tm-layer-toast);   /* raw-ok: 100% fill (geometry) */
}
/* Use only where nothing on screen can show the result. One at a time, about 4 s, role="status" (polite), never takes focus. */

/* Snackbar — UNUSED: a toast never carries an action (RULES §9.5). Candidate to drop.
   [PROPOSED] Snackbar — message + one action (e.g. "Order confirmed · Next order"). SALT's toast is one line with
   no action; this is the minimal compliant surface for a confirmation that carries a next step. Pending design-team review. */
.tm-snackbar {
  position: fixed; left: var(--tm-space-lg); right: var(--tm-space-lg); bottom: var(--tm-space-lg); z-index: var(--tm-layer-snackbar);
  display: flex; align-items: center; gap: var(--tm-space-md);
  padding: var(--tm-space-md) var(--tm-space-lg);
