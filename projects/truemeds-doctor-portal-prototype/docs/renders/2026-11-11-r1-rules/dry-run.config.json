 "roles": {
  "legal": ".consent",
  "linkLine": ".rs",
  "tile": ".hero-ic, .prompt-icon",
  "caption": "#ready",
  "groupLabel": ".lbl",
  "pointTitle": ".pt-t",
  "pointLine": ".pt-d"
 },
 "rules": [
  { "above": ".cols", "below": ".wheel", "gap": 4, "box": true, "kind": "anatomy", "note": "wheel column heads 4 (component)" }
 ],
