  { "name": "otp/default", "url": "../../../ui-screens/otp/otp.html?capture=default", "root": ".screen",
    "regions": [{ "name": "panel", "selector": ".panel", "edgeTop": true }] },
  { "name": "otp/wrong-code", "url": "../../../ui-screens/otp/otp.html?capture=wrong-code", "root": ".screen",
