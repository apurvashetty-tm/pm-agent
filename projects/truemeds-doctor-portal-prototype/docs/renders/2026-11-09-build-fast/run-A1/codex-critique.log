    61	  const c = openCase(scenario, kind === "rx-failed" || kind === "release-refused" ? "normal" : kind);
    62	  c.fxKind = kind;
    63	  if (fx.disable) Object.assign(c.medicines[fx.disable - 1], { status: "disabled", disableReason: MSG("prescribe.reasonDeclined") });
