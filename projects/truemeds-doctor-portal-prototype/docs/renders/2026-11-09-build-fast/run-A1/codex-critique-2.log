    10	
    11	const ONGOING_PERIOD = { n: 6, unit: "m" };   // the backend's default for Ongoing [MOCK ASSUMPTION, app-logic §8]
    12	// Dose choices by form (app-logic §8 table; D-54: injection 1 · 2 · 3 + Other; D-81: capsules without ½).
    13	const FORM = {
    14	  tablet:    { slot: [0, 0.5, 1, 2], each: [0.5, 1, 2], one: "tablet", many: "tablets", bare: true },
    15	  capsule:   { slot: [0, 1, 2], each: [1, 2], one: "capsule", many: "capsules", bare: true },
    16	  syrup:     { slot: [0, 2.5, 5, 10], each: [2.5, 5, 10], one: "ml", many: "ml", other: "ml", showUnit: true },
    17	  drops:     { slot: [0, 1, 2, 3], each: [1, 2, 3], one: "drop", many: "drops" },
    18	  inhaler:   { slot: [0, 1, 2], each: [1, 2], one: "puff", many: "puffs", showUnit: true },
    19	  injection: { slot: [0, 1, 2, 3], each: [1, 2, 3], one: "dose", many: "doses", other: "units" },
    20	  cream:     { slot: [0, 1], each: [1], one: "time", many: "times", apply: true },
    21	};
    22	const INTERVALS = [["daily", "prescribe.daily"], ["every_x_hours", "prescribe.everyXHours"], ["alt_days", "prescribe.altDays"], ["weekly", "prescribe.weekly"], ["monthly", "prescribe.monthly"], ["sos", "prescribe.sosOnly"]];
    23	const HOURS = [4, 6, 8, 12], SOS_MAX = [1, 2, 3, 4], DUR_NUMBERS = [1, 2, 3, 4, 5, 6, 7, 10, 14, 15];
    24	const DUR_UNITS = [["d", "prescribe.days"], ["w", "prescribe.weeks"], ["m", "prescribe.months"]];
    25	const FOODS = [["after_food", "prescribe.afterFood"], ["before_food", "prescribe.beforeFood"], ["empty_stomach", "prescribe.emptyStomach"]];
    26	const SLOTS = [["m", "prescribe.keyMorning", "prescribe.morning"], ["a", "prescribe.keyAfternoon", "prescribe.afternoon"], ["n", "prescribe.keyNight", "prescribe.night"]];
    27	const REASONS = [["prescribe.reasonRemote", "prescribe.reasonRemoteDesc"], ["prescribe.reasonContra", "prescribe.reasonContraDesc"], ["prescribe.reasonDuplicate", "prescribe.reasonDuplicateDesc"], ["prescribe.reasonDeclined", "prescribe.reasonDeclinedDesc"], ["prescribe.reasonStrength", "prescribe.reasonStrengthDesc"]];
    28	const fd = (f) => FORM[f] || FORM.tablet;
    29	const num = (v) => (v === 0.5 ? "½" : String(v));
    30	const unit = (key) => MSG(`print.unit.${key}`);
    31	
    32	// ---- the printed line (app-logic §8 "Printed line", D-80 pt 3, D-81 F14) ----
    33	// "Other" picked with no valid number leaves the dose out (D-54 D12). Only plain positive numbers: 7, 7.5, .5.
    34	export function parseDose(s) { const t = String(s ?? "").trim(); if (!/^(\d+(\.\d+)?|\.\d+)$/.test(t)) return NaN; const v = Number(t); return v > 0 ? v : NaN; }
    35	function doseOf(x) { return x.doseOther ? parseDose(x.doseOtherVal) : x.dose; }
    36	function amount(form, v, other) {   // "1 tablet", "½ tablet", "5 ml", "2 puffs", "7.5 units"
    37	  const f = fd(form);
    38	  if (other) return MSG("print.amount", { n: v, unit: unit(f.other) });
    39	  return MSG("print.amount", { n: num(v), unit: unit(v > 1 ? f.many : f.one) });
    40	}
    41	function total(form, v, max, other) {   // the SOS daily limit in the medicine's unit; a total of 1 is singular
    42	  const f = fd(form), t = Math.round(v * max * 100) / 100;
    43	  if (f.apply) return MSG("print.amount", { n: t, unit: unit(t === 1 ? "time" : "times") });
    44	  if (other) return MSG("print.amount", { n: t, unit: unit(f.other) });
    45	  return MSG("print.amount", { n: num(t), unit: unit(t === 1 ? f.one : f.many) });
    46	}
    47	const man = (x) => `${num(x.m)}-${num(x.a)}-${num(x.n)}`;
    48	function schedule(x) {
    49	  const f = fd(x.form), d = doseOf(x), ok = isFinite(d);
    50	  const dose = ok ? (f.apply ? MSG("prescribe.apply") : amount(x.form, d, x.doseOther)) : "";
    51	  let t;
    52	  switch (x.interval) {
    53	    case "daily": t = f.apply ? MSG("print.applyMAN", { man: man(x) }) : f.bare ? man(x) : `${man(x)} ${unit(f.many)}`; break;
    54	    case "every_x_hours": t = MSG("print.everyHours", { dose, n: x.hours }); break;
    55	    case "alt_days": t = MSG("print.altDays", { dose }); break;
    56	    case "weekly": t = MSG("print.weekly", { dose }); break;
    57	    case "monthly": t = MSG("print.monthly", { dose }); break;
    58	    case "sos": return f.apply ? MSG("print.applyAsNeeded", { max: total(x.form, 1, x.sosMax) }) : MSG("print.asNeeded", { dose, max: ok ? total(x.form, d, x.sosMax, x.doseOther) : "" });
    59	    default: t = "";
    60	  }
    61	  if (!x.sos) return t;
    62	  return MSG("print.plusSos", { schedule: t, dose: f.apply ? MSG("prescribe.apply") : amount(x.form, x.sosDose), max: total(x.form, f.apply ? 1 : x.sosDose, x.sosMax) });
    63	}
    64	function durationWords(code) {
    65	  const n = code === "ongoing" ? ONGOING_PERIOD.n : parseInt(code, 10), u = code === "ongoing" ? ONGOING_PERIOD.unit : code.slice(-1);
    66	  const word = { d: n === 1 ? "day" : "days", w: n === 1 ? "week" : "weeks", m: n === 1 ? "month" : "months" }[u];
    67	  return MSG("print.duration", { n, unit: MSG(`print.${word}`) });
    68	}
    69	export function printLine(x) {
    70	  const food = FOODS.find(([k]) => k === x.food);
    71	  let line = [schedule(x), durationWords(x.duration), food ? MSG(food[1]) : "", (x.note || "").trim()].filter(Boolean).join(MSG("print.sep")).trim();
    72	  return line.charAt(0).toUpperCase() + line.slice(1);
    73	}
    74	// B-12: a number stays with its unit ("6 months" never splits): each "number unit" pair is one no-wrap span.
    75	function printNodes(line) {
