    89	// Keyboard rule (D-81): the focused field scrolls into view above the keyboard with its label and helper, 16 clear of it.
    90	export function revealAboveKeyboard(scroller, field, keyboard) {
    91	  if (!scroller || !field || !keyboard) return;
    92	  const gap = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--tm-space-lg")) || 0;
    93	  const d = field.getBoundingClientRect().bottom + gap - keyboard.getBoundingClientRect().top;
    94	  if (d > 0) scroller.scrollTop += d;
    95	}
    96	
    97	// Keyboard rule (D-81) on a phone: the pinned bar hides while the keyboard is open and returns when it closes. The keyboard is
    98	// "open" when a text field has focus and the visual viewport is clearly shorter than the tallest seen (the keyboard took it).
    99	export function watchKeyboard(root, alive) {
   100	  const vv = window.visualViewport; if (!vv) return;
   101	  let tallest = vv.height;
   102	  const check = () => {
   103	    if (!alive()) { vv.removeEventListener("resize", check); return; }
   104	    tallest = Math.max(tallest, vv.height);
   105	    const field = document.activeElement && root.contains(document.activeElement) && /^(TEXTAREA|INPUT)$/.test(document.activeElement.tagName);
   106	    root.classList.toggle("kb-real", !!field && vv.height < tallest * 0.8);
   107	  };
   108	  vv.addEventListener("resize", check); root.addEventListener("focusin", check); root.addEventListener("focusout", () => setTimeout(check, 0));
   109	}
