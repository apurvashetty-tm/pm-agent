    61	// Returns a complete story, or null when the code can't be read or any value is not allowed.
    62	export function decodeStory(code) {
    63	  if (typeof code === "string" && /^3[a-zA-Z0-9~]*$/.test(code)) return decodeShort(code);
    64	  try {
    65	    const o = JSON.parse(dec(code));
    66	    if (!o || o.v !== 2) return null;
    67	    const story = { v: 2 };
    68	    for (const [key, options] of Object.entries(STORY_FIELDS)) {
    69	      if (!(key in o) && key === "device") { story[key] = DEFAULT_STORY[key]; continue; }   // links made before the field existed
    70	      if (!options.includes(o[key])) return null;
    71	      story[key] = o[key];
    72	    }
    73	    if (!Array.isArray(o.calls) || o.calls.length < 1 || o.calls.length > MAX_CALL_ATTEMPTS) return null;
    74	    story.calls = o.calls.map((a) => {
    75	      if (!a || typeof a !== "object") return null;
    76	      const att = {};
    77	      for (const k of CALL_KEYS) { if (!CALL_CHOICES[k].includes(a[k])) return null; att[k] = a[k]; }
    78	      if (Object.keys(a).length !== CALL_KEYS.length) return null;
    79	      return att;
    80	    });
    81	    if (story.calls.some((a) => a === null)) return null;
    82	    return story;
    83	  } catch (e) {
    84	    return null;
    85	  }
    86	}
