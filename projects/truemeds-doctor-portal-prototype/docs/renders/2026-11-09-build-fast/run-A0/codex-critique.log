    53	
    54	export function encodeStory(story) {
    55	  const out = { v: 2 };
    56	  for (const key of Object.keys(STORY_FIELDS)) out[key] = story[key] ?? DEFAULT_STORY[key];
    57	  out.calls = (story.calls && story.calls.length ? story.calls : [defaultAttempt()]).map((a) => Object.fromEntries(CALL_KEYS.map((k) => [k, a[k]])));
    58	  return enc(JSON.stringify(out));
    59	}
