    20	async function frame(p) {
    21	  // Public driver #screen; infer its enclosing phone frame geometrically, without implementation selectors.
    22	  return p.locator('#screen').evaluate(e=>{
    23	    const found=[];
    24	    for(let n=e;n && n!==document.body;n=n.parentElement){const r=n.getBoundingClientRect();
    25	      if(r.width>200 && r.width<450 && r.height>600 && r.height<900) found.push({x:r.x,y:r.y,width:r.width,height:r.height});}
    26	    if(!found.length) throw Error('Adapter: cannot identify enclosing frame from public #screen');
    27	    return found.at(-1);
    28	  });
    29	}
