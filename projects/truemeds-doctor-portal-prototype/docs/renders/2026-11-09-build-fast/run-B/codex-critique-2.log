   524	    if (!ui.cb.busy && ((ui.overlay === "callback" && !callbackAllowed()) || (ui.overlay === "unavailable" && !unavailableAllowed()) || (ui.overlay === "skip" && !skipAllowed()))) ui.overlay = null;
