async function prescribeAll(d) {
  for (let i = 0; i < 20; i++) {
    const rows = d.root().locator("#medicines-list .tm-row").filter({ hasText: "Pending" }); if (!(await rows.count())) break;
    await rows.first().click(); await d.click("Prescribe"); await d.settle();
  }
