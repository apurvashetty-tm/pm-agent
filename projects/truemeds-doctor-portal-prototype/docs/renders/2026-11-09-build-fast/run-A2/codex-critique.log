   246	// Phone drawer (Part A item 4): the controls for the screen the phone is on come first, then Jump to a state and the Story row
   247	// (Restart story). Other rows are hidden on a phone. Desktop shows every row. Called on every screen change.
   248	export function focusJourney(root, journey) {
   249	  root.dataset.journey = journey || "";
   250	  const narrow = matchMedia("(max-width: 767px)").matches;
   251	  const forJourney = (el) => (el.dataset.for || "").split(" ").some((j) => j === "always" || j === journey);
   252	  root.querySelectorAll("label[data-for], .rp-tests[data-for]").forEach((l) => { l.hidden = narrow && !forJourney(l); });
   253	  const card = root.querySelector("#rp-review");
   254	  const rows = [...root.querySelectorAll("details.rp-row")];
   255	  rows.forEach((d) => {
   256	    const hasControls = [...d.querySelectorAll("label[data-for], .rp-tests[data-for]")].some((l) => !l.hidden);
   257	    const always = d.dataset.row === "story" || d.dataset.row === "jump";
   258	    d.hidden = narrow && !(always || (hasControls && !["settings", "log", "phone"].includes(d.dataset.row)));
   259	  });
   260	  if (!card) return;
   261	  const group = card.querySelector("[data-group=advanced]");
   262	  if (group) group.hidden = narrow;
   263	  if (narrow) {
   264	    const mine = rows.filter((d) => !d.hidden && d.dataset.row !== "story" && d.dataset.row !== "jump");
   265	    const order = [...mine, rows.find((d) => d.dataset.row === "jump"), rows.find((d) => d.dataset.row === "story"), card.querySelector(".rp-bar")];
   266	    order.forEach((d) => d && card.append(d));
   267	    if (mine[0]) mine[0].open = true; else rows.find((d) => d.dataset.row === "story").open = true;
   268	  } else {
   269	    const order = ["phone", "story", "jump", "entry", "work", "call", "advanced", "settings", "log"];
   270	    order.forEach((k) => { const d = k === "advanced" ? group : rows.find((r) => r.dataset.row === k); if (d) card.append(d); });
   271	    card.append(card.querySelector(".rp-bar"));
   272	  }
   273	}
   274	const LOG_SHOWN = 10;   // newest events only; the count in the row keeps the total
   275	// The event log survives reopening the app like the simulated server does (review / play keep it in the mode's storage, set by
   276	// boot), so a completed confirm is seen exactly once after a reload (D-50 events once per completed confirm).
   277	let keeper = null;
   278	export function setLogKeeper(fn) { keeper = fn; }
   279	export function logLine(root, text, { replay = false } = {}) {
   280	  const ol = root && root.querySelector("#rp-log");
   281	  if (!ol) return;
   282	  const li = document.createElement("li");
   283	  li.textContent = text;
   284	  ol.prepend(li);
   285	  while (ol.children.length > LOG_SHOWN) ol.lastElementChild.remove();   // bounded: the desktop panel never scrolls (RULES §7)
   286	  if (keeper && !replay) keeper(text);
