    70	export function settleHolds(now, { gap, attempts, onRetry, onExhausted }) {
    71	  const list = work().holds || [];
    72	  if (!list.length) return;
    73	  let changed = false;
    74	  const left = list.filter((x) => {
    75	    if (x.policy !== "by-cause") { changed = true; return false; }
    76	    while (x.done < attempts && now >= x.at + (x.done + 1) * gap) { x.done += 1; changed = true; onRetry(x, x.done, attempts); }
