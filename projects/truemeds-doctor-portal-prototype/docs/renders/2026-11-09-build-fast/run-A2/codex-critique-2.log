   125	export function render(host, id, { mode, params = {} }) {
   126	  const fx = CASE_FX[id] || (D_FX[id] ? {} : null);
   127	  if (!fx) return null;
   128	  const d = D_FX[id] || null;
   129	  const life = newLife(host, mode);
   130	  const live = !!params.live;
   131	  const capture = mode === "capture";
   132	  let c = live && currentCase() ? currentCase() : applyFixture(fx, d, mode);
   133	  if (!c) { resetNav(); push(null, { s: "home_active", live: true }); return { journey: "home" }; }
   134	  if (!capture) saveCurrent({ live: true });   // Back to this step (from Help) comes back to the case as it is, not to the picture
   135	  const story = () => store.get().story || {};
   136	  const v = (k) => value(k, mode);
   137	
   138	  const ui = {
   139	    overlay: live ? null : fx.overlay || (d ? "prescribe" : null),
   140	    releasing: !live && !!fx.releasing, bar: live ? null : fx.bar || null,
   141	    loading: !live && !!fx.loading, loadFailed: !live && !!fx.loadFailed,
   142	    offlineFx: !live && !!fx.offline, expanded: !live && !!fx.expanded,
   143	    rxFailed: !live && (!!fx.rxFailed || c.fxKind === "rx-failed"), confirming: !live && !!fx.confirming,
   144	    toastUntil: !live && fx.toast ? (capture ? Number.MAX_SAFE_INTEGER : Date.now() + v("toastDuration")) : 0,
   145	    typing: !live && capture ? fx.typing || null : null,
   146	    medId: d ? d.med : null,
   147	    cb: { day: null, time: null, error: null, notice: null, busy: false, ...(live ? {} : fx.cb || {}) },   // callback sheet state (kept on failure)
   148	  };
   149	  const offline = () => ui.offlineFx || store.get().offline === "yes";
   150	  const first = () => c.patient.split(" ")[0];
