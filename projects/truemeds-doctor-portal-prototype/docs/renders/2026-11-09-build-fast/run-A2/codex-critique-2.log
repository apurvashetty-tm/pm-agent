    79	// The call history a calling picture implies (B8: time stamps, never counters). Earlier calls sit 10 min back, inside the
    80	// talk-time window; a 7b picture is one no-result timeout after the tap.
    81	function fixtureCall(c, fx, now, v) {
    82	  const st = fx.stage;
    83	  if (!st || st === "ready") return;
    84	  const gate = v("gate");
    85	  const past = now - 10 * MIN;
    86	  const done = (talk) => ({ at: past, polled: true, done: true, counted: talk >= v("minCountedCall"), reported: talk, endsAt: past + talk });
    87	  let a;
    88	  if (st === "calling") a = { at: now, done: false };
    89	  else if (st === "still-on-call") a = { at: now - v("noResultTimeout"), polled: true, done: false };
    90	  else if (st === "result-wait" || st === "result-missing" || (st === "closed" && fx.outcome === "submitted")) a = { at: past, polled: true, done: false };
    91	  else if (st === "not-through" || st === "doctor-missed") a = { at: past, polled: true, done: true };
    92	  else if (st === "ended-early") a = done(Math.round(gate / 2));
    93	  else a = done(gate + 1000);
    94	  c.call = { attempts: [a], askAt: a.at + v("noResultTimeout"), checkAt: st === "result-wait" ? now + v("mockServerDelay") : null,
    95	    fx: fx.fxCall || null, fxEdits: store.get().callEdits || 0 };
    96	  if (fx.outcome === "submitted") c.call.submit = { at: now, done: false };
    97	}
    98	
    99	function applyFixture(fx, d, mode) {
   100	  const st = store.get();
   101	  const v = (k) => value(k, mode);
   102	  const scenario = (d && d.scenario) || (mode === "capture" && fx.scenario) || (fx.kind || d ? "cat4" : st.scenario || "cat4");
   103	  // A case only arrives while the doctor is available: a fixture keeps the session's availability, or starts 30 min [MOCK ASSUMPTION].
   104	  if (!work().avail || availability().state === "none") saveWork({ avail: fx.availEnded ? null : { endsAt: clock.now() + 30 * MIN }, ended: fx.availEnded ? "idle" : null, stopping: false });
   105	  if (fx.availEnded) saveWork({ avail: null, ended: "idle" });
   106	  if (work().rxToday === 0) saveWork({ rxToday: 3 });
   107	  const kind = fx.kind || (!d && (st.story || {}).caseKind) || "normal";
   108	  const c = openCase(scenario, kind === "rx-failed" || kind === "release-refused" ? "normal" : kind);
   109	  c.fxKind = kind;
   110	  if (fx.disable) Object.assign(c.medicines[fx.disable - 1], { status: "disabled", disableReason: MSG("prescribe.reasonDeclined") });
   111	  if (fx.allRx) c.medicines.forEach((m) => { m.status = "prescribed"; });
   112	  if (fx.noDetails) { c.created = ""; c.delivery = ""; c.payment = ""; }
   113	  if (fx.symptoms) c.notes.symptoms = fx.symptoms;
   114	  if (d && d.medPatch) Object.assign(c.medicines.find((m) => m.id === d.med), d.medPatch, d.medPatch.disableReason ? { disableReason: MSG(d.medPatch.disableReason) } : {});
   115	  c.stage = fx.stage || "ready";
   116	  if (c.stage === "closed") c.outcome = fx.outcome || "confirmed";
   117	  if (c.outcome === "callback") c.callback = { ...CB15 };
   118	  if (c.outcome === "unavailable") c.unavailable = { by: "auto", cause: "no-answer" };
   119	  c.attempted = !["ready", "not-through", "doctor-missed"].includes(c.stage);   // 3 / 4 pictures: the patient was never reached (Back shows)
   120	  fixtureCall(c, fx, clock.now(), v);
   121	  saveWork();
   122	  return c;
   123	}
