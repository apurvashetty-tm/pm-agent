     1	#!/usr/bin/env node
     2	// Approved reference for the case page and Prescribe (ui-screens/case/case.html): the built app's own DOM for every state (capture
     3	// mode), drawn with the app's own CSS, so the reference and the app can't drift (same principle as ui-screens/home since r2-build).
     4	// Generated: run after any change to the case page, Prescribe, their sheets or the Rx viewer.
     5	//   node scripts/build-case-reference.mjs           (CHROME=... if Playwright's own Chromium isn't installed)
     6	//   node scripts/build-case-reference.mjs --check   exits 1 if the committed reference is out of date
     7	import { chromium } from "../tests/node_modules/playwright/index.mjs";
     8	import http from "node:http"; import fs from "node:fs"; import path from "node:path"; import url from "node:url";
     9	const P = path.resolve(path.dirname(url.fileURLToPath(import.meta.url)), "..");
    10	const APP = path.join(P, "app"), OUT = path.join(P, "ui-screens/case/case.html");
    11	const T = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml", ".woff2": "font/woff2", ".json": "application/json", ".png": "image/png" };
    12	const srv = http.createServer((q, r) => {
    13	  const p = path.join(APP, decodeURIComponent(new URL(q.url, "http://x").pathname).replace(/\/$/, "/index.html"));
    14	  if (!p.startsWith(APP) || !fs.existsSync(p) || fs.statSync(p).isDirectory()) { r.writeHead(404); r.end(); return; }
    15	  r.writeHead(200, { "Content-Type": T[path.extname(p)] || "application/octet-stream" }); fs.createReadStream(p).pipe(r);
    16	});
    17	await new Promise((r) => srv.listen(0, "127.0.0.1", r));
    18	globalThis.window = {};
    19	await import(url.pathToFileURL(path.join(APP, "state-map.js")).href);
    20	const ids = window.TM_STATE_MAP.pictures.map((r) => r.id).filter((id) => !/^(sign-in|otp|offer|unlock|home)_/.test(id));
    21	const b = await chromium.launch({ executablePath: process.env.CHROME || undefined });
    22	const states = {};
    23	const VERSION_A = ["t08b-valid-forward", "t11-calling-transfer", "t12-transfer-ready"];   // later release, not built in the app: composed below from built states
    24	const SIZES = [[390, 844], [360, 640], [360, 844]];
    25	for (const id of ids.filter((i) => !VERSION_A.includes(i))) {
    26	  const page = await b.newPage({ viewport: { width: 390, height: 844 } });
    27	  await page.clock.setFixedTime(new Date("2026-10-28T15:00:00"));
    28	  await page.goto(`http://127.0.0.1:${srv.address().port}/?capture=1&s=${id}`); await page.evaluate(() => document.fonts.ready); await page.waitForTimeout(600);
    29	  states[id] = await page.evaluate(() => {
    30	    const s = document.querySelector("#screen");
    31	    const scroll = [...s.querySelectorAll("*")].filter((e) => e.scrollTop > 0 && e.id).map((e) => [e.id, Math.round(e.scrollTop)]);
    32	    const focus = s.contains(document.activeElement) && document.activeElement.id || null;
    33	    s.querySelectorAll("textarea").forEach((t) => { t.textContent = t.value; });
    34	    s.querySelectorAll("input").forEach((i) => { if (i.type === "checkbox") i.toggleAttribute("checked", i.checked); else i.setAttribute("value", i.value); });
    35	    return { html: s.innerHTML.replace(/\b(sh|opt)-[a-z0-9]+(-[td])?\b(?=")/g, (m) => m), scroll, focus };
    36	  });
    37	  // random ids of one draw → stable ids, so a rebuild without a change writes the same file
    38	  const seen = new Map();
    39	  states[id].html = states[id].html.replace(/\bsh-[a-z0-9]{3,6}\b/g, (m) => { if (!seen.has(m)) seen.set(m, `sh-${seen.size + 1}`); return seen.get(m); });
    40	  // the scroll position follows the size (a picture moment scrolls to a part of the screen)
    41	  if (states[id].scroll.length || /^(d-|a-scrolled|a-notes)/.test(id)) {
    42	    states[id].scroll = {};
    43	    for (const [w, h] of SIZES) {
    44	      const pg = await b.newPage({ viewport: { width: w, height: h } });
    45	      await pg.clock.setFixedTime(new Date("2026-10-28T15:00:00"));
    46	      await pg.goto(`http://127.0.0.1:${srv.address().port}/?capture=1&s=${id}&w=${w}`); await pg.evaluate(() => document.fonts.ready); await pg.waitForTimeout(600);
    47	      states[id].scroll[`${w}x${h}`] = await pg.evaluate(() => [...document.querySelectorAll("#screen *")].filter((e) => e.scrollTop > 0 && e.id).map((e) => [e.id, Math.round(e.scrollTop)]));
    48	      await pg.close();
    49	    }
    50	  } else states[id].scroll = {};
    51	  await page.close();
    52	}
    53	// Version A (a later release): the same parts as the built states, with that version's words and buttons.
    54	{
    55	  const M = JSON.parse(fs.readFileSync(path.join(P, "ui-screens/feedback/messages.json"), "utf8"));
    56	  const page = await b.newPage();
    57	  const made = await page.evaluate(({ g0, g1, cream, t10b, M }) => {
    58	    const dom = (html) => { const d = document.createElement("div"); d.innerHTML = html; return d; };
    59	    const script = (d) => { d.querySelector("#pcb-text").textContent = M["SCRIPT_A"]; };
    60	    const t11 = dom(g0); script(t11);
    61	    const t12 = dom(g1); script(t12); t12.querySelector("#main-cta-btn").textContent = "Confirm & transfer";
    62	    const t08b = dom(cream); t08b.querySelector("#prescribe-screen").remove();
    63	    t08b.querySelector("#case-head").replaceWith(dom(t10b).querySelector("#case-head"));
    64	    t08b.querySelector("#case-actionbar").replaceWith(dom(g1).querySelector("#case-actionbar"));
    65	    t08b.querySelector("#main-cta-btn").textContent = M["case.confirmForward"];
    66	    t08b.querySelectorAll(".medicine-item .tm-tag").forEach((t) => { t.className = t.className.replace(/tm-tag--(warning|neutral)/, "tm-tag--success"); t.textContent = M["case.statusPrescribed"]; });
    67	    return { "t08b-valid-forward": t08b.innerHTML, "t11-calling-transfer": t11.innerHTML, "t12-transfer-ready": t12.innerHTML };
    68	  }, { g0: states["g0-calling-pilot"].html, g1: states["g1-generic-confirm"].html, cream: states["d-cream"].html, t10b: states["t10b-forwarded"].html,
    69	    M: { ...M, SCRIPT_A: Object.values(M).find((v) => /stay on the line/.test(v)) } });
    70	  for (const [k, html] of Object.entries(made)) states[k] = { html, scroll: {}, focus: null };
    71	  for (const id of ids) { const v = states[id]; delete states[id]; states[id] = v; }   // the state map's order
    72	}
    73	await b.close(); srv.close();
    74	const CSS = ["../../../../design-system/truemeds.css", "../../app/shell/shell.css", "../../app/shell/mock-keyboard.css", "../../app/screens/case.css", "../../app/screens/prescribe.css", "../../app/screens/task-gaps.css", "../../app/screens/rx-paper.css"];
    75	const out = `<!doctype html>
    76	<!-- Generated by scripts/build-case-reference.mjs from the built app. Do not edit. -->
    77	<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Case page and Prescribe — approved reference</title>
    78	${CSS.map((c) => `<link rel="stylesheet" href="${c}">`).join("\n")}
    79	<style>.review{position:fixed;right:8px;bottom:8px;z-index:9999}</style></head>
    80	<body class="tm picture-only" data-mode="capture">
    81	<div id="stage"><section id="frame" class="shell-frame"><main id="main-scroll-frame" class="shell-main"><div id="mobile-column" class="shell-screen"></div></main></section></div>
    82	<div class="review"><select id="state" aria-label="Reference state"></select></div>
    83	<script src="../../../../design-system/src/sheet-scroll.js"></script>
    84	<script>
    85	const STATES = {
    86	${Object.entries(states).map(([k, v]) => `'${k}': ${JSON.stringify(v).replace(/<\/script/g, "<\\/script")}`).join(",\n")}
    87	};
    88	const q = new URLSearchParams(location.search), sel = document.getElementById('state'), host = document.getElementById('mobile-column');
    89	sel.innerHTML = Object.keys(STATES).map((k) => '<option>' + k + '</option>').join('');
    90	if (q.has('capture')) document.querySelector('.review').hidden = true;
    91	function show(id) { const s = STATES[id] || STATES['t01-ready']; host.innerHTML = s.html;
    92	  const at = () => (s.scroll[innerWidth + 'x' + innerHeight] || s.scroll[(innerWidth < 380 ? '360x640' : '390x844')] || []).forEach(([i, t]) => { const e = document.getElementById(i); if (e) e.scrollTop = t; });
    93	  at(); document.fonts.ready.then(at);
    94	  const f = s.focus && document.getElementById(s.focus); if (f) f.focus({ preventScroll: true }); }
    95	sel.value = STATES[q.get('s')] ? q.get('s') : 't01-ready'; sel.onchange = () => show(sel.value); show(sel.value); document.body.dataset.ready = '1';
