     1	// Schedule callback sheet (app-logic §7; pictures c-callback, c-callback-error, c-callback-failed, c-callback-refused). Markup
     2	// and classes lifted from ui-screens/case/case.html #sheet-callback. Offered only on 6 Call too short and 7d Result not received
     3	// (CW-A1, CW-C3). Date Today · Tomorrow, time from the backend's slots; a missing choice is a field error under the grid; a save
     4	// failure or the backend's refusal is a notice in the sheet with the choices kept. State lives in the case page (cb).
     5	import { MSG } from "../core/msg.js";
     6	import { h } from "../core/dom.js";
     7	import { btn, busyBtn, notice, sheet } from "./parts.js";
     8	import { CALLBACK_SLOTS } from "../data/callback-slots.js";
     9	
    10	// cb: { day, time, error (message key), notice (message key), busy }
    11	export function callbackSheet(cb, { onDay, onTime, onConfirm, onClose }) {
    12	  const chip = (label, pressed, onclick, attrs) => h("button", { type: "button", class: "tm-chip tm-chip--lg", "aria-pressed": String(pressed), onclick, disabled: cb.busy, ...attrs }, label);
    13	  const body = [
    14	    h("div", { class: "tm-sheet__label sheet-section-label", text: MSG("callback.date") }),
    15	    h("div", { class: "tm-chip-group", id: "callback-day-chips", role: "group", "aria-label": MSG("callback.date") },
    16	      chip(MSG("callback.today"), cb.day === "today", () => onDay("today"), { "data-day": "today" }),
    17	      chip(MSG("callback.tomorrow"), cb.day === "tomorrow", () => onDay("tomorrow"), { "data-day": "tomorrow" })),
    18	    h("div", { class: "tm-sheet__label sheet-section-label", text: MSG("callback.time") }),
    19	    h("div", { class: "tm-chip-grid tm-chip-grid--3", id: "callback-time-chips", role: "group", "aria-label": MSG("callback.time") },
    20	      CALLBACK_SLOTS.map(([v, label]) => chip(label, cb.time === v, () => onTime(v), { "data-time": v }))),
    21	    // the field-error slot is always there, 8 under the Time grid (D-54 D11); the helper shows only with an error
    22	    h("div", { class: "tm-field tm-field--error", id: "callback-error-wrap" },
    23	      h("div", { id: "callback-error", class: "tm-field__helper callback-error", role: "alert", hidden: !cb.error, text: cb.error ? MSG(cb.error) : "" })),
    24	  ];
    25	  const confirm = cb.busy ? busyBtn(MSG("callback.scheduling"), "tm-btn--primary tm-btn--lg tm-btn--block")
    26	    : btn(MSG("callback.confirm"), "tm-btn--primary tm-btn--lg tm-btn--block", onConfirm, { id: "callback-confirm" });
    27	  return sheet({ title: MSG("callback.title"), body, onClose, closeDisabled: cb.busy, id: "sheet-callback",
    28	    actions: [cb.notice ? h("div", { class: "callback-notice" }, notice("error", MSG(cb.notice))) : null, confirm].filter(Boolean) });   // the result notice is pinned with the button, 16 above it (D-111, RULES §9.4)
    29	}
