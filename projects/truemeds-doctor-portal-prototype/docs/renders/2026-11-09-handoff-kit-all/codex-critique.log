        let styles = [], ax = null;
        if (t.block !== "system-keyboard") {
          const { nodeId } = await cdp.send("DOM.querySelector", { nodeId: root.nodeId, selector: `[data-kit="${CSS_ESC(t.id)}"]` });
          if (!nodeId) die(`${st.id}: lost ${t.id}`);
