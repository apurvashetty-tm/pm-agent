      await pg.screenshot({ path: path.join(outDir, `viewer/shots/built-390_${st.id}.png`) });
      result[j.key][st.id] = { built: true, elements };
      await pg.close();
      log?.(`    ${st.id}: ${elements.length} elements, ${Date.now() - t0} ms`);
