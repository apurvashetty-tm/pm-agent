    return t.replace(/\*\*/g, "").split(/[.:(—]/)[0].split(" ").slice(0, 9).join(" ").trim();
  };
  const ruleLines = (sec, from, to) => {
    let lines = section("appLogic", sec).split("\n").slice(1);
    if (from) { const i = lines.findIndex((l) => from.test(l.trim())); if (i < 0) die(`app-logic ${sec}: no ${from}`); lines = lines.slice(i); }
    if (to) { const i = lines.findIndex((l, k) => k > 0 && to.test(l.trim())); if (i > 0) lines = lines.slice(0, i); }
    // join wrapped lines; keep bullets, table rows, paragraphs
    const out = [];
    for (const l of lines) {
      const t = l.trim();
      if (!t || /^---$/.test(t) || /^\|[-| ]+\|$/.test(t) || /^#/.test(t)) continue;
      if (/^\| #? ?\|/.test(t) || /^\| (?:Stage|Case type|Form|Scenario|Enter|#) \|/.test(t)) continue;   // table headers
      if (/^\*\*[^*]+\*\*$/.test(t)) continue;   // a bold sub-heading on its own
      out.push(t);
    }
    return out;
  };
  let n = {};
  const add = (j, it) => { n[j.key] = (n[j.key] || 0) + 1; const id = `${ID[j.key]}${String(n[j.key]).padStart(2, "0")}`; items.push({ id, journey: j.name, ...it }); return id; };
  for (const j of JOURNEYS) {
    ruleIndex[j.key] = [];
    // app-logic rule lines
    for (const [sec, from, to] of j.appLogic) for (const raw of ruleLines(sec, from, to)) {
      quote("appLogic", raw);
      const text = cleanSafe(raw);
      if (!text || text.replace(/[^A-Za-z]/g, "").length < 12) continue;
      const refs = [...new Set(raw.match(/D-\d+/g) || [])];
      const isRow = raw.startsWith("|");
      const cells = isRow ? raw.split("|").map((x) => x.trim()).filter(Boolean) : null;
      const q = isRow ? `What happens in "${cells[1] && cells[1].length < 60 ? cells[1].replace(/\*\*|`/g, "") : cells[0].replace(/\*\*|`/g, "")}"${cells[0] && /^\d|^\d+[a-f]$/.test(cells[0]) ? ` (state ${cells[0]})` : ""}?` : `What is the rule for "${lead(text)}"?`;
      const id = add(j, { topic: "App rules", q, a: [{ src: `App logic ${sec.replace(/^## /, "§").split(" ")[0]}`, text }], refs, raw });
      ruleIndex[j.key].push({ id, raw });
    }
    // extra rule paragraphs from app-logic §13 the journey follows
    for (const [sec, re] of j.rules) {
      const l = ruleLines(sec, re, /^\*\*/)[0];
      quote("appLogic", l); const text = cleanSafe(l);
      if (text) { const id = add(j, { topic: "Layout", q: `What is the rule for "${lead(l)}"?`, a: [{ src: "App logic §13", text }], refs: [...new Set(l.match(/D-\d+/g) || [])], raw: l }); ruleIndex[j.key].push({ id, raw: l }); }
    }
    // feedback map rows
    for (const fsec of [].concat(j.fmap)) {
      for (const l of section("fmap", fsec).split("\n").filter((x) => /^\| [a-z]+\.[\w-]+ \|/.test(x))) {
        quote("fmap", l);
        const c = l.split("|").map((x) => x.trim()).filter(Boolean);
        const text = cleanSafe(`${c[0]}: ${c[1]} — ${c[2]}`);
        if (!text) continue;
        const id = add(j, { topic: "States and feedback", q: `What does the app show in ${c[0]}, and how does it recover?`, a: [{ src: `Feedback state map: ${c[0]}`, text }], refs: [...new Set(l.match(/D-\d+/g) || [])], raw: l, fmapKey: c[0] });
        ruleIndex[j.key].push({ id, raw: l, fmapKey: c[0] });
      }
    }
    // settings: rule or prototype stand-in
    for (const k of j.settings) {
      const s = setting(k);
      // the setting's note may name people or working files: keep only what survives cleaning, else its decision numbers
      s.ref = cleanSafe(`(${s.ref})`).replace(/^\(|\)$/g, "") || (s.ref.match(/D-\d+(?: F\d+)?|OQ-\d+/g) || []).join(", ");
      add(j, { topic: "Limits and timings", q: `What is the value of "${k}"?`, a: [{ src: s.mock ? "Prototype setting [MOCK]" : "Setting (agreed rule)", text: s.mock
        ? `[MOCK] ${human(s.value)} in the prototype. Keep configurable (a server or config value, never typed into a screen); not a production promise. Note: ${s.ref}.`
        : `${human(s.value)}. Agreed rule (${s.ref}). Read it from configuration; copy reads the value, never a typed number.` }], refs: [...new Set(s.ref.match(/D-\d+/g) || [])], mock: s.mock });
    }
  }
  // [MOCK ASSUMPTION] lines in each journey's code → DECIDED [MOCK] (D-101 amended: the kit is a prototype with a fake backend)
  for (const j of JOURNEYS) for (const f of j.code.filter((x) => x.endsWith(".js"))) {
    for (const l of read(path.join(ROOT, f)).split("\n").filter((x) => /MOCK ASSUMPTION|\[MOCK\]/.test(x))) {
      if (/settings|review tool|^import/.test(l) && !/ONGOING|Callback times|backend sends/.test(l)) continue;
      quote("code", l);
      const c = l.replace(/^\s*(?:\/\/|\*)\s*/, "").replace(/^.*?\/\/\s*/, "").replace(/\[MOCK ASSUMPTION[^\]]*\]|\[MOCK\]/g, "").trim();
      const text = cleanSafe(c);
      if (!text) continue;
      add(j, { topic: "Prototype stand-ins", q: `The prototype fakes this: "${lead(text)}". What do we build?`, a: [{ src: "Prototype [MOCK]", text: `[MOCK] ${text} Keep configurable; the real value or answer comes from the backend.` }], refs: [], mock: true });
    }
  }
  // Backend routing facts the kit must never invent (CLAUDE "never silently invent"): stated as the prototype's mock
  const caseJ = JOURNEYS.find((j) => j.key === "case");
  add(caseJ, { topic: "Prototype stand-ins", q: "What decides Cat4 vs Pilot, value vs non-value medicines, HA required and HA-skip eligibility?",
    a: [{ src: "App logic §6", text: cleanSafe(doc("appLogic").split("\n").find((l) => /^- What decides case type/.test(l))) }, { src: "Prototype [MOCK]", text: "[MOCK] The prototype reads them as fields on the sample case (case type, HA status). Keep them as backend fields; the app never works them out." }], refs: ["D-50"], mock: true });
  // Genuinely undecided Product questions stay OPEN (D-101 amended)
  const OQ = (q, re) => { const t = cleanSafe(section("oqs", `### ${q}`).split("\n").find((l) => re.test(l)) || ""); if (!t) die(`open_questions ${q}: no ${re}`); quote("oqs", t); return t; };
  open.push({ id: "o27", journey: "Home", topic: "No cases", q: "After \"No cases right now\", does the app check again by itself, and how often?", now: { src: "OQ-019", text: OQ("OQ-019", /^\*\*Safe placeholder:\*\*/) }, who: "Product", refs: ["OQ-019"], noteNow: "Prototype: no automatic re-check; the doctor taps Request a case again." });
  open.push({ id: "o28", journey: "Faster sign-in offer", topic: "Re-offer", q: "After Not now, when is faster sign-in offered again?", now: { src: "OQ-023", text: OQ("OQ-023", /^\*\*Safe placeholder:\*\*/) }, who: "Product", refs: ["OQ-023"], noteNow: "Prototype: offered once; it can be turned on in Profile (D-69)." });
  return { items, open, ruleIndex };
}
const ID = { otp: "otp-", "faster-signin-offer": "offer-", "returning-unlock": "unlock-", home: "home-", case: "case-", prescribe: "rx-" };

// State → its rule: the feedback-map row of its behaviour, the app-logic state-table row naming its render id, else the journey's first rule
export function stateRuleFn({ docs, doc, cleanSafe, quote }) {
  const table = doc("appLogic").split("\n").filter((l) => /^\| /.test(l));
  return (j, st) => {
    const idx = docs.ruleIndex[j.key];
    const fm = st.behaviour ? idx.find((r) => r.fmapKey === st.behaviour) : null;
    const row = table.find((l) => new RegExp("`" + st.id.replace(/[-]/g, "\\-") + "`").test(l));
    const named = idx.filter((r) => r.raw.includes(st.id) || (fm && r === fm));
    const decided = [...new Set([...(fm ? [fm.id] : []), ...named.map((r) => r.id), ...(row ? idx.filter((r) => r.raw === row).map((r) => r.id) : [])])];
    let name = st.id;
    if (row) { quote("appLogic", row); const c = row.split("|").map((x) => x.trim()).filter(Boolean); if (c[2] && !/`/.test(c[2])) name = `${c[0]} ${c[2]}`.replace(/\*\*/g, ""); }
    return { name, feedbackMap: fm ? `feedback-state-map: ${st.behaviour}` : null, pattern: fm ? docs.items.find((i) => i.id === fm.id).a[0].text : null,
      appLogic: row ? `App logic state table: ${cleanSafe(row)}` : `App logic: see the ${j.name} rules in DECIDED.md`, decided: decided.length ? decided : idx.slice(0, 3).map((r) => r.id) };
  };
}
export function elementDecidedFn({ docs }) {
  return (j, e, keys) => {
    const idx = docs.ruleIndex[j.key];
    const words = keys.map((k) => k.split(".").pop()).filter((w) => w.length > 3);
    return idx.filter((r) => keys.some((k) => r.raw.includes(k)) || (e.text && e.text.length > 6 && r.raw.includes(e.text))).slice(0, 4).map((r) => r.id)
      .concat(words.length ? [] : []);
  };
}
# Doctor Portal — app logic

**Status:** APPROVED and frozen — Apurva, 2026-10-31 (D-78). Covers decisions up to D-83 (calling walkthrough, applied 2026-11-03 by the calling round; CW-A1 … CW-F3, see §14). Round 4 of the fix round (2026-11-02, §13) is not yet approved. Changes from here are either a bug (fix where it occurs) or a next-version idea (backlog). Open backend dependencies stay marked `[OPEN]` with their question.
**What this is:** every rule the app follows, taken out of the old prototype (`index.html` + `app.js`) and checked against the locked rules (`docs/context/project_truth.md`) and the decision log (D-01 to D-55). It is the logic half of the rebuild spec; the look is in `ui-screens/` (pictures) and `design-system/RULES.md`.
**How to read it:** `[LOCKED]` = decided, build exactly this · `[MOCK]` = prototype placeholder, the real value comes from the backend · `[OPEN]` = not decided, see the linked question · **⚠ Flag** = the old code and the decisions disagree, or a rule was never written down — needs Apurva before the rebuild.

All on-screen text comes from `ui-screens/feedback/messages.json`. Error, offline and busy states for every screen: `docs/feedback-state-map.md`.

---

## 1. The app in one line per screen

| Screen | Job | Pictures |
|---|---|---|
| Sign-in | Enter a mobile number, get an OTP | `ui-screens/sign-in/` |
| OTP | Enter the 4-digit code | `ui-screens/otp/` |
| Faster sign-in offer | Turn on fingerprint / Face ID after the first OTP sign-in | `ui-screens/faster-signin-offer/` |
| Returning unlock | Open the app with fingerprint / Face ID | `ui-screens/returning-unlock/` |
| Home | Set availability, request a case, see time left | `ui-screens/home/` |
| Case page | Review, call, prescribe, close the case | `ui-screens/case/` |
| Prescribe | Edit one medicine | `ui-screens/case/` (`d-*`) |
| Rx viewer | Read the customer's prescription | `ui-screens/case/` (`a-rx-viewer`, `d-rx-failed`) |

Order on first use: Sign-in → OTP → (offer, once) → Home → Case. Returning doctor with faster sign-in on: Unlock → Home. A doctor with a case open goes straight back into the case (D-48).

---

## 2. Sign-in and OTP `[LOCKED]` (D-33, D-34, D-35, D-39, D-44, D-46)

**Mobile number**
- Typing and pasting are cleaned: "+91 98765-43210", "098765 43210" → `9876543210`. A leading 0 or 91 is dropped. More than 10 digits left after that is **not cut** (D-101 o04).
- Checks, most basic first: empty → "Enter your mobile number." · more than 10 digits → "That’s more than 10 digits. Check the number." (shown as soon as it's typed, whatever the first digit; same place and style as the other field errors, D-101 o04) · first digit not 6/7/8/9 → "Mobile numbers start with 6, 7, 8 or 9." (shown as soon as it's typed) · fewer than 10 digits → "Enter all 10 digits." (shown on Send OTP). Once an error shows, it re-checks on every keystroke.
- Back from OTP (**Change** or the phone's back) keeps the number, and it edits normally: the first typed digit does **not** replace it (D-101 o10).
- The sign-up line "New to Truemeds? Sign up" is one copy entry with a `{link}` placeholder; "Sign up" is the link (D-101 o25). On OTP, Terms and Privacy open the D-101 pages, each from one config value (o11).
- After sending, server results show as a notice: not registered (with the sign-up route), offline, couldn't send, too many attempts (button counts down "Try again in m:ss"), account inactive (button becomes **Call Doctor Ops**).
- When the "Try again in m:ss" countdown ends, the "Too many attempts" notice goes away and **Send OTP** works again (D-98).

**OTP**
- 4 digits, keyboard opens on load and stays open while verifying. No auto-verify: the doctor taps **Verify & sign in**.
- The terms line stays during **Verifying…** and **Checking…**, so Verify & sign in never moves (D-81 F5, amends D-44 for those two states). The cooldown line reads "Checking…" alone, with no "Didn’t receive it?", and the boxes stay focused (D-81 F7).
- **Verify never moves (Round 5 B, Round 6 item 3):** one line is reserved under the code boxes. Every state with a one-line message (wrong code, tries left, new code sent, code expired, empty or too short, resend, cooldown) shows its message there, or nothing; Verify & sign in keeps the same place. Notice-box states (offline, locked, couldn't verify, resend failed, too many codes) may move it; accepted.
- Waiting text ("Resend in 0:30") and the Resend code link share one height, so Verify & sign in never moves when the link appears (A-03). The terms line is centred and "Terms & Conditions" never splits (A-01, A-02). "Doctor Ops" and the timer never split across lines (A-17). "New code sent." is green text with no icon, like the errors (A-21).
- Wrong code: digits stay visible with red borders; the first new keystroke replaces the whole code. The message is "Wrong code."; from 2 tries left it counts ("Wrong code. 2 tries left."), and at 1 try left it uses the singular ("Wrong code. 1 try left.") (D-81 F1; no next-step wording, D-53 pt 2).
- **5** server-confirmed wrong codes lock **that mobile number** (not the account) `[LOCKED D-34]`. Lock length `[MOCK 15 min, OPEN OQ-017]`. Change number stays available; another number works only if Doctor Ops approved it for this doctor.
- **4** codes per number per limit window (first code + 3 resends), not reset by restarting sign-in `[LOCKED D-35]`. Window length `[MOCK 10 min, OPEN OQ-017]`.
- Resend waits `[MOCK]` 30 s, then 60 s, then 120 s. Resend line hidden when resends are used up or the number is locked.
- Expired code: Resend is available at once; the expired code can't be verified.
- **Sign-in on a locked number** goes straight to OTP in the locked state (`otp_locked`): code field and Verify off, the lock time and "call Doctor Ops" shown, Change still available (D-81 F6).
- All OTP limits are enforced by the server; the app only shows them.

**Faster sign-in** (D-45, D-47)
- Offered once, on its own screen, after the first successful OTP sign-in on a phone that supports it and has it off. The footer is the action bar (Round 4, item 1); the content above it scrolls. Subtitle on one line: "Use your screen lock instead of an OTP." (A-06). **Turn on** → phone prompt → Home. **Cancelled** prompt → back to the offer, no message. **Failed** → stays on the offer; "Couldn't turn on faster sign-in." sits in the bar above Try again (A-19) · Try again · Not now (D-61, D-65). **Offline** → "You're offline. Check your connection." (D-66). **Unavailable** (the phone answers "unavailable" at Turn on) → stays on the offer, unchanged (title, subtitle, tile and the three points): the amber warning notice "Faster sign-in isn't available on this phone right now." sits in the bar (same slot as Offline and "Couldn't turn on", A-19), the primary reads **Continue** → Home and Not now is hidden; not enabled, recorded as offered, can be turned on later in Profile (D-93, state `offer_unavailable`). **Not now** → Home; offered again later `[OPEN OQ-023]`; can be turned on or off in Profile (D-69).
- **Which unlock (D-64):** fingerprint or face if set up on the phone; otherwise the phone's **screen lock** (PIN / pattern / password); if the phone has no screen lock at all, the offer is skipped.
- Returning unlock: the phone's own prompt; 3 failed tries → fall back to OTP `[MOCK]`. "Not you? Switch account" → sign-in. The footer is the action bar (Round 4, item 1); the content above it scrolls. If unavailable: "Faster sign-in isn't available on this phone right now." is a standing state, so the neutral notice stays at the top of the panel; **Use OTP instead** is the main button in the bar (A-19).
- Wording follows the phone ("Face ID" / "fingerprint"); never suggest Truemeds stores biometric data.

