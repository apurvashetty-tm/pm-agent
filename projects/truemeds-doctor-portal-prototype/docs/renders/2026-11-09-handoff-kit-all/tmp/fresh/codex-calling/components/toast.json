 "rules": [
  {
   "section": "Design rules",
   "text": "**Toast** — **Dark** (inverse surface — the platform standard), **14/20**, 12px × 16px padding, medium radius, one line (two at most), width up to the screen minus margins. Just above the bottom bar, **one at a time**, about 4 seconds, polite screen-reader announcement, never takes focus. **Only when the result has no place on the screen**; otherwise show it where it happens."
  },
  {
   "section": "Kit",
   "text": "Build it once from the parts × states below (tokens only, copy from messages); it appears on Home, Case page. What it does in each state is in DECIDED.md under those screens."
  }
