// Hand-off kit: the viewer's screen tabs and, for every approved state, its plain name and the "When this shows" lines
// (what causes it · what happens next), in plain words, written from ui-screens/app-logic.md and docs/feedback-state-map.md.
// Configuration, not facts: the facts (elements, tokens, copy, answers) are generated. A state missing here fails the build.
import fs from "node:fs";
import path from "node:path";
import vm from "node:vm";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const ctx = { window: {} };
vm.runInNewContext(fs.readFileSync(path.join(ROOT, "app/state-map.js"), "utf8"), ctx);
// Calling = the case-folder states the state map ties to a calling stage; Case = the rest of the case folder.
const CALLING = new Set(ctx.window.TM_STATE_MAP.pictures.filter((p) => p.picture.startsWith("case/") && (p.calling || []).length).map((p) => p.id));

export const TABS = [
  { screen: "sign-in", tab: "sign-in", name: "Sign-in" },
  { screen: "otp", tab: "otp", name: "OTP" },
  { screen: "faster-signin-offer", tab: "offer", name: "Faster sign-in offer" },
  { screen: "returning-unlock", tab: "unlock", name: "Returning unlock" },
  { screen: "home", tab: "home", name: "Home" },
  { screen: "case", tab: "case", name: "Case", filter: (id) => !CALLING.has(id) },
  { screen: "prescribe", tab: "prescribe", name: "Prescribe" },
  { screen: "case", tab: "calling", name: "Calling", filter: (id) => CALLING.has(id) },
];

const W = (name, shows, next) => ({ name, shows, next });
export const WHEN = {
  // Sign-in
  "sign-in_default": W("Default", "The first screen when a doctor who isn't signed in opens the app.", "They type a 10-digit mobile number and tap Send OTP; the code is sent and OTP opens."),
  "sign-in_keyboard-open": W("Keyboard open", "The doctor has tapped the number field and is typing.", "No error yet for a number that's still short. A wrong first digit or more than 10 digits shows at once; anything else is checked on Send OTP."),
  "sign-in_empty-tap": W("Empty tap", "Send OTP was tapped with the field empty.", "“Enter your mobile number.” shows under the field and the field gets focus. It clears as they type."),
  "sign-in_too-short": W("Too short", "Send OTP was tapped with fewer than 10 digits.", "The digits stay; “Enter all 10 digits.” shows until the number is complete."),
  "sign-in_wrong-first-digit": W("Wrong first digit", "The first digit typed isn't 6, 7, 8 or 9 (shown as soon as it's typed).", "“Mobile numbers start with 6, 7, 8 or 9.” clears as soon as the digit is corrected."),
  "sign-in_pasted-cleaned": W("Pasted, cleaned", "A number was pasted or autofilled with +91 or a leading 0.", "The prefix is removed and the 10 digits are kept. No message."),
  "sign-in_sending": W("Sending OTP", "Send OTP was tapped with a valid number; the app is waiting for the server.", "The button reads “Sending OTP…” and can't be tapped twice. When the code is sent, OTP opens."),
  "sign-in_not-registered": W("Not registered", "The server says this number has no doctor account.", "A notice explains; the doctor can edit the number or use Sign up below."),
  "sign-in_offline": W("Offline", "Send OTP was tapped with no internet connection.", "One notice; the number stays. Tapping Send OTP again tries again."),
  "sign-in_couldnt-send": W("Couldn’t send", "The server couldn't send the code.", "The number stays; tapping Send OTP tries again."),
  "sign-in_too-many-tries": W("Too many tries", "Too many codes were asked for on this number.", "The button counts down “Try again in m:ss”; when it ends, the notice goes and Send OTP works again."),
  "sign-in_inactive": W("Inactive account", "The server says this doctor's account is inactive.", "The button becomes Call Doctor Ops."),

  // OTP
  otp_default: W("Default", "The code was sent; OTP opens with the keyboard up and the first box focused. The resend wait is counting down.", "The doctor types the 4-digit code and taps Verify & sign in (no auto-verify)."),
  "otp_empty-tap": W("Empty tap", "Verify & sign in was tapped with no code typed.", "A one-line message shows under the boxes and the first box gets focus; it clears as they type."),
  "otp_too-short": W("Too short", "Verify & sign in was tapped with 1 to 3 digits.", "The digits stay; a one-line message asks for all 4 digits until the code is complete."),
  otp_verifying: W("Verifying", "Verify & sign in was tapped with 4 digits; the app is waiting for the server.", "The button reads “Verifying…” and can't be tapped twice; the code and keyboard stay. On success the app signs in."),
  "otp_wrong-code": W("Wrong code", "The server says the code is wrong.", "The digits stay with red borders and “Wrong code.” shows; the first new keystroke replaces the whole code."),
  "otp_two-tries-left": W("Two tries left", "A wrong code, with only a few tries left before the number locks.", "Same as wrong code, with the count: “Wrong code. 2 tries left.” (singular at 1). The 5th wrong code locks the number."),
  "otp_resend-available": W("Resend available", "The resend wait has ended.", "The Resend code link replaces the waiting text in the same spot; tapping it sends a new code."),
  otp_resending: W("Resending", "Resend code was tapped; the app is waiting for the server.", "One resend at a time; the current code stays usable until the answer arrives."),
  "otp_new-code-sent": W("New code sent", "A new code was sent after Resend code.", "“New code sent.” shows in green under the boxes and the resend wait starts again (longer each time)."),
  "otp_code-expired": W("Code expired", "The server says the code has expired.", "The code stays visible but can't be verified; Resend code is available at once."),
  "otp_couldnt-verify": W("Couldn’t verify", "The server couldn't check the code (a service error).", "A notice explains; the code stays and the resend line shows. Tapping Verify & sign in tries again."),
  "otp_resend-failed": W("Resend failed", "Resend code was tapped but the new code couldn't be sent.", "A notice explains; the current code stays and no “new code sent” is claimed. Resend can be tried again if allowed."),
  otp_offline: W("Offline", "Verify or Resend was tapped with no internet connection.", "One offline notice; the code stays and is not marked wrong. Trying again once online works."),
  "otp_too-many-resends": W("Too many resends", "All codes allowed for this number in the limit window have been sent.", "The resend line is hidden; the last code that hasn't expired can still be verified. The notice says when to try again or to call Doctor Ops."),
  otp_locked: W("Number locked", "Five wrong codes locked this mobile number (also shown when signing in on a locked number).", "Keyboard closed; boxes and Verify are off; the lock time and “call Doctor Ops” show. Change still works."),
  "otp_cooldown-reconciling": W("Checking after the wait", "The wait timer reached zero; the app is asking the server whether a new code may be sent.", "The line reads “Checking…” alone and Verify & sign in stays where it is; the resend link returns once the server agrees."),
  "otp_expired-and-resend-limited": W("Expired, resends used up", "The code has expired and no more codes may be sent yet.", "Boxes empty and off, keyboard closed, Verify off; the notice gives the time a new code can be asked for, or to call Doctor Ops."),

  // Faster sign-in offer
  "offer_fingerprint": W("Fingerprint", "First OTP sign-in on a phone with fingerprint set up and faster sign-in off.", "Turn on opens the phone's prompt, then Home. Not now goes to Home; it can be turned on later in Profile."),
  "offer_face-id": W("Face ID", "First OTP sign-in on a phone with Face ID set up and faster sign-in off.", "Turn on opens the phone's prompt, then Home. Not now goes to Home."),
  "offer_screen-lock": W("Screen lock", "First OTP sign-in on a phone with no fingerprint or face set up, but a screen lock (PIN, pattern or password).", "The offer uses the screen lock; Turn on opens the phone's prompt, then Home. Not now goes to Home."),
  offer_enabling: W("Turning on", "Turn on was tapped; the phone's prompt is open.", "One request at a time; the button shows progress. Success goes to Home; a cancelled prompt comes back here with no message."),
  "offer_enable-failed": W("Couldn’t turn on", "The phone couldn't turn faster sign-in on.", "“Couldn't turn on faster sign-in.” sits in the action bar above Try again; Not now still goes to Home."),
  offer_offline: W("Offline", "Turn on was tapped with no internet connection.", "“You're offline. Check your connection.” sits in the action bar; Turn on works again once online."),
  offer_unavailable: W("Unavailable", "The phone answered “unavailable” when Turn on was tapped.", "The offer stays as it was with a warning in the bar; the button reads Continue and goes to Home. Not now is hidden; it can be turned on later in Profile."),

  // Returning unlock
  unlock_fingerprint: W("Fingerprint", "A returning doctor with faster sign-in on opens the app (fingerprint set up).", "The phone's own prompt unlocks the app and Home opens. “Not you? Switch account” goes to Sign-in."),
  unlock_face: W("Face ID", "A returning doctor with faster sign-in on opens the app (Face ID set up).", "The phone's own prompt unlocks the app and Home opens."),
  "unlock_screen-lock": W("Screen lock", "A returning doctor with faster sign-in on opens the app (screen lock only).", "The phone's screen-lock prompt unlocks the app and Home opens."),
  unlock_pending: W("Waiting for the phone", "The unlock button was tapped; the phone's prompt is open.", "No second request; success opens Home, cancelling comes back here unchanged."),
  unlock_cancelled: W("Cancelled", "The doctor cancelled the phone's prompt.", "The screen is unchanged, with no message: cancelling isn't a failure. They can try again or use OTP."),
