.panel{flex:1;min-height:0;display:flex;flex-direction:column;padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-xl);   /* D-81 F8: tile at the offer position. Round 4 A-05: panel top 32 as on the other screens */border-radius:var(--tm-radius-2xl) var(--tm-radius-2xl) 0 0;background:var(--tm-surface-primary)}
/* Round 4 lane D (item 1, 360×640): the panel scrolls above the pinned bar when the phone is short; the bar never covers its last line. */
.panel{overflow-y:auto}
