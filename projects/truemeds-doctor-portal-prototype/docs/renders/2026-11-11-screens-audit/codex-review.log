#doctor-login-preview .login-stage { padding:24px 0; display:flex; justify-content:center; }
#doctor-login-preview .login-phone { width:min(390px,100%); min-height:640px; aspect-ratio:9/16; box-sizing:border-box; background:var(--tm-surface-primary); border:1px solid var(--tm-border-subtle); border-radius:var(--tm-radius-2xl); box-shadow:var(--tm-shadow-header); padding:var(--tm-space-xl); color:var(--tm-content-primary); font-family:var(--tm-font); color-scheme:light; display:flex; flex-direction:column; }
#doctor-login-preview .login-logo { display:block; width:166px; height:auto; }
#doctor-login-preview h1 { font-family:var(--tm-font); color:var(--tm-content-primary); font-size:var(--tm-font-size-title-lg); line-height:var(--tm-font-lineheight-2xl); font-weight:var(--tm-font-weight-semibold); margin:0 0 var(--tm-space-sm); letter-spacing:normal; }
#doctor-login-preview p { color:var(--tm-content-secondary); font-size:var(--tm-font-size-body-lg); line-height:var(--tm-font-lineheight-md); margin:0; }
#doctor-login-preview .login-fields { margin-top:var(--tm-space-2xl); }
#doctor-login-preview .login-content > p { font-size:var(--tm-font-size-body-md); line-height:var(--tm-font-lineheight-sm); }
#doctor-login-preview .login-prefix { padding-right:var(--tm-space-md); border-right:1px solid var(--tm-border-default); font-size:var(--tm-font-size-body-lg); line-height:var(--tm-font-lineheight-md); color:var(--tm-content-primary); }
#doctor-login-preview .login-phone input { font-size:var(--tm-font-size-body-lg); line-height:var(--tm-font-lineheight-md); }
#doctor-login-preview .login-submit { margin-top:var(--tm-space-lg); }
#doctor-login-preview .tm-field__helper { margin-top:0; }
#doctor-login-preview .login-signup { margin-top:auto; padding-top:var(--tm-space-2xl); padding-bottom:var(--tm-space-sm); text-align:center; font-size:var(--tm-font-size-body-md); line-height:var(--tm-font-lineheight-sm); color:var(--tm-content-secondary); }
#doctor-login-preview .login-signup-label { color:var(--tm-content-brand); font-weight:var(--tm-font-weight-semibold); }   /* Round 4 A-16: a normal word space before the link, no extra margin */
#doctor-login-preview [hidden] { display:none!important; }
#doctor-login-preview input:focus-visible { outline:2px solid var(--tm-border-focus); outline-offset:var(--tm-space-xs); }
#doctor-login-preview .login-phone { min-height:844px; aspect-ratio:auto; padding:var(--tm-space-lg) var(--tm-space-page) 0; background:var(--tm-surface-brand-subtle); overflow:hidden; }   /* Round 4 A-07: logo top offset 16 on every screen with the logo */
#doctor-login-preview .login-logo { width:166px; }
/* LOCKED L6 (D-46): home-base hero gap between logo and title is 48 (--tm-space-3xl). */
#doctor-login-preview .login-content { flex:1; display:flex; flex-direction:column; padding-top:var(--tm-space-3xl); }
#doctor-login-preview .login-content > p { max-width:31ch; }
/* Round 4 A-05: header text to the white panel is 32, and the panel's top padding is 32 on every screen. */
#doctor-login-preview .login-fields { flex:1; margin:var(--tm-space-2xl) calc(-1 * var(--tm-space-page)) 0; padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-xl); background:var(--tm-surface-primary); border-radius:var(--tm-radius-2xl) var(--tm-radius-2xl) 0 0; }
#doctor-login-preview .login-signup { margin:0 calc(-1 * var(--tm-space-page)); padding:0 var(--tm-space-page) var(--tm-space-xl); background:var(--tm-surface-primary); }
/* Round 4 A-14: a notice under the field sits 8 below it (as on OTP). */
#doctor-login-preview .login-notice { margin-top:var(--tm-space-sm); }   /* the sign-in notice class is login-notice (not .tm-notice): 5.12 keeps the component unrestyled */
#doctor-login-preview .login-phone { position:relative; }
#doctor-login-preview.is-focused .login-fields .tm-field__control { border-color:var(--tm-border-focus); }
#doctor-login-preview.has-error .login-fields .tm-field__control { border-color:var(--tm-border-error-strong); }
#doctor-login-preview.has-error .tm-field__helper { color:var(--tm-content-error); }
#doctor-login-preview[data-keyboard="true"] .login-signup { visibility:hidden; }
#doctor-login-preview[data-keyboard="false"] .login-keyboard { display:none; }
#doctor-login-preview .login-keyboard { position:absolute; left:0; right:0; bottom:0; height:256px; padding:6px 5px 12px; background:#d4d7dd; display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(4,1fr); gap:5px; box-sizing:border-box; }
#doctor-login-preview .login-key { display:grid; place-items:center; background:#fff; border-radius:5px; color:#202124; font:400 23px/1 system-ui,sans-serif; }
/* Round 4 lane D (A-15): same keyboard drawing as OTP — blank key and ⌫ are white keys too. */
#doctor-login-preview .login-key--quiet { background:#fff; }
@media(max-width:360px) {
  #doctor-login-preview .login-phone { padding-left:var(--tm-space-page); padding-right:var(--tm-space-page); }
}

html,body {margin:0;min-height:100%;}
body {background:var(--tm-surface-primary);}
#doctor-login-preview input:focus-visible {outline:none;}
.review-controls {max-width:390px;margin:24px auto 0;font-family:var(--tm-font);color:var(--tm-content-primary);}
.review-controls label {display:block;margin-bottom:8px;}
.review-controls select {width:100%;height:44px;padding:0 12px;border:1px solid var(--tm-border-default);border-radius:var(--tm-radius-md);background:var(--tm-surface-primary);font:inherit;}
html.capture .review-controls {display:none;}
html.capture body {width:100%;overflow:hidden;}
html.capture #doctor-login-preview .login-stage {padding:0;justify-content:flex-start;}
html.capture #doctor-login-preview .login-phone {width:100%;min-height:844px;border:0;border-radius:0;box-shadow:none;}
</style>
</head>
<body class="tm">
<div class="review-controls"><label for="state">Approved state</label><select id="state" aria-label="Approved sign-in state"><option value="default">Default</option><option value="keyboard-open">Keyboard open</option><option value="empty-tap">Empty tap</option><option value="too-short">Too short</option><option value="wrong-first-digit">Wrong first digit</option><option value="pasted-cleaned">Pasted, cleaned</option><option value="sending">Sending OTP</option><option value="not-registered">Not registered</option><option value="offline">Offline</option><option value="couldnt-send">Couldn’t send</option><option value="too-many-tries">Too many tries</option><option value="inactive">Inactive account</option></select></div>
<div id="doctor-login-preview" data-state="default" data-keyboard="false">
  <div class="login-stage">
    <section class="login-phone tm" aria-label="Truemeds doctor sign-in screen">
      <img class="login-logo" src="../../brand/truemeds-for-doctors.svg" alt="truemeds for doctors">
      <main class="login-content">
        <h1>Welcome, Doctor</h1>
        <p>Your partner in thoughtful, affordable care.</p>
        <div class="login-fields">
          <div class="tm-field">
            <label class="tm-field__label" for="tm-login-mobile">Mobile number</label>
            <div class="tm-field__control">
              <span class="login-prefix">+91</span>
              <input id="tm-login-mobile" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="e.g. 98765 43210" aria-describedby="tm-login-helper">
            </div>
            <div id="tm-login-helper" class="tm-field__helper">We’ll send you a verification code by SMS.</div>
            <div id="tm-login-notice" class="tm-notice login-notice tm-notice--neutral" role="status" hidden><span class="tm-icon" data-icon="info-circle" aria-hidden="true"></span><span></span></div>
            <div id="tm-login-offline-notice" class="tm-notice login-notice tm-notice--warning" role="alert" hidden><span class="tm-icon" data-icon="alert-triangle" aria-hidden="true"></span><span></span></div>
            <div id="tm-login-send-error-notice" class="tm-notice login-notice tm-notice--error" role="alert" hidden><span class="tm-icon" data-icon="alert-circle" aria-hidden="true"></span><span></span></div>
            <div id="tm-login-too-many-notice" class="tm-notice login-notice tm-notice--warning" role="alert" hidden><span class="tm-icon" data-icon="clock" aria-hidden="true"></span><span></span></div>
            <div id="tm-login-inactive-notice" class="tm-notice login-notice tm-notice--error" role="alert" hidden><span class="tm-icon" data-icon="alert-circle" aria-hidden="true"></span><span></span></div>
          </div>
          <button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block login-submit" type="button"><span class="tm-spinner" aria-hidden="true" hidden></span><span class="login-submit-label">Send OTP</span></button>
        </div>
      </main>
      <div class="login-signup" id="tm-signup-option">New to Truemeds? <span class="login-signup-label">Sign up</span></div>
      <div class="login-keyboard" aria-hidden="true">
        <span class="login-key">1</span><span class="login-key">2</span><span class="login-key">3</span>
        <span class="login-key">4</span><span class="login-key">5</span><span class="login-key">6</span>
        <span class="login-key">7</span><span class="login-key">8</span><span class="login-key">9</span>
        <span class="login-key login-key--quiet"></span><span class="login-key">0</span><span class="login-key login-key--quiet">⌫</span>
      </div>
    </section>
  </div>
</div>

<script src="../../../../design-system/icons/icons.js"></script>
<script src="../feedback/messages.js"></script>
<script>
(() => {
  const root = document.getElementById('doctor-login-preview');
  const selector = document.getElementById('state');
  const input = document.getElementById('tm-login-mobile');
  const helper = document.getElementById('tm-login-helper');
  const notice = document.getElementById('tm-login-notice');
  const offlineNotice = document.getElementById('tm-login-offline-notice');
  const sendErrorNotice = document.getElementById('tm-login-send-error-notice');
  const tooManyNotice = document.getElementById('tm-login-too-many-notice');
  const inactiveNotice = document.getElementById('tm-login-inactive-notice');
  const field = root.querySelector('.tm-field');
  const submit = root.querySelector('.login-submit');
  const submitLabel = root.querySelector('.login-submit-label');
  const spinner = root.querySelector('.tm-spinner');
  const M = window.TMFeedback.msg;
  const states = {
    default: {number: '', helper: M('signin.smsHelper'), error: false, keyboard: false, focused: false},
    'keyboard-open': {number: '98765', helper: M('signin.smsHelper'), error: false, keyboard: true, focused: true},
    'empty-tap': {number: '', helper: M('signin.empty'), error: true, keyboard: true, focused: false},
    'too-short': {number: '98765432', helper: M('signin.short'), error: true, keyboard: true, focused: false},
    'wrong-first-digit': {number: '1234567890', helper: M('signin.prefix'), error: true, keyboard: true, focused: false},
    'pasted-cleaned': {number: '9876543210', helper: M('signin.smsHelper'), error: false, keyboard: true, focused: true},
    sending: {number: '9876543210', helper: M('signin.smsHelper'), error: false, keyboard: true, focused: true},
    'not-registered': {number: '9876543210', helper: '', error: false, keyboard: false, focused: false},
    offline: {number: '9876543210', helper: '', error: false, keyboard: false, focused: false},
    'couldnt-send': {number: '9876543210', helper: '', error: false, keyboard: false, focused: false},
    'too-many-tries': {number: '9876543210', helper: '', error: false, keyboard: false, focused: false},
    inactive: {number: '9876543210', helper: '', error: false, keyboard: false, focused: false}
  };
  function show(state) {
    const next = states[state] || states.default;
    root.dataset.state = states[state] ? state : 'default';
    root.dataset.keyboard = String(next.keyboard);
    root.classList.toggle('has-error', next.error);
    root.classList.toggle('is-focused', next.focused);
    selector.value = root.dataset.state;
    input.blur();
    input.value = next.number;
    input.readOnly = state === 'sending';
    helper.textContent = next.helper;
    helper.hidden = state === 'not-registered' || state === 'offline' || state === 'couldnt-send' || state === 'too-many-tries' || state === 'inactive';
    notice.hidden = state !== 'not-registered';
    offlineNotice.hidden = state !== 'offline';
    sendErrorNotice.hidden = state !== 'couldnt-send';
    tooManyNotice.hidden = state !== 'too-many-tries';
    inactiveNotice.hidden = state !== 'inactive';
    if (state === 'not-registered') notice.lastElementChild.textContent = M('signin.notRegistered');
    if (state === 'offline') offlineNotice.lastElementChild.textContent = M('signin.offline');
    if (state === 'couldnt-send') sendErrorNotice.lastElementChild.textContent = M('signin.couldntSend');
    if (state === 'too-many-tries') tooManyNotice.lastElementChild.textContent = M('signin.tooMany');
    if (state === 'inactive') inactiveNotice.lastElementChild.textContent = M('signin.inactive');
    input.setAttribute('aria-describedby', state === 'not-registered' ? 'tm-login-notice' : state === 'offline' ? 'tm-login-offline-notice' : state === 'couldnt-send' ? 'tm-login-send-error-notice' : state === 'too-many-tries' ? 'tm-login-too-many-notice' : state === 'inactive' ? 'tm-login-inactive-notice' : 'tm-login-helper');
    submitLabel.textContent = state === 'sending' ? 'Sending OTP…' : state === 'too-many-tries' ? 'Try again in 9:42' : state === 'inactive' ? 'Call Doctor Ops' : 'Send OTP';
    submit.setAttribute('aria-busy', String(state === 'sending'));
    submit.classList.toggle('tm-btn--busy', state === 'sending');
    spinner.hidden = state !== 'sending';
    submit.setAttribute('aria-disabled', String(state === 'sending' || state === 'too-many-tries'));
    submit.disabled = state === 'sending' || state === 'too-many-tries';
    // Capture exact disabled palette from shared design tokens.
    field.classList.toggle('tm-field--error', next.error);
    input.setAttribute('aria-invalid', String(next.error));
    if (next.error) helper.setAttribute('role', 'alert');
    else helper.removeAttribute('role');
  }
  selector.addEventListener('change', () => show(selector.value));
  show(new URLSearchParams(location.search).get('capture') || 'default');
})();
</script>
</body>
</html>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Truemeds for doctors — Verify your number</title>
<script>if(new URLSearchParams(location.search).has("capture"))document.documentElement.classList.add("capture")</script>
<link rel="stylesheet" href="../../../../design-system/truemeds.css">
<style>
html,body{margin:0;height:100%}
body.tm{background:var(--tm-surface-primary)}
.screen{height:100dvh;display:flex;flex-direction:column;box-sizing:border-box;position:relative;overflow:hidden;background:var(--tm-surface-brand-subtle)}
/* Task header (D-61): logo + title, no Back (Change and the phone back gesture cover it) */
.login-logo{display:block;width:166px;height:auto;margin-bottom:var(--tm-space-lg)}
.top{padding:var(--tm-space-lg) var(--tm-space-page) var(--tm-space-2xl)}   /* Round 4 A-05: header text to the white panel is 32 on every screen (was 16) */
.back{display:inline-flex;align-items:center;gap:var(--tm-space-xs);min-height:48px;color:var(--tm-content-secondary);font-size:var(--tm-font-size-body-lg);line-height:var(--tm-font-lineheight-md);text-decoration:none;cursor:pointer}
.back .tm-icon{width:20px;height:20px}
.back:focus-visible{outline:2px solid var(--tm-border-focus);outline-offset:var(--tm-space-xs)}
.head{margin-top:var(--tm-space-sm);display:flex;flex-direction:column;gap:var(--tm-space-sm)}
.head h1{margin:0}
/* Round 4 A-04: the subtitle is 14/20 with the 8 gap, as on the offer and unlock headers; the number stays semibold. */
.head p{margin:0;font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
.head p b{color:var(--tm-content-primary);font-weight:var(--tm-font-weight-medium,500)}
a.lk{color:var(--tm-content-brand);font-weight:var(--tm-font-weight-semibold);text-decoration:none;display:inline-flex;align-items:center;min-height:48px}
/* White panel; section gap 32 between groups, related gap 16 within a group (RULES §8.3) */
/* Content scrolls when it does not fit; with the keyboard open, the bottom clears the keyboard by 16px (LOCKED, D-46). */
.panel{flex:1;min-height:0;overflow-y:auto;background:var(--tm-surface-primary);border-radius:var(--tm-radius-2xl) var(--tm-radius-2xl) 0 0;padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-xl);display:flex;flex-direction:column}
body.kb .panel{padding-bottom:calc(256px + var(--tm-space-lg))}
.grp{display:flex;flex-direction:column;gap:var(--tm-space-lg)}
.grp + .grp{margin-top:var(--tm-space-2xl)}
.code{display:flex;flex-direction:column;gap:var(--tm-space-sm)}
.tm-field__helper{margin:0}
.tm-field__helper[hidden]{display:none}
.tm-otp-slots{position:relative}
/* Round 5 B (Apurva 2026-11-02): one reserved line under the boxes for the helper (wrong code, tries left, expired, empty, too short) or the new-code line,
   so Verify & sign in sits at the same y in every state where it shows. The slot is hidden when the state shows a notice box instead (its own layout). */
.code-slot{min-height:20px}
.code-slot.off{display:none}
/* Error: digits stay visible with red borders; no focus box (D-44). Central .tm-field--error and .tm-field--disabled do the look. */
.note{display:none}.note.show{display:flex}
/* Round 4 A-14: the notice sits 8 below the boxes (the group gap is 16; pulled up by 8). */
.grp > .note{margin-top:calc(var(--tm-space-sm) - var(--tm-space-lg))}
.note .tm-icon{flex-shrink:0;margin-top:1px}
.note a{color:var(--tm-content-brand);font-weight:var(--tm-font-weight-semibold);text-decoration:none}
/* Resend line: one centred line; timer heavier with fixed-width digits; not tappable */
/* Round 4 A-03: the line is 48 tall whether it shows the wait or the Resend code link, so Verify does not drop 28 when the link appears. */
.rs{margin:0;text-align:center;font-size:var(--tm-font-size-body-md);line-height:48px;min-height:48px;color:var(--tm-content-secondary)}
.rs[hidden]{display:none}
.rs .timer{font-weight:var(--tm-font-weight-semibold);font-variant-numeric:tabular-nums;color:var(--tm-content-primary)}
/* Round 4 A-16: the link follows a normal word space (no padding inside the button). */
.rs button{min-height:48px;min-width:48px;border:0;background:transparent;padding:0;vertical-align:top;color:var(--tm-content-brand);font:inherit;font-weight:var(--tm-font-weight-semibold);cursor:pointer}
.s1{margin:0;display:none;align-items:center;justify-content:center;gap:var(--tm-space-xs);font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-success)}
.s1.show{display:flex}
.s1 .tm-icon{width:16px;height:16px}
/* Consent: L4 fine print, directly above the button, only when Verify is possible */
/* Round 4 A-01 / A-02: the terms line is centred in the panel, balanced, and "Terms & Conditions" never splits. */
.consent{margin:0 0 var(--tm-space-lg);display:none;color:var(--tm-content-secondary);text-align:center;text-wrap:balance}
.consent.show{display:block}
/* Round 5 B: an expired code hides the terms but keeps their height, so Verify (disabled) does not move. */
.consent.reserve{display:block;visibility:hidden}
.consent a{color:var(--tm-content-brand);font-weight:var(--tm-font-weight-semibold);text-decoration:none;white-space:nowrap}
/* Mock OS keyboard (raw colours allowed here only, as in the other screens) */
.kbd{position:absolute;left:0;right:0;bottom:0;height:256px;background:#d4d7dd;display:none;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(4,1fr);gap:5px;padding:6px 5px 12px;box-sizing:border-box;z-index:5}
.kbd div{background:#fff;border-radius:5px;display:flex;align-items:center;justify-content:center;font:400 23px/1 system-ui,sans-serif;color:#202124}
body.kb .kbd{display:grid}
html.capture body,html.capture .screen{width:100%;overflow:hidden}
.review-controls{max-width:390px;margin:var(--tm-space-lg) auto;font-family:var(--tm-font);color:var(--tm-content-primary)}
.review-controls label{display:block;margin-bottom:var(--tm-space-xs)}
.review-controls select{width:100%;padding:var(--tm-space-sm);font:inherit;border:1px solid var(--tm-border-default);border-radius:var(--tm-radius-md);background:var(--tm-surface-primary)}
html.capture .review-controls{display:none}
@media(min-width:768px){body.tm{display:flex;flex-direction:column;align-items:center;background:var(--tm-surface-secondary)}.screen{width:390px;height:844px;flex:none;overflow:hidden;border:1px solid var(--tm-border-subtle);border-radius:var(--tm-radius-2xl);box-shadow:var(--tm-shadow-header)}html.capture body.tm{display:block;background:var(--tm-surface-primary)}html.capture .screen{border:0;border-radius:0;box-shadow:none;width:100%}}
</style>
<script src="../../../../design-system/icons/icons.js"></script>
<script src="../feedback/messages.js"></script>
</head><body class="tm">
<div class="review-controls"><label for="review-state">Approved state</label><select id="review-state" aria-label="OTP state"><option value="default">Default</option><option value="empty-tap">Verify with no code</option><option value="too-short">Verify with two digits</option><option value="verifying">Verifying</option><option value="wrong-code">Wrong code</option><option value="two-tries-left">Two tries left</option><option value="resend-available">Resend available</option><option value="new-code-sent">New code sent</option><option value="code-expired">Code expired</option><option value="couldnt-verify">Couldn’t verify</option><option value="too-many-resends">Too many resends</option><option value="locked">Locked number</option><option value="resending">Resending</option><option value="resend-failed">Resend failed</option><option value="offline">Offline</option><option value="cooldown-reconciling">Cooldown reconciling</option><option value="expired-and-resend-limited">Expired and resend limited</option></select></div>
<div class="screen">
 <div class="top">
  <img class="login-logo" src="../../brand/truemeds-for-doctors.svg" alt="truemeds for doctors">
  <div class="head"><h1 class="tm-text-title-lg">Verify your number</h1><p>Sent to <b>+91 98765 43210</b> · <a class="lk" href="../sign-in/sign-in.html">Change</a></p></div>
 </div>
 <div class="panel">
  <div class="grp">
   <div class="tm-field code" id="f">
    <div class="tm-otp-slots" id="slots"><input class="tm-otp-slots__input" id="c" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="one-time-code" aria-label="4-digit verification code" aria-describedby="h" aria-invalid="false"><span class="tm-otp-slots__slot" aria-hidden="true"></span><span class="tm-otp-slots__slot" aria-hidden="true"></span><span class="tm-otp-slots__slot" aria-hidden="true"></span><span class="tm-otp-slots__slot" aria-hidden="true"></span></div>
    <div class="code-slot" id="slot"><div class="tm-field__helper" id="h" hidden></div><p class="s1" id="s1" role="status"><span id="s1t"></span></p></div>
   </div>
   <div class="tm-notice note" id="n" role="status" aria-live="polite"><span class="tm-icon" id="ni" data-icon="info-circle" aria-hidden="true"></span><div id="nt"></div></div>
   <p class="rs" id="rs"><span id="rp">Didn’t receive it? </span><span id="rr"></span></p>
  </div>
  <div class="grp">
   <p class="consent tm-text-body-sm" id="consent">By selecting Verify &amp; sign in, you agree to the <a href="#">Terms &amp; Conditions</a> and acknowledge the <a href="#">Privacy Policy</a>.</p>
   <button class="tm-btn tm-btn--lg tm-btn--primary tm-btn--block" id="b" type="button">Verify &amp; sign in</button>
  </div>
 </div>
 <div class="kbd"><div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div><div>7</div><div>8</div><div>9</div><div></div><div>0</div><div>⌫</div></div>
</div>
<script>
const M=window.TMFeedback.msg;
const $=id=>document.getElementById(id);
const code=$('c'), slots=[...document.querySelectorAll('.tm-otp-slots__slot')], field=$('f'), helper=$('h'), btn=$('b');
const BTN_LABEL='Verify & sign in';
let replaceNext=false;
// Each state: code kept, keyboard, F1 error, notice, resend line, S1, consent, lock/expired/busy flags.
const STATES={
 'default':{code:'',kb:true,rs:'wait',consent:true},
 'empty-tap':{code:'',kb:true,err:M('otp.empty'),rs:'wait',consent:true},
 'too-short':{code:'48',kb:true,err:M('otp.short'),rs:'wait',consent:true},
 'verifying':{code:'4827',busy:true,kb:true,rs:'wait',consent:true},
 'wrong-code':{code:'4827',kb:true,err:M('otp.wrong'),replace:true,rs:'wait',consent:true},
 'two-tries-left':{code:'4827',kb:true,err:M('otp.triesLeft',{count:2}),replace:true,rs:'wait',consent:true},
 'resend-available':{code:'',kb:true,rs:'available',consent:true},
 'new-code-sent':{code:'',kb:true,s1:M('otp.newSent'),rs:'wait',time:'1:00',consent:true},
 'code-expired':{code:'4827',kb:true,expired:true,err:M('otp.expired'),replace:true,rs:'available'},
 'couldnt-verify':{code:'4827',kb:true,note:{k:'error',i:'alert-circle',t:M('otp.couldntVerify')},rs:'wait',consent:true},
 'too-many-resends':{code:'',kb:true,note:{k:'warning',i:'clock',ops:true,t:M('otp.tooManyResends')},rs:'hidden',consent:true},
 'locked':{code:'',locked:true,note:{k:'warning',i:'clock',ops:true,t:M('otp.locked',{time:'14:52'})},rs:'hidden'},
 'resending':{code:'4827',kb:true,rs:'sending',consent:true},
 'resend-failed':{code:'4827',kb:true,note:{k:'error',i:'alert-circle',t:M('otp.resendFailed')},rs:'available',consent:true},
 'offline':{code:'4827',kb:true,note:{k:'warning',i:'alert-triangle',t:M('signin.offline')},rs:'available',consent:true},
 'cooldown-reconciling':{code:'',kb:true,rs:'checking',hold:true,consent:true},
 'expired-and-resend-limited':{code:'',locked:true,note:{k:'warning',i:'clock',ops:true,t:M('otp.expiredAndLimited',{time:'9:42'})},rs:'hidden'}
};
function clearError(){field.classList.remove('tm-field--error');helper.hidden=true;helper.removeAttribute('role');code.setAttribute('aria-invalid','false');replaceNext=false;}
function renderSlots(){
 const v=code.value.replace(/\D/g,'').slice(0,4); if(code.value!==v)code.value=v;
 const err=field.classList.contains('tm-field--error');
 const kb=document.body.classList.contains('kb');
 slots.forEach((s,i)=>{s.textContent=v[i]||'';s.classList.toggle('is-current',kb&&!err&&!code.disabled&&i===Math.min(v.length,3));});
}
function note(n){
 const box=$('n'), body=$('nt'), ico=$('ni');
 box.classList.remove('show','tm-notice--error','tm-notice--warning','tm-notice--neutral');
 body.textContent='';
 if(!n){return;}
 box.classList.add('show','tm-notice--'+n.k);
 ico.setAttribute('data-icon',n.i);
 const phrase='call Doctor Ops', at=n.t.lastIndexOf(phrase);
 if(n.ops&&at>=0){body.append(document.createTextNode(n.t.slice(0,at)));const a=document.createElement('a');a.href='#';a.textContent=phrase;body.append(a,document.createTextNode(n.t.slice(at+phrase.length)));}
 else body.textContent=n.t;
}
function resendLine(s){
 const rr=$('rr'), rs=$('rs');
 rs.hidden=s.rs==='hidden'; $('rp').hidden=s.rs==='checking';   // D-81 F7: Checking… alone
 if(s.rs==='wait') rr.innerHTML='Resend in <span class="timer">'+(s.time||'0:30')+'</span>';
 if(s.rs==='available') rr.innerHTML='<button type="button">Resend code</button>';
 if(s.rs==='sending') rr.textContent='Sending a new code…';
 if(s.rs==='checking') rr.textContent='Checking…';
}
let currentS=null;
function state(k){
 const s=STATES[k]||STATES['default'];
 currentS=s;
 const locked=!!s.locked, busy=!!s.busy;
 code.value=s.code||'';
 code.disabled=locked;
 code.readOnly=busy;
 field.classList.toggle('tm-field--disabled',locked);
 clearError();
 if(s.err){field.classList.add('tm-field--error');helper.hidden=false;helper.textContent=s.err;helper.setAttribute('role','alert');code.setAttribute('aria-invalid','true');}
 replaceNext=!!s.replace;
 note(s.note);
 $('slot').classList.toggle('off',!!s.note);   // Round 5 B: the reserved line is used only where no notice box shows
 const s1=$('s1'); s1.classList.toggle('show',!!s.s1); $('s1t').textContent=s.s1||'';
 resendLine(s);
 $('consent').classList.toggle('show',!!s.consent&&!locked&&!s.expired);   // D-81 F5: terms stay during Verifying… and Checking…
 $('consent').classList.toggle('reserve',!!s.expired);   // Round 5 B: keep the terms' height under an expired code
 const off=locked||busy||!!s.expired||!!s.hold;
 btn.disabled=off;
 btn.classList.toggle('tm-btn--busy',busy);
 btn.setAttribute('aria-busy',String(busy));
 btn.innerHTML=busy?'<span class="tm-spinner" aria-hidden="true"></span>Verifying…':BTN_LABEL;
 const kb=!!s.kb&&!locked;
 document.body.classList.toggle('kb',kb);
 if(kb)code.focus();
 renderSlots();
 TMIcons.render(document);
}
// Replace-on-first-keystroke after a server wrong/expired response (D-44)
code.addEventListener('keydown',e=>{if(replaceNext&&/^\d$/.test(e.key)){e.preventDefault();code.value=e.key;clearError();afterNewCode();renderSlots();}});
code.addEventListener('input',()=>{if(replaceNext){code.value=code.value.replace(/\D/g,'').slice(-1);clearError();afterNewCode();}renderSlots();});
code.addEventListener('focus',renderSlots);
code.addEventListener('blur',renderSlots);
// A new code after an expiry re-enables Verify (the expired code itself stays blocked)
function afterNewCode(){if(currentS&&currentS.expired){btn.disabled=false;currentS={...currentS,expired:false};}}
const params=new URLSearchParams(location.search);
const reviewKey=params.get('capture')||params.get('state')||'default';
const selector=$('review-state');
selector.value=reviewKey;
selector.addEventListener('change',()=>{location.search='?state='+encodeURIComponent(selector.value)});
state(reviewKey);
</script></body></html>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Truemeds for doctors — Skip the OTP next time</title>
<script>if(new URLSearchParams(location.search).has('capture'))document.documentElement.classList.add('capture')</script>
<link rel="stylesheet" href="../../../../design-system/truemeds.css">
<style>
html,body{margin:0;height:100%}
body.tm{background:var(--tm-surface-primary)}
/* Decision D-45 (faster sign-in offer): own screen, no OTP opt-in. Task header (D-42): Back + title, no logo. */
.screen{height:100dvh;display:flex;flex-direction:column;box-sizing:border-box;position:relative;overflow:hidden;background:var(--tm-surface-brand-subtle)}
/* A-05 (Round 4): header text to the white panel is 32 on sign-in, OTP, offer, unlock and Home. */
.top{padding:var(--tm-space-lg) var(--tm-space-page) var(--tm-space-2xl)}
.back{display:inline-flex;align-items:center;gap:var(--tm-space-xs);min-height:44px;color:var(--tm-content-secondary);font-size:var(--tm-font-size-body-lg);line-height:var(--tm-font-lineheight-md);text-decoration:none;cursor:pointer;background:none;border:0;padding:0;font-family:inherit}
.back .tm-icon{width:20px;height:20px}
.back:focus-visible{outline:2px solid var(--tm-border-focus);outline-offset:var(--tm-space-xs)}
.hero-wrap{display:flex;justify-content:center;margin-bottom:var(--tm-space-lg)}
.hero-ic{width:64px;height:64px;border-radius:var(--tm-radius-lg);background:var(--tm-surface-brand-subtle);color:var(--tm-content-brand);display:grid;place-items:center}
.hero-ic .tm-icon{width:var(--tm-space-2xl);height:var(--tm-space-2xl)}
.login-logo{display:block;width:166px;height:auto;margin-bottom:var(--tm-space-lg)}
/* Round 4 (A-19): "Couldn't turn on…" is the result of a tap, so it sits inside the pinned bar, 16 above its button. */
/* Round 4 lane D: the in-bar offer notice takes its 16 gap from .tm-actionbar > .tm-notice (component). */
.notice-slot[hidden]{display:none!important}
/* D-93 (revised): "unavailable" is the result of the Turn on tap, so its warning notice sits in the same bar slot as Offline and Couldn't turn on (A-19). */
.screen [hidden]{display:none!important}
h1{margin:var(--tm-space-lg) 0 var(--tm-space-sm)}
.sub{margin:0;font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
/* White panel; points are one group (related 16). Footer is pinned (no typing on this screen, RULES §8.4). */
.panel{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--tm-surface-primary);border-radius:var(--tm-radius-2xl) var(--tm-radius-2xl) 0 0;padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-xl)}
/* Round 4 lane D (item 1, 360×640): the panel scrolls above the pinned bar when the phone is short; the bar never covers its last line. */
.panel{overflow-y:auto}
.points{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:var(--tm-space-lg)}
.points li{display:flex;gap:var(--tm-space-md);align-items:flex-start}
/* Decorative icons are neutral (RULES §8.11, D-47). Blue stays for actions and the hero tile. */
.points .tm-icon{width:24px;height:24px;flex:none;color:var(--tm-content-secondary);margin-top:0}
.pt-t{margin:0;font-size:var(--tm-font-size-body-lg);line-height:var(--tm-font-lineheight-md);font-weight:var(--tm-font-weight-medium,500);color:var(--tm-content-primary)}
.pt-d{margin:0;font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
/* Round 4 item 1: the pinned footer is the real .tm-actionbar, edge to edge on the panel (like the case page). */
.footer{flex:none;margin:0}   /* lane D: the bar is a sibling below the panel (not in its scroll), flush with the frame's bottom edge */
html.capture body,html.capture .screen{width:100%;overflow:hidden}
.review-controls{max-width:390px;margin:var(--tm-space-lg) auto;font-family:var(--tm-font);color:var(--tm-content-primary)}
.review-controls label{display:block;margin-bottom:var(--tm-space-xs)}
.review-controls select{width:100%;padding:var(--tm-space-sm);font:inherit;border:1px solid var(--tm-border-default);border-radius:var(--tm-radius-md);background:var(--tm-surface-primary)}
html.capture .review-controls{display:none}
@media(min-width:768px){body.tm{display:flex;flex-direction:column;align-items:center;background:var(--tm-surface-secondary)}.screen{width:390px;height:844px;flex:none;overflow:hidden;border:1px solid var(--tm-border-subtle);border-radius:var(--tm-radius-2xl);box-shadow:var(--tm-shadow-header)}html.capture body.tm{display:block;background:var(--tm-surface-primary)}html.capture .screen{border:0;border-radius:0;box-shadow:none}}
</style>
<script src="../../../../design-system/icons/icons.js"></script>
<script src="../feedback/messages.js"></script>
</head><body class="tm">
<div class="review-controls"><label for="review-state">Reference state</label><select id="review-state" aria-label="Faster sign-in offer state"><option value="fingerprint">Shown, fingerprint</option><option value="face-id">Shown, Face ID</option><option value="enabling">Enabling (OS prompt pending)</option><option value="screen-lock">Shown, screen lock</option><option value="enable-failed">Enabling failed</option><option value="offline">Offline (after tapping Turn on)</option><option value="unavailable">Not available on this phone (D-93)</option></select></div>
<div class="screen">
 <div class="top">
  <img class="login-logo" src="../../brand/truemeds-for-doctors.svg" alt="truemeds for doctors">
  <h1 class="tm-text-title-lg" id="title">Skip the OTP next time</h1>
  <p class="sub" id="sub"></p>
 </div>
 <div class="panel">
  <div class="hero-wrap"><div class="hero-ic" aria-hidden="true"><span class="tm-icon" id="hero-icon" data-icon="fingerprint"></span></div></div>
  <ul class="points">
   <li><span class="tm-icon" data-icon="circle-check" aria-hidden="true"></span><div><p class="pt-t">No more waiting for SMS codes</p><p class="pt-d" id="pt-d1"></p></div></li>
   <li><span class="tm-icon" data-icon="lock" aria-hidden="true"></span><div><p class="pt-t" id="pt-t2"></p><p class="pt-d">Truemeds never sees or stores it.</p></div></li>
   <li><span class="tm-icon" data-icon="settings" aria-hidden="true"></span><div><p class="pt-t">Change it any time</p><p class="pt-d">Turn it off from your profile.</p></div></li>
  </ul>
 </div>
  <div class="tm-actionbar footer">
   <div class="tm-notice tm-notice--error notice-slot" id="offer-notice" role="status" hidden><span class="tm-icon" data-icon="alert-circle" aria-hidden="true"></span><span id="offer-notice-text"></span></div>
   <button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block" id="turn-on" type="button"><span id="turn-on-label">Turn on faster sign-in</span></button>
   <button class="tm-btn tm-btn--quiet tm-btn--lg tm-btn--block" id="not-now" type="button">Not now</button>
  </div>
</div>
<script>
// Device wording (D-45): "Face ID" on Face-ID phones, "fingerprint" on fingerprint phones. Never implies Truemeds stores biometrics.
const M=window.TMFeedback.msg;
const VARIANTS={
 fingerprint:{icon:'fingerprint',sub:'Use your fingerprint instead of waiting for an OTP.',d1:'Unlock the app with one touch, not an OTP.',t2:'Your fingerprint stays on your phone'},
 'face-id':{icon:'face-id',sub:'Use Face ID instead of waiting for an OTP.',d1:'Unlock the app with a glance, not an OTP.',t2:'Your Face ID stays on your phone'},
 enabling:{icon:'fingerprint',sub:'Use your fingerprint instead of waiting for an OTP.',d1:'Unlock the app with one touch, not an OTP.',t2:'Your fingerprint stays on your phone',enabling:true},
 'screen-lock':{icon:'lock',sub:M('offer.screenLockSub'),d1:M('offer.screenLockLine'),t2:M('offer.screenLockTrust')},
 'enable-failed':{icon:'fingerprint',sub:'Use your fingerprint instead of waiting for an OTP.',d1:'Unlock the app with one touch, not an OTP.',t2:'Your fingerprint stays on your phone',notice:['error','alert-circle',M('offer.enableFailed')],retry:true},
 offline:{icon:'fingerprint',sub:'Use your fingerprint instead of waiting for an OTP.',d1:'Unlock the app with one touch, not an OTP.',t2:'Your fingerprint stays on your phone',notice:['warning','alert-triangle',M('offer.offline')]},
 // D-93 (revised): the phone answered "unavailable" at Turn on. Screen unchanged; warning notice in the bar (unlock.unavailable),
 // the primary reads Continue (offer.continue) → Home, Not now hidden.
 unavailable:{icon:'fingerprint',sub:'Use your fingerprint instead of waiting for an OTP.',d1:'Unlock the app with one touch, not an OTP.',t2:'Your fingerprint stays on your phone',notice:['warning','alert-triangle',M('unlock.unavailable')],unavailable:true}
};
const params=new URLSearchParams(location.search);
const key=params.get('capture')||params.get('state')||'fingerprint';
const v=VARIANTS[key]||VARIANTS.fingerprint;
const sel=document.getElementById('review-state');
sel.value=key in VARIANTS?key:'fingerprint';
sel.addEventListener('change',()=>{location.search='?state='+encodeURIComponent(sel.value)});
document.getElementById('hero-icon').dataset.icon=v.icon;
document.getElementById('sub').textContent=v.sub;
document.getElementById('pt-d1').textContent=v.d1;
document.getElementById('pt-t2').textContent=v.t2;
const turnOn=document.getElementById('turn-on');
if(v.notice){const n=document.getElementById('offer-notice');n.className='tm-notice tm-notice--'+v.notice[0]+' notice-slot';n.hidden=false;n.querySelector('.tm-icon').dataset.icon=v.notice[1];document.getElementById('offer-notice-text').textContent=v.notice[2];}
if(v.unavailable){
 // D-93: one action left, so the primary reads Continue and Not now is hidden (one primary per context).
 document.getElementById('turn-on-label').textContent=M('offer.continue');
 document.getElementById('not-now').hidden=true;
}
if(v.retry){document.getElementById('turn-on-label').textContent='Try again';}
if(v.enabling){
 // L2: loading primary = brand fill, white label and spinner (central .tm-btn--busy)
 turnOn.classList.add('tm-btn--busy');turnOn.setAttribute('aria-busy','true');turnOn.disabled=true;
 document.getElementById('turn-on-label').innerHTML='<span class="tm-spinner" aria-hidden="true"></span>Turning on…';
 document.getElementById('not-now').disabled=true;
}
// No Back: this screen follows sign-in, so there is nothing to go back to (D-47).
// Phone back gesture = Not now (native). Escape stands in for it in this reference.
// D-93: on unavailable Not now is hidden, so phone Back = Continue (the only action).
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;const nn=document.getElementById('not-now');if(v.unavailable)turnOn.click();else if(!nn.disabled)nn.click();});
// Exits (cancelled, failed, not now, enabled) all go to Home; no error is shown (D-45, D-37).
// D-93: unavailable → Continue → Home; faster sign-in is not enabled (Profile can turn it on later).
TMIcons.render(document);
</script>
</body></html>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Truemeds for doctors — Returning doctor</title>
<script>if(new URLSearchParams(location.search).has('capture'))document.documentElement.classList.add('capture')</script>
<link rel="stylesheet" href="../../../../design-system/truemeds.css">
<style>
html,body{margin:0;height:100%}
body.tm{background:var(--tm-surface-brand-subtle);color:var(--tm-content-primary)}
/* Task header (D-42): title, no logo, no Back: first screen when the app opens (D-47). Pinned footer (no typing, RULES §8.4). */
.screen{height:100dvh;box-sizing:border-box;display:flex;flex-direction:column;background:var(--tm-surface-brand-subtle);font-family:var(--tm-font);overflow:hidden;position:relative}
