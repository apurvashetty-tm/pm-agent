<script src="../../../../design-system/icons/icons.js"></script>
<script src="../feedback/messages.js"></script>
</head><body class="tm">
<div class="review-controls"><label for="review-variant">Reference state</label><select id="review-variant" aria-label="Returning unlock state"><option value="fingerprint">Fingerprint</option><option value="face">Face ID</option><option value="screen-lock">Screen lock</option><option value="pending">Pending (OS prompt open)</option><option value="cancelled">Cancelled (returns unchanged)</option><option value="platform-retry">Platform retry (OS-owned)</option><option value="unavailable">Unlock unavailable</option></select></div>
<main class="screen" aria-label="Returning doctor quick unlock">
 <header class="intro"><img class="login-logo" src="../../brand/truemeds-for-doctors.svg" alt="truemeds for doctors"><div class="head"><h1 class="tm-text-title-lg">Hello, Dr. Kunal</h1><p>Let’s check in on your patients today.</p></div></header>
 <section class="panel" aria-labelledby="ready">
  <div class="tm-notice tm-notice--neutral unlock-notice" id="unlock-notice" role="status" hidden><span class="tm-icon" data-icon="info-circle" aria-hidden="true"></span><span id="unlock-error"></span></div>
  <div class="prompt"><div class="prompt-icon" aria-hidden="true"><span class="tm-icon" id="variant-icon" data-icon="fingerprint"></span></div><h2 id="ready">Ready when you are</h2></div>
 </section>
 <div class="tm-actionbar footer">
  <button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block" id="unlock-action" type="button"><span id="unlock-label">Unlock with fingerprint</span></button>
  <button class="tm-btn tm-btn--quiet tm-btn--lg tm-btn--block" id="fallback" type="button">Use OTP instead</button>
 </div>
</main>
<script>
const params=new URLSearchParams(location.search);
const variant=params.get('capture')||params.get('variant')||'fingerprint';
const ICON={fingerprint:'fingerprint','face':'face-id','screen-lock':'lock','pending':'fingerprint','cancelled':'fingerprint','platform-retry':'fingerprint','unavailable':'fingerprint'};
