.tm-header-task--compact { position: sticky; top: 0; z-index: var(--tm-layer-sticky); display: flex; flex-direction: column; min-height: calc(var(--tm-target-min) * 2 + var(--tm-space-xs)); padding: var(--tm-space-xs) var(--tm-space-page) var(--tm-space-sm); background: var(--tm-surface-brand-subtle); }
