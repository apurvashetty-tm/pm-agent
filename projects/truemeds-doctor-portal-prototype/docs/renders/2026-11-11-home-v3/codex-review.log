.tm-header-task__row { display: flex; align-items: center; gap: var(--tm-space-xs); min-height: var(--tm-target-min); }
.tm-header-task__title { flex: 1; min-width: 0; margin: 0; font-size: var(--tm-font-size-title-sm); line-height: var(--tm-font-lineheight-lg); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }   /* wraps to 2 lines at most */
