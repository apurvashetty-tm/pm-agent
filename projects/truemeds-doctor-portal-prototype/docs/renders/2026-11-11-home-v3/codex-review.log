.tm-btn--primary { background: var(--tm-surface-brand-default); color: var(--tm-content-inverse); }
.tm-btn--primary:hover  { background: var(--tm-surface-interactive-hover); }
.tm-btn--primary:active { background: var(--tm-surface-interactive-pressed); }

/* outlined types draw their 1px border inside (as Figma does) so every type keeps the same height */
.tm-btn--secondary { background: var(--tm-surface-primary); color: var(--tm-content-brand); box-shadow: inset 0 0 0 var(--tm-border-width-default) var(--tm-border-default), var(--tm-shadow-button-secondary); }
.tm-btn--secondary:hover  { background: var(--tm-surface-brand-subtle); }
.tm-btn--secondary:active { box-shadow: inset 0 0 0 var(--tm-border-width-default) var(--tm-border-selected); }

/* RETIRED (RULES §9.1, 2026-10-15): tertiary and ghost are aliases of Quiet. Use .tm-btn--quiet in new work. */
.tm-btn--tertiary, .tm-btn--ghost { background: transparent; color: var(--tm-content-secondary); }
.tm-btn--tertiary:hover, .tm-btn--ghost:hover { background: var(--tm-surface-secondary); color: var(--tm-content-primary); }

/* Destructive outline uses the strong error border (non-text contrast, WCAG 1.4.11): the subtle border was too faint for a full-width button. */
.tm-btn--destructive { background: var(--tm-surface-primary); color: var(--tm-feedback-error-content); box-shadow: inset 0 0 0 var(--tm-border-width-default) var(--tm-border-error-strong); }
.tm-btn--destructive:hover { background: var(--tm-feedback-error-surface); }

/* Quiet (RULES §9.1) — leave / cancel / dismiss / "not now", and icon chrome (close, help). Grey text, no border, no fill.
   Replaces tertiary, ghost and link-styled buttons. SALT's ghost is brand blue and reads as the main action. */
.tm-btn--quiet { background: transparent; color: var(--tm-content-secondary); }
.tm-btn--quiet:hover { background: var(--tm-surface-secondary); color: var(--tm-content-primary); }
/* [PROPOSED] On-dark icon/text button — controls on a dark surface (e.g. the Rx document viewer). Light content, no fill. */
.tm-btn--on-dark { background: transparent; color: var(--tm-content-inverse); }
.tm-btn--on-dark:hover { background: var(--tm-surface-brand-strong); }

/* Call end (RULES §9.1) — ONLY for ending a live call (the phone convention). Solid red. Never for other destructive actions. */
.tm-btn--call-end { background: var(--tm-surface-error-strong); color: var(--tm-content-inverse); }
.tm-btn--call-end:hover, .tm-btn--call-end:active { background: var(--tm-surface-error-strong); filter: brightness(var(--tm-pressed-dim)); }

/* Link — only inside a sentence (RULES §9.1). Standalone actions use a button role. As a button element it still gets a 48px tap height. */
.tm-btn--link { min-height: var(--tm-target-min); background: transparent; color: var(--tm-content-brand); padding-left: 0; padding-right: 0; text-decoration: underline; text-underline-offset: 3px; }   /* raw-ok: optical nudge (underline offset) */

.tm-btn:disabled, .tm-btn[aria-disabled="true"] {
  background: var(--tm-surface-interactive-disabled); color: var(--tm-content-disabled);
  box-shadow: none; cursor: not-allowed;
}
.tm-btn--ghost:disabled, .tm-btn--link:disabled, .tm-btn--quiet:disabled, .tm-btn--tertiary:disabled { background: transparent; }
.tm-btn:focus-visible { outline: var(--tm-focus-ring-width) solid var(--tm-border-focus); outline-offset: var(--tm-focus-ring-offset); }

/* [PROPOSED] Busy state — action in progress (e.g. "Calling…"). Keeps the primary look at full
   strength (a disabled grey would read as unavailable). Not in SALT; pending design-team review. */
/* LOCKED L2 (D-46): loading primary = brand fill, white label and white spinner, on every screen, even when disabled. Never grey or pale. */
.tm-btn--busy, .tm-btn--busy:disabled, .tm-btn--primary[aria-busy="true"]:disabled { background: var(--tm-surface-brand-default); color: var(--tm-content-inverse); cursor: default; }
/* Spinner is solid white with one open gap (LOCKED L2). */
.tm-btn--busy .tm-spinner { display: inline-block; width: var(--tm-spinner-size); height: var(--tm-spinner-size); flex: none; margin-right: var(--tm-space-sm); box-sizing: border-box; border: var(--tm-spinner-ring) solid var(--tm-content-inverse); border-top-color: transparent; border-radius: var(--tm-radius-full); animation: tm-spin var(--tm-duration-spinner) linear infinite; }   /* D-98: sizes and ring colour from tokens */
.tm-btn--busy span > .tm-spinner { vertical-align: -3px; }   /* raw-ok: optical nudge — a spinner inside a label span sits on the text line; as a direct flex child (sign-in) it needs no nudge */
/* A-08 (2026-11-02): spinner→label gap is the spinner's own 8 only. The button's flex gap is dropped while busy so it never stacks to 16. */
.tm-btn--busy { gap: 0; }
@keyframes tm-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .tm-btn--busy .tm-spinner { animation: none; } }
@keyframes tm-pulse-ring {
  0%   { box-shadow: 0 0 0 0 var(--tm-surface-brand-muted); }
  70%  { box-shadow: 0 0 0 var(--tm-space-md) transparent; }
  100% { box-shadow: 0 0 0 0 transparent; }
}
.tm-btn--busy.tm-pulsing { animation: tm-pulse-ring var(--tm-duration-pulse) ease-out infinite; }

/* ---------- Input field [SALT: Input Fields] ---------- */
.tm-field { display: flex; flex-direction: column; gap: var(--tm-space-sm); }   /* label↔field and field↔helper = 8 (RULES §8.3) */
.tm-field__label { font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }
.tm-field__control {
  display: flex; align-items: center; gap: var(--tm-space-sm);
  background: var(--tm-surface-primary);
  border: var(--tm-border-width-default) solid var(--tm-border-default); border-radius: var(--tm-radius-md);
  padding: var(--tm-space-md);
  min-height: var(--tm-target-min); cursor: text;   /* 48px tap target (RULES §8.6) */
}
/* The input fills the whole control, so the full 48px is tappable (not just the text line). */
.tm-field__control > input { align-self: stretch; margin: calc(-1 * var(--tm-space-md)) 0; padding: var(--tm-space-md) 0; }
/* Read-only field (e.g. a closed case): readable, muted, not editable. */
.tm-field--readonly .tm-field__control { background: var(--tm-surface-secondary); border-color: var(--tm-border-subtle); }
.tm-field--readonly .tm-field__control input, .tm-field--readonly .tm-field__control textarea { color: var(--tm-content-secondary); pointer-events: none; }
.tm-field__control:focus-within { border-color: var(--tm-border-focus); }
.tm-field__control input, .tm-field__control textarea, .tm-field__control select {
  flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; resize: vertical;
  font: inherit; font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm);
  color: var(--tm-content-primary);
}
.tm-field__control ::placeholder { color: var(--tm-content-placeholder); }
/* Helper = L3 supporting text, 14/20 (RULES §8.1, D-43). Was body-xs 12/16. */
.tm-field__helper  { font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); color: var(--tm-content-secondary); }
.tm-field--error   .tm-field__control { border-color: var(--tm-border-error-strong); }
.tm-field--error   .tm-field__helper  { color: var(--tm-content-error); }
.tm-field--success .tm-field__helper  { color: var(--tm-content-success); }
.tm-field--disabled .tm-field__control { background: var(--tm-surface-secondary); border-color: var(--tm-border-disabled); color: var(--tm-content-disabled); }
/* [PROPOSED] Four-slot OTP presentation backed by one native input for paste and autofill. */
/* LOCKED L1 (D-46): slots are square 56x56, 24px digits, one tight centred group with an 8px gap. Never stretched, never 16px digits. */
.tm-otp-slots { position: relative; display: flex; justify-content: center; gap: var(--tm-space-sm); }
/* Digit = key content L2 16/24 (RULES §8.1). Boxes share the row width; gaps are the related 16 (RULES §8.3). */
.tm-otp-slots__slot { display: grid; place-items: center; flex: none; width: var(--tm-control-height-lg); height: var(--tm-control-height-lg); box-sizing: border-box; border: var(--tm-border-width-default) solid var(--tm-border-default); border-radius: var(--tm-radius-md); background: var(--tm-surface-primary); color: var(--tm-content-primary); font-size: var(--tm-font-size-title-md); line-height: 1; }   /* raw-ok: line-height 1 centres the digit (geometry) */
.tm-otp-slots:focus-within .tm-otp-slots__slot.is-current { border-color: var(--tm-border-focus); }
.tm-field--error .tm-otp-slots__slot { border-color: var(--tm-border-error-strong); }
.tm-field--disabled .tm-otp-slots__slot { background: var(--tm-surface-secondary); border-color: var(--tm-border-disabled); color: var(--tm-content-disabled); }
.tm-otp-slots__input { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; outline: 0; padding: 0; background: transparent; color: transparent; caret-color: transparent; cursor: text; font-size: 16px; }   /* raw-ok: 16px stops iPhone zoom on focus */
/* [PROPOSED] Fixed text before the input inside a field, e.g. the +91 country code. */
.tm-field__prefix {
  flex-shrink: 0; padding-right: var(--tm-space-sm); border-right: var(--tm-border-width-default) solid var(--tm-border-default);
  font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm);
  font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary);
}

/* [DEPRECATED] Legacy six-box one-time code (D-99): no project uses it; use the four-slot OTP above. Exempt from the token guard as a block. */
/* One real <input> (SMS autofill, paste, screen readers) laid over boxes that only display the digits. */
.tm-otp { position: relative; display: grid; grid-template-columns: repeat(var(--tm-otp-len, 6), minmax(0, 1fr)); gap: var(--tm-space-sm); }
.tm-otp__box {
  height: 52px; display: flex; align-items: center; justify-content: center;
  background: var(--tm-surface-primary); border: 1px solid var(--tm-border-default); border-radius: var(--tm-radius-md);
  font-size: var(--tm-font-size-body-xl); line-height: var(--tm-font-lineheight-md);
  font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary);
}
.tm-otp__box.is-active { border-color: var(--tm-border-focus); box-shadow: inset 0 0 0 var(--tm-border-width-default) var(--tm-border-focus); }
.tm-otp__input {
  position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: 0;
  font-size: 16px;   /* 16px stops iOS zooming in on focus */
  caret-color: transparent; color: transparent; background: transparent;
}
.tm-otp--error .tm-otp__box { border-color: var(--tm-border-error-strong); }
.tm-otp--disabled .tm-otp__box { background: var(--tm-surface-secondary); border-color: var(--tm-border-disabled); color: var(--tm-content-disabled); }

/* ---------- Chip: filter / selection [SALT: Chips › Filters] ---------- */
.tm-chip {
  display: inline-flex; align-items: center; gap: var(--tm-space-xs);
  padding: var(--tm-space-xs) var(--tm-space-md);
  border-radius: var(--tm-radius-full);
  border: var(--tm-border-width-default) solid var(--tm-border-default);
  background: var(--tm-surface-primary); color: var(--tm-content-primary);
  font-family: var(--tm-font); font-size: var(--tm-font-size-body-xs); line-height: var(--tm-font-lineheight-xs);
  font-weight: var(--tm-font-weight-semibold); cursor: pointer;
}
.tm-chip[aria-pressed="true"], .tm-chip--selected { background: var(--tm-surface-brand-subtle); border-color: var(--tm-border-selected); color: var(--tm-content-brand); }
.tm-chip:disabled { color: var(--tm-content-disabled); border-color: var(--tm-border-disabled); cursor: not-allowed; }
/* [PROPOSED] Size lg — touch-size chip (about 46px tall, 14px label) for pick-one choices people tap during a call or on the move
   (dose, interval, duration). SALT's chip is a compact filter chip, too small as a primary tap target. */
.tm-chip--lg { padding: var(--tm-space-md) var(--tm-space-lg); font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); justify-content: center; min-height: var(--tm-target-min); }
/* The compact base chip is for dense desktop tools; on mobile every chip is --lg (48px, RULES §8.6). */
/* Chip layouts (RULES §9.2, 2026-10-15) */
.tm-chip-group { display: flex; flex-wrap: wrap; gap: var(--tm-space-sm); }          /* free-flowing: hug the label, wrap; never squeeze */
.tm-chip-group > .tm-chip { flex: none; white-space: nowrap; }
.tm-chip-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--tm-space-sm); }   /* equal cells; fewer options leave cells empty */
.tm-chip-grid > .tm-chip { width: 100%; justify-content: center; white-space: nowrap; padding-left: var(--tm-space-sm); padding-right: var(--tm-space-sm); }   /* D-54: the column sets the size; 8px side padding only keeps text off the edge (fits "10:00 AM" at 360) */   /* raw-ok: 100% fill (geometry) */
.tm-chip-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }   /* for longer labels (e.g. "10:30 AM") so they never wrap */

/* ---------- Tag / status label [SALT: Chips › Labels & Text] ---------- */
.tm-tag {
  display: inline-flex; align-items: center; gap: var(--tm-space-xs);
  padding: var(--tm-space-2xs) var(--tm-space-sm);
  border-radius: var(--tm-radius-full);
  font-size: var(--tm-font-size-body-3xs); line-height: var(--tm-font-lineheight-2xs);
  font-weight: var(--tm-font-weight-semibold);
  background: var(--tm-surface-tertiary); color: var(--tm-content-secondary);
}
/* [PROPOSED] Size md — 12px label for dense, doctor-facing screens where SALT's 10px tag is too small to read. */
.tm-tag--md { padding: var(--tm-space-2xs) var(--tm-space-sm); font-size: var(--tm-font-size-body-xs); line-height: var(--tm-font-lineheight-xs); }
.tm-tag--info     { background: var(--tm-surface-brand-subtle);   color: var(--tm-content-brand); }
/* Success text on the subtle surface uses the strong green (AA 6.7:1; was 3.99:1, D-47 final concepts). */
.tm-tag--success  { background: var(--tm-surface-success-subtle); color: var(--tm-content-success-strong); }
.tm-tag--warning  { background: var(--tm-surface-warning-subtle); color: var(--tm-content-warning); }
.tm-tag--critical { background: var(--tm-surface-error-subtle);   color: var(--tm-content-error); }
.tm-tag--dark     { background: var(--tm-surface-inverse);        color: var(--tm-content-inverse); }
.tm-tag--neutral  { background: var(--tm-surface-tertiary);       color: var(--tm-content-secondary); }   /* removed / inactive (RULES §9.3) */
/* Reserved width (RULES §9.3): the row text never re-wraps when the status changes. */
.tm-tag--fixed { min-width: calc(var(--tm-space-3xl) * 2); justify-content: center; }

/* ---------- Card [SALT: card surface + tm_core_shadow_card] ---------- */
.tm-card {
  background: var(--tm-surface-primary);
  border-radius: var(--tm-radius-lg);
  box-shadow: var(--tm-shadow-card);
  padding: var(--tm-space-lg);
}
.tm-card--flat { box-shadow: none; border: var(--tm-border-width-default) solid var(--tm-border-subtle); }
.tm-card--tint { background: var(--tm-surface-brand-subtle); box-shadow: none; }

/* ---------- List row [SALT: cart / list items] ---------- */
.tm-row {
  display: flex; align-items: center; gap: var(--tm-space-md);
  padding: var(--tm-space-md) 0;
}
.tm-row + .tm-row { border-top: var(--tm-border-width-default) solid var(--tm-border-subtle); }
.tm-row__main { flex: 1; min-width: 0; }
.tm-row__title { font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-semibold); }
.tm-row__meta  { font-size: var(--tm-font-size-body-xs); line-height: var(--tm-font-lineheight-xs); color: var(--tm-content-secondary); }
/* RULES §9.3: chevron only when the row opens something; read-only rows are muted, not tappable, still readable. */
.tm-row__chevron { flex: none; color: var(--tm-content-tertiary); }
/* Row second line (RULES §9.3, D-54): one short fact on the left (e.g. "Qty 30"), the status tag on the right. The title gets the full width. */
.tm-row__line { display: flex; align-items: center; justify-content: space-between; gap: var(--tm-space-sm); margin-top: var(--tm-space-2xs); }
.tm-row__fact { font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-secondary); }
.tm-row__line > .tm-tag { flex: none; }
.tm-row--tappable { cursor: pointer; min-height: var(--tm-target-min); }
.tm-row--readonly { pointer-events: none; }
.tm-row--readonly .tm-row__title, .tm-row--readonly .tm-row__meta { color: var(--tm-content-secondary); }
.tm-row--readonly .tm-row__chevron { display: none; }
/* Read-only block (RULES §9.3): any content area of a closed task — muted, not tappable, still readable. */
.tm-readonly { pointer-events: none; }
.tm-readonly, .tm-readonly .tm-row__title, .tm-readonly .tm-section-title { color: var(--tm-content-secondary); }
.tm-readonly .tm-row__chevron { display: none; }
.tm-thumb { width: var(--tm-thumb-size); height: var(--tm-thumb-size); flex: none; border-radius: var(--tm-radius-sm); background: var(--tm-surface-secondary); object-fit: contain; }

/* ---------- Divider [SALT: Dividers] ---------- */
.tm-divider { border: 0; border-top: var(--tm-border-width-default) solid var(--tm-border-subtle); margin: var(--tm-space-lg) 0; }

/* ---------- Section label ---------- */
.tm-section-title { font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); margin: 0 0 var(--tm-space-md); }

/* ---------- Notice / inline feedback [SALT: Feedback tokens, Sticky notifications] ---------- */
.tm-notice {
  display: flex; gap: var(--tm-space-sm); align-items: flex-start;
  padding: var(--tm-space-md); border-radius: var(--tm-radius-md);
  border: var(--tm-border-width-default) solid var(--tm-border-brand-subtle);
  background: var(--tm-surface-brand-subtle); color: var(--tm-content-primary);
  /* LOCKED L5 (D-46): notice text is 14/20. */
  font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm);
}
.tm-notice--warning { background: var(--tm-feedback-warning-surface); border-color: var(--tm-feedback-warning-border); }
.tm-notice--error   { background: var(--tm-feedback-error-surface);   border-color: var(--tm-feedback-error-border); }
/* [PROPOSED] Non-error access and empty-state information. */
.tm-notice--neutral { background: var(--tm-surface-secondary); border-color: var(--tm-border-default); }
.tm-notice--neutral .tm-icon { color: var(--tm-content-secondary); }
.tm-notice .tm-icon { width: var(--tm-icon-size-md); height: var(--tm-icon-size-md); flex: none; }   /* feedback-rules: 20px leading icon */
/* Status line (D-74): a long wait that is not an action — e.g. "Calling Ramesh…", "Getting call result…". Plain centred text with a small
   spinner, no shape or fill, so it never reads as a button. Short waits right after a tap keep the busy button (.tm-btn--busy). */
.tm-status-line { display: flex; align-items: center; justify-content: center; gap: var(--tm-space-sm); min-height: var(--tm-space-3xl); font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }
.tm-status-line .tm-spinner { display: inline-block; width: var(--tm-spinner-size-lg); height: var(--tm-spinner-size-lg); flex: none; box-sizing: border-box; border: var(--tm-border-width-thick) solid var(--tm-border-brand-subtle); border-top-color: var(--tm-content-brand); border-radius: var(--tm-radius-full); animation: tm-spin var(--tm-duration-spinner) linear infinite; }
@media (prefers-reduced-motion: reduce) { .tm-status-line .tm-spinner { animation: none; } }
/* Question above two answers (D-62 point 2, e.g. "Are you still on the call?"): plain centred text, no box — a question must not look like a field or a status. */
.tm-notice--question { background: none; border-color: transparent; padding-left: 0; padding-right: 0; justify-content: center; font-size: var(--tm-font-size-body-lg); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }
.tm-notice--question .tm-icon { color: var(--tm-content-brand); }
.tm-notice--warning .tm-icon { color: var(--tm-feedback-warning-content); }
.tm-notice--error   .tm-icon { color: var(--tm-feedback-error-content); }

/* ---------- Toast [SALT: Toasts — bottom centre, one line] ---------- */
.tm-toast {
  /* Round 4 (2026-11-02): a screen with a pinned action bar sets --tm-toast-offset to the bar's height + 16 so the toast sits above the bar. */
  position: fixed; left: 50%; bottom: var(--tm-toast-offset, var(--tm-space-xl)); transform: translateX(-50%);   /* raw-ok: 50% centring (geometry) */
  background: var(--tm-surface-inverse); color: var(--tm-content-inverse);
  /* RULES §9.5 (2026-10-15): dark, 14/20, 12×16 padding, medium radius, one line (two at most). Was 12/16 with 4×8 padding — too small to notice. */
  font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-medium);
  padding: var(--tm-space-md) var(--tm-space-lg); border-radius: var(--tm-radius-md); box-shadow: var(--tm-shadow-secondary);
  width: max-content; max-width: calc(100% - 2 * var(--tm-space-xl)); text-align: center; z-index: var(--tm-layer-toast);   /* raw-ok: 100% fill (geometry) */
}
/* Use only where nothing on screen can show the result. One at a time, about 4 s, role="status" (polite), never takes focus. */

/* Snackbar — UNUSED: a toast never carries an action (RULES §9.5). Candidate to drop.
   [PROPOSED] Snackbar — message + one action (e.g. "Order confirmed · Next order"). SALT's toast is one line with
   no action; this is the minimal compliant surface for a confirmation that carries a next step. Pending design-team review. */
.tm-snackbar {
  position: fixed; left: var(--tm-space-lg); right: var(--tm-space-lg); bottom: var(--tm-space-lg); z-index: var(--tm-layer-snackbar);
  display: flex; align-items: center; gap: var(--tm-space-md);
  padding: var(--tm-space-md) var(--tm-space-lg);
  background: var(--tm-surface-primary); border-radius: var(--tm-radius-lg); box-shadow: var(--tm-shadow-primary);
}
.tm-snackbar__icon { flex: none; display: flex; color: var(--tm-content-success); }
.tm-snackbar__body { flex: 1; min-width: 0; }
.tm-snackbar__title { font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); font-weight: var(--tm-font-weight-semibold); }
.tm-snackbar__text  { font-size: var(--tm-font-size-body-xs); line-height: var(--tm-font-lineheight-xs); color: var(--tm-content-secondary); }

/* ---------- Checkbox / radio / toggle [SALT: Checkboxes, Radio Buttons, Toggles] ---------- */
