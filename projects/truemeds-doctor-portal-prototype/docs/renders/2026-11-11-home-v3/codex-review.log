  /* [Decided D-62, 2026-10-25 — not in SALT yet] (T3): hairline top edge + soft upward shadow so the bar reads as its own layer over white cards. SALT's shadow-primary points down and left the bar merged with the content. */
  background: var(--tm-surface-primary); box-shadow: 0 calc(-1 * var(--tm-border-width-default)) 0 var(--tm-border-default), var(--tm-shadow-bar);   /* option B: deeper so the bar sits above the content */
