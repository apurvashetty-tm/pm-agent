  padding: var(--tm-space-md) var(--tm-space-lg); border: var(--tm-border-width-default) solid var(--tm-border-default); border-radius: var(--tm-radius-md);
  background: var(--tm-surface-primary); font-family: var(--tm-font); cursor: pointer; }
