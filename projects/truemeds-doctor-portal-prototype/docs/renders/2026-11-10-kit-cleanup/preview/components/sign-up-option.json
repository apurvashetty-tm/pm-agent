 "rules": [
  {
   "section": "Design rules 8.7",
   "text": "**Contrast:** all text meets WCAG AA (4.5:1; 3:1 for 24px+ or 18.66px+ bold) on the surface it sits on, including tinted bands and notices. Blue means \"tap me\" (§2.5): links are always `--tm-content-brand`, never grey-and-underlined. Disabled controls are exempt from the contrast rule (WCAG 1.4.3) and keep the design-system disabled style."
  },
  {
   "section": "Design rules 8.6",
   "text": "**Tap targets:** **48px minimum** for everything tappable that is not a link inside a sentence: icon buttons (✕, ?, Back, zoom), buttons, chips, rows, toggles, standalone links. Enlarge the hit area, not the text. Meets Android (48dp) and iOS (44pt); WCAG 2.5.8's floor is 24px. Links inside a sentence follow WCAG 2.5.8's inline exception."
  }
 ],
