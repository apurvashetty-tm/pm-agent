}/* Home render options (2026-11-11 agreed blocks). Copy of ui-screens/home/home-reference.css, trimmed to Home,
   with the agreed blocks. Tokens only. Spacing 8 / 16 / 32 (RULES §8.3). */
*{box-sizing:border-box}
body{margin:0;background:var(--tm-surface-secondary)}
html.capture .review{display:none}
.review{max-width:390px;margin:var(--tm-space-lg) auto;display:flex;flex-direction:column;gap:var(--tm-space-sm);font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm)}   /* raw-ok: review controls match the 390 phone width (not app UI) */
.review p{margin:0;color:var(--tm-content-secondary)}
.phone{width:100%;height:100dvh;margin:0;position:relative;overflow:hidden;display:flex;flex-direction:column;background:var(--tm-surface-brand-subtle);color:var(--tm-content-primary);transform:translateZ(0)}   /* raw-ok: RULES §7 below 768 the app is the screen (100dvh), copied from the approved reference */
@media (min-width:768px){.phone{height:clamp(640px,calc(100vh - 48px),844px);width:calc(clamp(640px,calc(100vh - 48px),844px) * 390 / 844);margin:auto;border:1px solid var(--tm-border-subtle);border-radius:var(--tm-radius-2xl);box-shadow:var(--tm-shadow-header)}}   /* raw-ok: RULES §7 desktop frame geometry, copied from the approved reference */
#background{flex:1;min-height:0;display:flex;flex-direction:column}

/* Header unchanged (D-42, A-07). */
.header{flex:none;display:flex;align-items:center;justify-content:space-between;padding:var(--tm-space-lg) var(--tm-space-lg) 0 var(--tm-space-page)}
.logo{width:166px;height:auto;align-self:flex-start}   /* raw-ok: A-07 lockup width, RULES §8.13 */
.header-actions{display:flex;gap:var(--tm-space-xs);margin:-9px -14px -9px 0}   /* raw-ok: D-67 48px targets step out 14px; copied from the approved reference */

/* Agreed 1: band — logo → title 32 (was 48, L6); title 24/32 (planned rule change: Home band title size). */
.band{flex:none;padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-2xl)}
.band-title{margin:0;font-size:var(--tm-font-size-title-md);line-height:var(--tm-font-lineheight-xl);font-weight:var(--tm-font-weight-semibold);color:var(--tm-content-primary);text-wrap:balance}
.sub{margin:var(--tm-space-sm) 0 0;font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}

.panel{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--tm-surface-primary);border-radius:var(--tm-radius-2xl) var(--tm-radius-2xl) 0 0;padding:var(--tm-space-2xl) var(--tm-space-page) var(--tm-space-xl)}
.scroll{flex:1 1 auto;min-height:0;overflow-y:auto;margin:0 calc(-1 * var(--tm-space-page));padding:0 var(--tm-space-page) var(--tm-space-lg)}   /* the scroll spans the panel so card shadows are not clipped */
.panel > .status{flex:none;margin:0 0 var(--tm-space-lg)}
.footer{flex:none;margin:0 calc(-1 * var(--tm-space-page)) calc(-1 * var(--tm-space-xl))}

/* Agreed 2: rows — neutral icon · label on top (16 regular) · L9 value below. Same anatomy for both rows. */
.stat{display:flex;gap:var(--tm-space-lg);align-items:flex-start}
.stat > .tm-icon{flex:none;color:var(--tm-content-secondary);margin-top:var(--tm-space-2xs)}   /* RULES §8.11 neutral icon, centred on the 24 label line */
.stat-main{flex:1;min-width:0}
.stat-label{margin:0;font-size:var(--tm-font-size-body-lg);line-height:var(--tm-font-lineheight-md);color:var(--tm-content-primary)}
/* Agreed 6: the value line holds the timer and a reserved Add-time slot, so nothing moves when it appears. */
.stat-value{display:flex;align-items:center;justify-content:space-between;gap:var(--tm-space-sm);min-height:var(--tm-target-min)}
.stat-value .slot{flex:none}
.stat-value .slot.is-empty{visibility:hidden}
.stats .tm-divider{margin:var(--tm-space-lg) 0}
.stats-stack{display:flex;flex-direction:column;gap:var(--tm-space-lg)}   /* option B: cards stacked 16 apart (RULES §8.3) */

/* Setup: section title + range, sub-labels, chips, wheel. */
.section-title{margin:0;font-size:var(--tm-font-size-body-lg);line-height:var(--tm-font-lineheight-md);font-weight:var(--tm-font-weight-semibold);color:var(--tm-content-primary)}
.hint{margin:var(--tm-space-sm) 0 0;font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
.sublabel{margin:var(--tm-space-lg) 0 var(--tm-space-sm);font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
.ended-count{margin-bottom:var(--tm-space-2xl)}
.opt-c .ended-count{margin-bottom:var(--tm-space-lg)}   /* option C: two cards stacked, 16 apart */
.presets{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--tm-space-sm)}   /* D-36 Home exception to the 4-column grid (W7) */
.presets .tm-chip{justify-content:center}
/* Approved wheel (D-40): one light-blue band, divider inside, large blue selected values, grey neighbours. */
.col-heads{display:grid;grid-template-columns:1fr 1fr;text-align:center;margin-bottom:var(--tm-space-xs);font-size:var(--tm-font-size-body-md);line-height:var(--tm-font-lineheight-sm);color:var(--tm-content-secondary)}
.columns{position:relative;display:grid;grid-template-columns:1fr 1fr;height:144px}   /* raw-ok: three 48px wheel rows, copied from the approved reference */
.wheel-band{position:absolute;left:0;right:0;top:48px;height:48px;border-radius:var(--tm-radius-md);background:var(--tm-surface-brand-subtle);pointer-events:none}   /* raw-ok: one 48px wheel row, copied from the approved reference */
.wheel-band::after{content:'';position:absolute;left:50%;top:var(--tm-space-xs);bottom:var(--tm-space-xs);width:1px;background:var(--tm-border-default)}   /* raw-ok: hairline divider, copied from the approved reference */
.wheel{position:relative;z-index:1;display:flex;flex-direction:column;border-radius:var(--tm-radius-md)}   /* raw-ok: z-index 1 lifts the wheel values above its own band (local stacking), as the approved reference */
.wheel-item{height:48px;display:flex;align-items:center;justify-content:center;font-size:var(--tm-font-size-title-md);line-height:var(--tm-font-lineheight-lg);color:var(--tm-content-secondary)}   /* raw-ok: 48px wheel row, copied from the approved reference */
.wheel-item.is-selected{color:var(--tm-content-brand);font-size:var(--tm-font-size-title-lg);line-height:var(--tm-font-lineheight-2xl);font-weight:var(--tm-font-weight-semibold)}
.is-busy .wheel-item:not(.is-selected){color:var(--tm-content-disabled)}   /* D-81 F9: wheel locked while Setting… / Adding… */

/* Sheets inside the frame (RULES §9.4); the scrim comes from the central .tm-overlay. */
.overlay{display:flex;flex-direction:column;justify-content:flex-end}
.tm-sheet .hint{margin-top:var(--tm-space-sm)}
.sheet-picker .sublabel:first-child{margin-top:var(--tm-space-lg)}
[hidden]{display:none!important}
// Home render options (2026-11-11 agreed blocks). Reference pictures only: no app state, no network.
// Approved copy from ../../../ui-screens/feedback/messages.json (TMFeedback.msg); NEW copy is marked NEW below.
// Options differ in one way: A = one card, two rows, divider · B = two separate cards · C = as A, and setup's duration choice in a card too.
const $ = (s) => document.querySelector(s);
const M = (k, p) => window.TMFeedback.msg(k, p);
const NEW = {   // NEW copy agreed 2026-11-11 (brief §1)
  duration: 'Availability duration', range: '15 minutes to 10 hours', quick: 'Quick picks', custom: 'Custom',
  rxWritten: 'Prescriptions written today', capHint: 'Up to 10 hours in total',
};
const STATES = {
  'setup-pick':   { label: 'Setup · quick pick chosen', setup: true, duration: 60, count: 0 },
  'setup-custom': { label: 'Setup · custom, no chip', setup: true, duration: 75, count: 0 },
  'setting':      { label: 'Setting…', setup: true, duration: 60, count: 0, busy: 'home.setting' },
  'available':    { label: 'Available', time: '30:00', count: 3 },
  'available-long': { label: 'Available · longest timer (boundary)', time: '9:59:59', count: 3 },
  'near-expiry':  { label: 'Near expiry + Add time', time: '5:00', count: 3, near: true, bar: ['tm-notice--warning', 'clock', 'home.endingSoon'] },
  'add-cap':      { label: 'Add time sheet at the 10-hour cap', time: '5:00', count: 3, near: true, bar: ['tm-notice--warning', 'clock', 'home.endingSoon'], sheet: 585, left: 5 },
  'stop-pending': { label: 'Stop pending (count row only)', count: 3, stopping: true, top: ['tm-notice--neutral', 'info-circle', 'home.stopPending'] },
  'ended':        { label: 'Ended Home with count', setup: true, duration: 30, count: 3, top: ['tm-notice--neutral', 'info-circle', 'home.manuallyEnded'] },
  'offline':      { label: 'Offline (bar notice)', time: '30:00', count: 3, offline: true, bar: ['tm-notice--warning', 'alert-triangle', 'home.offline'] },
};
const q = new URLSearchParams(location.search);
let option = ['a', 'b', 'c'].includes(q.get('option')) ? q.get('option') : 'a';
let state = STATES[q.get('state')] ? q.get('state') : 'available';
const icon = (n, cls = '') => `<span class="tm-icon ${cls}" data-icon="${n}" aria-hidden="true"></span>`;
const chipLabel = (n) => n < 60 ? M('home.presetMinutes', { n }) : n === 60 ? M('home.presetHour') : M('home.presetHours', { n: n / 60 });
const notice = ([tone, ic, key], cls = '') => `<div class="tm-notice ${tone} status ${cls}" role="status">${icon(ic)}<span>${M(key)}</span></div>`;

// Agreed 4: setup wheel 0–10 h (at 10 h minutes 00 only; at 0 h minutes 15/30/45). The add wheel tops out at what is left.
function minutesFor(h, maxMin) { const all = h === 0 ? [15, 30, 45] : [0, 15, 30, 45]; return all.filter((m) => h * 60 + m <= maxMin); }
function column(name, values, current, busy) {
  const i = Math.max(0, values.indexOf(current));
  const rows = [i - 1, i, i + 1].map((j) => (j >= 0 && j < values.length ? values[j] : null));
  // Agreed a11y: each column is a spinbutton (name, value, min/max; arrows step it). Rows are visual only.
  return `<div class="wheel" role="spinbutton" tabindex="0" aria-label="${name}" aria-valuenow="${current}" aria-valuemin="${values[0]}" aria-valuemax="${values.at(-1)}"${busy ? ' aria-disabled="true"' : ''}>${rows.map((v, k) => `<span class="wheel-item${k === 1 ? ' is-selected' : ''}" aria-hidden="true">${v === null ? '' : v}</span>`).join('')}</div>`;
}
function picker(duration, maxMin, busy) {
  const h = Math.floor(duration / 60), m = duration % 60;
  const hours = Array.from({ length: Math.floor(maxMin / 60) + 1 }, (_, v) => v).filter((v) => minutesFor(v, maxMin).length);
  const chips = [15, 30, 45, 60, 120, 180].filter((n) => n <= maxMin);
  return `<p class="sublabel">${NEW.quick}</p>
    <div class="presets">${chips.map((n) => `<button type="button" class="tm-chip tm-chip--lg" aria-pressed="${duration === n}"${busy ? ' disabled' : ''}>${chipLabel(n)}</button>`).join('')}</div>
    <p class="sublabel">${NEW.custom}</p>
    <div class="col-heads"><span>${M('home.hours')}</span><span>${M('home.minutes')}</span></div>
    <div class="columns${busy ? ' is-busy' : ''}"><div class="wheel-band" aria-hidden="true"></div>${column(M('home.hours'), hours, h, busy)}${column(M('home.minutes'), minutesFor(h, maxMin), m, busy)}</div>`;
}
const timeRow = (s) => `<div class="stat"><span>${icon('clock')}</span><div class="stat-main"><p class="stat-label">${M('home.timeRemaining')}</p><div class="stat-value"><p class="tm-value-display" role="timer" aria-live="off">${s.time}</p><span class="slot${s.near ? '' : ' is-empty'}"><button id="add" class="tm-btn tm-btn--secondary" type="button"${s.near ? '' : ' tabindex="-1" aria-hidden="true"'}${s.offline ? ' disabled' : ''}>${M('home.addTime')}</button></span></div></div></div>`;
const countRow = (s) => `<div class="stat"><span>${icon('clipboard-text')}</span><div class="stat-main"><p class="stat-label">${NEW.rxWritten}</p><div class="stat-value"><p class="tm-value-display">${s.count}</p></div></div></div>`;
function stats(s) {
  if (s.stopping) return `<div class="tm-card stats">${countRow(s)}</div>`;   // Agreed: stop-pending shows only the count row (D-47)
  if (option === 'b') return `<div class="stats-stack"><div class="tm-card">${timeRow(s)}</div><div class="tm-card">${countRow(s)}</div></div>`;
  return `<div class="tm-card stats">${timeRow(s)}<hr class="tm-divider">${countRow(s)}</div>`;
}
function setupBody(s) {
  const count = s.count > 0 ? `<div class="tm-card ended-count">${countRow(s)}</div>` : '';   // Agreed 3: only when above 0
  const block = `<h2 class="section-title">${NEW.duration}</h2><p class="hint">${NEW.range}</p>${picker(s.duration, 600, !!s.busy)}`;
  return count + (option === 'c' ? `<div class="tm-card">${block}</div>` : block);
}
function footer(s) {
  const bar = s.bar ? notice(s.bar) : '';
  if (s.setup) {
    const p = s.busy ? `<button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block tm-btn--busy" aria-busy="true" disabled><span class="tm-spinner" aria-hidden="true"></span>${M(s.busy)}</button>`
      : `<button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block">${M('home.setAvailability')}</button>`;
    return `<div class="tm-actionbar footer">${bar}${p}</div>`;
  }
  const dis = s.offline || s.stopping;
  return `<div class="tm-actionbar footer">${bar}<button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block"${dis ? ' disabled' : ''}>${M('home.requestCase')}</button><button class="tm-btn tm-btn--quiet tm-btn--lg tm-btn--block"${s.offline ? ' disabled' : ''}>${M(s.stopping ? 'home.ending' : 'home.endAvailability')}</button></div>`;
}
function sheet(s) {
  const maxMin = 600 - s.left;   // Agreed 4: remaining + added never above 10 hours
  return `<div class="tm-overlay overlay"><section role="dialog" aria-modal="true" aria-labelledby="sheet-title" class="tm-sheet"><header class="tm-sheet__header"><h2 id="sheet-title" class="tm-sheet__title">${M('home.addTitle')}</h2><button class="tm-btn tm-btn--quiet tm-btn--icon tm-sheet__close" aria-label="Close" type="button">${icon('x')}</button></header><div class="tm-sheet__body"><p class="tm-sheet__subtitle">${M('home.addSub')}</p><p class="hint">${NEW.capHint}</p><div class="sheet-picker">${picker(s.sheet, maxMin, false)}</div></div><div class="tm-sheet__actions"><button class="tm-btn tm-btn--primary tm-btn--lg tm-btn--block">${M('home.addConfirm', { n: s.sheet })}</button><button class="tm-btn tm-btn--quiet tm-btn--lg tm-btn--block">${M('home.cancel')}</button></div></section></div>`;
}
function render() {
  const s = STATES[state];
  const title = s.setup ? M('home.titleSetup') : s.stopping ? M('home.titleStopping') : M('home.titleActive');
  const sub = s.setup ? M('home.subSetup') : s.stopping ? M('home.subNoNewCases') : M('home.subActive');
  $('#phone').className = `phone opt-${option} st-${state}`;
  $('#phone').innerHTML = `<div id="background"${s.sheet ? ' inert' : ''}>
    <header class="header"><img class="logo" src="../../../brand/truemeds-for-doctors.svg" alt="Truemeds for doctors"><div class="header-actions">${[['bell', 'home.notifications'], ['help-circle', null], ['user-circle', 'home.profile']].map(([i, k]) => `<button class="tm-btn tm-btn--quiet tm-btn--icon" aria-label="${k ? M(k) : 'Help'}" type="button">${icon(i)}</button>`).join('')}</div></header>
    <section class="band"><h1 class="band-title">${title}</h1><p class="sub">${sub}</p></section>
    <div class="panel">${s.top ? notice(s.top) : ''}<div class="scroll">${s.setup ? setupBody(s) : stats(s)}</div>${footer(s)}</div>
  </div>${s.sheet ? sheet(s) : ''}`;
  window.TMIcons?.render($('#phone'));
  $('#opt').value = option; $('#st').value = state;
}
$('#st').innerHTML = Object.entries(STATES).map(([k, v]) => `<option value="${k}">${v.label}</option>`).join('');
$('#opt').onchange = (e) => { option = e.target.value; render(); };
$('#st').onchange = (e) => { state = e.target.value; render(); };
render();

