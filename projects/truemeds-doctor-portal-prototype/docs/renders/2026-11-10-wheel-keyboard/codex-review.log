// Availability wheel column (D-40, F-04): a real wheel, not a select. Used by Home setup and the Add time sheet (home.js).
// One column = a scroll container showing three rows; the row in the centre band is the value.
//   · touch swipe: the browser's own scrolling (momentum) with CSS scroll-snap → snaps to one row
//   · mouse drag (desktop review): dragged here, with a short momentum, then snapped
//   · mouse wheel / trackpad: native scrolling, snapped
//   · tap the row above / below: one step (as before) · arrow keys: one step · Home / End: first / last
// When the column comes to rest the value is set through onPick (home.js applies the 15-minute minimum and redraws).
// Accessible as before: role listbox with role option rows, aria-selected on the row in the band (roving tab stop).
// Same look: the rows, band and sizes come from home.css; at rest the picture is the approved three-row wheel.
import { h } from "../core/dom.js";

const SETTLE_MS = 120;   // no scroll for this long (and no finger / mouse down) = the wheel has come to rest
const DRAG_SLOP = 4;     // px of mouse travel before a press becomes a drag (a smaller move stays a tap)
const FRICTION = 0.92;   // per-frame velocity decay of the mouse-drag momentum

export function wheelColumn({ name, col, values, current, disabled, onPick }) {
  const at = Math.max(0, values.indexOf(current));
  const items = values.map((val, k) => h("button", {
    type: "button", class: `wheel-item${k === at ? " is-selected" : ""}`, role: "option", "aria-selected": String(k === at),
    tabindex: k === at ? "0" : "-1", disabled, "data-index": String(k),
    onclick: (e) => { if (el.dataset.dragged) { e.preventDefault(); return; } if (k !== at) onPick(val, { col }); },
  }, String(val)));
  const el = h("div", { class: `wheel${disabled ? " is-busy" : ""}`, role: "listbox", "aria-label": name, "data-col": col },
    h("span", { class: "wheel-item wheel-item--empty", "aria-hidden": "true" }), items,
    h("span", { class: "wheel-item wheel-item--empty", "aria-hidden": "true" }));

  const rowH = () => (items[0] && items[0].offsetHeight) || 1;
  const nearest = () => Math.min(values.length - 1, Math.max(0, Math.round(el.scrollTop / rowH())));
  let shown = at;
  function mark(k) {   // the row in the band looks selected while the wheel moves
    if (k === shown) return;
    items[shown]?.classList.remove("is-selected"); items[shown]?.setAttribute("aria-selected", "false");
    items[k]?.classList.add("is-selected"); items[k]?.setAttribute("aria-selected", "true");
    shown = k;
  }
  let held = false, timer = 0, anim = 0;
  function settle() {
    clearTimeout(timer);
    if (disabled || held || anim) return;
    timer = setTimeout(() => {
      if (held || anim || !el.isConnected) return;
      const k = nearest();
      el.classList.remove("is-dragging");
      if (Math.abs(el.scrollTop - k * rowH()) > 1) { el.scrollTo({ top: k * rowH(), behavior: "smooth" }); return; }   // lands, then settles again
      if (k !== at) onPick(values[k], { col });
    }, SETTLE_MS);
  }
  el.addEventListener("scroll", () => { mark(nearest()); settle(); }, { passive: true });
  el.addEventListener("touchstart", () => { held = true; clearTimeout(timer); }, { passive: true });
  const release = () => { held = false; settle(); };
  el.addEventListener("touchend", release, { passive: true });
  el.addEventListener("touchcancel", release, { passive: true });

  // Mouse drag (touch scrolls natively). Snap is off while the mouse moves the wheel, back on when it rests.
  el.addEventListener("pointerdown", (e) => {
    if (disabled || e.pointerType !== "mouse" || e.button !== 0) return;
    cancelAnimationFrame(anim); anim = 0;
    const y0 = e.clientY, top0 = el.scrollTop;
    let lastY = y0, lastT = performance.now(), v = 0, dragging = false;
    held = true; delete el.dataset.dragged;
    const move = (m) => {
      if (!dragging && Math.abs(m.clientY - y0) < DRAG_SLOP) return;
      if (!dragging) { dragging = true; el.dataset.dragged = "1"; el.classList.add("is-dragging"); }
      const t = performance.now();
      v = (lastY - m.clientY) / Math.max(1, t - lastT);   // px per ms, positive = towards later values
      lastY = m.clientY; lastT = t;
      el.scrollTop = top0 + (y0 - m.clientY);
    };
    const up = () => {
      window.removeEventListener("pointermove", move); window.removeEventListener("pointerup", up); window.removeEventListener("pointercancel", up);
      held = false;
      if (!dragging) { settle(); return; }
      setTimeout(() => { delete el.dataset.dragged; }, 0);   // the click that follows a drag is not a tap
      let speed = v * 16;   // px per frame
      const glide = () => {
        if (Math.abs(speed) < 0.5 || !el.isConnected) { anim = 0; settle(); return; }
        el.scrollTop += speed; speed *= FRICTION;
        anim = requestAnimationFrame(glide);
      };
      anim = requestAnimationFrame(glide);
    };
    window.addEventListener("pointermove", move); window.addEventListener("pointerup", up); window.addEventListener("pointercancel", up);
  });

  el.addEventListener("keydown", (e) => {
    if (disabled) return;
    const k = { ArrowUp: at - 1, ArrowDown: at + 1, Home: 0, End: values.length - 1 }[e.key];
    if (k === undefined) return;
    e.preventDefault();
    if (k >= 0 && k < values.length && k !== at) onPick(values[k], { col, focus: true });
  });

  // Puts the selected row in the band. Call once the column is in the page (home.js draw()).
  el.sync = () => { el.scrollTop = at * rowH(); shown = at; };
  return el;
}

// After a redraw: every wheel shows its value in the band; the column the keyboard moved keeps the focus.
export function syncWheels(root, focusCol) {
  root.querySelectorAll(".wheel").forEach((w) => w.sync && w.sync());
  if (focusCol) root.querySelector(`.wheel[data-col="${focusCol}"] .wheel-item.is-selected`)?.focus({ preventScroll: true });
}
// F-05: the phone's keyboard never covers the focused field or the screen's main button. Once, in the shell, for every screen.
// On a phone (below 768 wide, not capture), the app frame is sized to the visual viewport — the space above the keyboard — so a
// pinned bar sits on the keyboard (Android Chrome even when interactive-widget=resizes-content is not honoured; iOS Safari, which
// ignores it). On focus, and whenever the viewport changes while a field has focus, the field (with its label and helper) and the
// screen's main action — the first primary button after the field: Send OTP, Verify & sign in, a sheet's or Prescribe's button —
// are scrolled into that space, 16 px clear of the keyboard (D-44). Where an approved rule hides the pinned bar while typing
// (case page and Prescribe, D-81) the hidden bar is not a main action; the field alone is revealed.
// Desktop (the phone frame with the drawn keyboard) and capture: unchanged — this does nothing there.
const PHONE = "(max-width: 767px)";
const SETTLE = [0, 120, 320, 650];   // the keyboard animates in; reveal again as the viewport settles

const isField = (el) => !!el && (el.tagName === "TEXTAREA" || el.isContentEditable ||
  (el.tagName === "INPUT" && !/^(checkbox|radio|button|submit|reset|range|color|file|hidden)$/i.test(el.type)));
const shown = (el) => !!el && el.getClientRects().length > 0 && !el.closest("[inert], [hidden]") && getComputedStyle(el).visibility !== "hidden";
const scrolls = (el) => { const o = getComputedStyle(el).overflowY; return (o === "auto" || o === "scroll") && el.scrollHeight > el.clientHeight + 1; };

// The screen's main action for a field: the first shown primary button after it in the page (the button right under the field,
// or the pinned bar / sheet button that follows the fields).
export function mainAction(field, frame) {
  return [...frame.querySelectorAll(".tm-btn--primary")]
    .find((b) => (field.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING) && shown(b)) || null;
}

// Scrolls each scroll container around the field so the field box and the action fit inside the visible area.
export function reveal(field, frame, gap) {
  const box = field.closest(".tm-field") || field;
  const action = mainAction(field, frame);
  const vv = window.visualViewport;
  const viewTop = vv ? vv.offsetTop : 0, viewBottom = vv ? vv.offsetTop + vv.height : innerHeight;
  for (let sc = box.parentElement; sc && sc !== document.body; sc = sc.parentElement) {
    if (!scrolls(sc)) { if (sc === frame) break; continue; }
    const r = sc.getBoundingClientRect();
    const top = Math.max(r.top, viewTop), bottom = Math.min(r.bottom, viewBottom);
    const f = box.getBoundingClientRect();
    const a = action && sc.contains(action) ? action.getBoundingClientRect() : null;   // a pinned action outside this scroller stays put
    const uTop = Math.min(f.top, a ? a.top : f.top), uBottom = Math.max(f.bottom, a ? a.bottom : f.bottom);
    let d = 0;
    if (uBottom - uTop + gap <= bottom - top) {               // both fit, the lower one 16 clear of the keyboard: the least movement
      if (uBottom + gap > bottom) d = uBottom + gap - bottom;
      else if (uTop < top) d = uTop - Math.min(gap, bottom - top - (uBottom - uTop) - gap) - top;
    } else d = f.top - top;                                     // not both: the field first, at the top
    if (d) sc.scrollTop += d;
    if (sc === frame) break;
  }
}

export function mountKeyboardAvoid({ mode, frame }) {
  const vv = window.visualViewport;
  if (!vv || !frame || mode === "capture") return;
  const phone = matchMedia(PHONE);
  const css = document.documentElement.style;
  const gap = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--tm-space-lg")) || 16;
  let timers = [], tallest = 0, wide = innerWidth;
  function fit() {
    // Pinch zoom also shrinks the visual viewport: only a keyboard-sized change at normal zoom resizes the app.
    if (!phone.matches || Math.abs(vv.scale - 1) > 0.01) { css.removeProperty("--app-vh"); css.removeProperty("--app-vt"); open(false); return; }
    css.setProperty("--app-vh", `${Math.round(vv.height)}px`);
    css.setProperty("--app-vt", `${Math.round(vv.offsetTop)}px`);
    if (innerWidth !== wide) { wide = innerWidth; tallest = 0; }   // turned: measure again
    tallest = Math.max(tallest, vv.height);
    open(isField(document.activeElement) && vv.height < tallest * 0.8);   // same test as parts.js watchKeyboard (D-81)
  }
  // html.phone-kb while the phone's keyboard is open: a screen whose header sits outside its scroll area (OTP) scrolls as one.
  const open = (on) => document.documentElement.classList.toggle("phone-kb", !!on);
  document.addEventListener("focusout", () => setTimeout(fit, 0));
  function revealSoon() {
    timers.forEach(clearTimeout);
    const el = document.activeElement;
    if (!phone.matches || !isField(el) || !frame.contains(el)) return;
    timers = SETTLE.map((ms) => setTimeout(() => { if (document.activeElement === el) reveal(el, frame, gap()); }, ms));
  }
  vv.addEventListener("resize", () => { fit(); revealSoon(); });
  vv.addEventListener("scroll", fit);
  phone.addEventListener?.("change", fit);
  document.addEventListener("focusin", (e) => { if (isField(e.target)) { fit(); revealSoon(); } });
  fit();
}
