    10	import { h } from "../core/dom.js";
    11	
    12	const SETTLE_MS = 120;   // no scroll for this long (and no finger / mouse down) = the wheel has come to rest
    13	const DRAG_SLOP = 4;     // px of mouse travel before a press becomes a drag (a smaller move stays a tap)
    14	const FRICTION = 0.92;   // per-frame velocity decay of the mouse-drag momentum
    15	
    16	export function wheelColumn({ name, col, values, current, disabled, onPick }) {
    17	  const at = Math.max(0, values.indexOf(current));
    18	  const items = values.map((val, k) => h("button", {
    19	    type: "button", class: `wheel-item${k === at ? " is-selected" : ""}`, role: "option", "aria-selected": String(k === at),
    20	    tabindex: k === at ? "0" : "-1", disabled, "data-index": String(k),
    21	    onclick: (e) => { if (el.dataset.dragged) { e.preventDefault(); return; } if (k !== at) onPick(val, { col }); },
    22	  }, String(val)));
    23	  const el = h("div", { class: `wheel${disabled ? " is-busy" : ""}`, role: "listbox", "aria-label": name, "data-col": col },
    24	    h("span", { class: "wheel-item wheel-item--empty", "aria-hidden": "true" }), items,
    25	    h("span", { class: "wheel-item wheel-item--empty", "aria-hidden": "true" }));
    26	
    27	  const rowH = () => (items[0] && items[0].offsetHeight) || 1;
    28	  const nearest = () => Math.min(values.length - 1, Math.max(0, Math.round(el.scrollTop / rowH())));
    29	  let shown = at;
    30	  function mark(k) {   // the row in the band looks selected while the wheel moves
    31	    if (k === shown) return;
    32	    items[shown]?.classList.remove("is-selected"); items[shown]?.setAttribute("aria-selected", "false");
    33	    items[k]?.classList.add("is-selected"); items[k]?.setAttribute("aria-selected", "true");
    34	    shown = k;
    35	  }
    36	  let held = false, timer = 0, anim = 0;
    37	  function settle() {
    38	    clearTimeout(timer);
    39	    if (disabled || held || anim) return;
    40	    timer = setTimeout(() => {
    41	      if (held || anim || !el.isConnected) return;
    42	      const k = nearest();
    43	      el.classList.remove("is-dragging");
    44	      if (Math.abs(el.scrollTop - k * rowH()) > 1) { el.scrollTo({ top: k * rowH(), behavior: "smooth" }); return; }   // lands, then settles again
    45	      if (k !== at) onPick(values[k], { col });
    46	    }, SETTLE_MS);
    47	  }
    48	  el.addEventListener("scroll", () => { mark(nearest()); settle(); }, { passive: true });
    49	  el.addEventListener("touchstart", () => { held = true; clearTimeout(timer); }, { passive: true });
    50	  const release = () => { held = false; settle(); };
    51	  el.addEventListener("touchend", release, { passive: true });
    52	  el.addEventListener("touchcancel", release, { passive: true });
    53	
    54	  // Mouse drag (touch scrolls natively). Snap is off while the mouse moves the wheel, back on when it rests.
    55	  el.addEventListener("pointerdown", (e) => {
    56	    if (disabled || e.pointerType !== "mouse" || e.button !== 0) return;
    57	    cancelAnimationFrame(anim); anim = 0;
    58	    const y0 = e.clientY, top0 = el.scrollTop;
    59	    let lastY = y0, lastT = performance.now(), v = 0, dragging = false;
    60	    held = true; delete el.dataset.dragged;
    61	    const move = (m) => {
    62	      if (!dragging && Math.abs(m.clientY - y0) < DRAG_SLOP) return;
    63	      if (!dragging) { dragging = true; el.dataset.dragged = "1"; el.classList.add("is-dragging"); }
    64	      const t = performance.now();
    65	      v = (lastY - m.clientY) / Math.max(1, t - lastT);   // px per ms, positive = towards later values
    66	      lastY = m.clientY; lastT = t;
    67	      el.scrollTop = top0 + (y0 - m.clientY);
    68	    };
    69	    const up = () => {
    70	      window.removeEventListener("pointermove", move); window.removeEventListener("pointerup", up); window.removeEventListener("pointercancel", up);
    71	      held = false;
    72	      if (!dragging) { settle(); return; }
    73	      setTimeout(() => { delete el.dataset.dragged; }, 0);   // the click that follows a drag is not a tap
    74	      let speed = v * 16;   // px per frame
    75	      const glide = () => {
    76	        if (Math.abs(speed) < 0.5 || !el.isConnected) { anim = 0; settle(); return; }
    77	        el.scrollTop += speed; speed *= FRICTION;
    78	        anim = requestAnimationFrame(glide);
    79	      };
    80	      anim = requestAnimationFrame(glide);
    81	    };
    82	    window.addEventListener("pointermove", move); window.addEventListener("pointerup", up); window.addEventListener("pointercancel", up);
    83	  });
    84	
    85	  el.addEventListener("keydown", (e) => {
    86	    if (disabled) return;
    87	    const k = { ArrowUp: at - 1, ArrowDown: at + 1, Home: 0, End: values.length - 1 }[e.key];
