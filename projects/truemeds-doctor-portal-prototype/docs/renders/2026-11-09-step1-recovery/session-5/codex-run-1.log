    26	  "not-registered":    { number: P, notice: "not-registered" },
    27	  offline:             { number: P, notice: "offline" },
    28	  "couldnt-send":      { number: P, notice: "couldnt-send" },
    29	  "too-many-tries":    { number: P, notice: "too-many-tries", button: "wait", waitMs: (9 * 60 + 42) * 1000 },
