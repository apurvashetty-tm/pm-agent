    37	  inactive:         { cls: "tm-notice--error", icon: "alert-circle", key: "signin.inactive", role: "alert" },
    38	};
    39	export const STATES = Object.keys(FIXTURES).map((k) => `sign-in_${k}`);
    40	
    41	export function render(host, id, { mode, params = {} }) {
    42	  const key = id.replace(/^sign-in_/, "");
