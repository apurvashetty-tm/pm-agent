    for (let x = x0; x <= x1; x++) for (const y of [y0, y1]) for (let t = 0; t < 2; t++) { const yy = Math.min(h - 1, y + t), xx = (w + gap) * 2 + Math.min(w - 1, x), i = (yy * outp.width + xx) * 4; outp.data.set([...c, 255], i); }
