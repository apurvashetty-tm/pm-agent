L += [f"| `{k}` | {v.get('changedPx', '—')} | {v.get('over8Px', '—')} | {v.get('maxChannel', '—')} | {v.get('shiftedRows', '—')} | {len(v.get('colourBands', []))} | {v['verdict']} |" for k, v in sorted(res.items())]
