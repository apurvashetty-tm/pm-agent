sheet = Image.new('RGB', (W * cols + 20, H * rowsn), 'white')
for i, t in enumerate(tiles): sheet.paste(t, ((i % cols) * (W + 20), (i // cols) * H))
sheet.save(HERE / 'worst-10.png')
