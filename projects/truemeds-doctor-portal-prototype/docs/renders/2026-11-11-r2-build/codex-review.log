    const target = isCase ? url.pathToFileURL(path.join(UI, "case/case.html")).href + `?s=${id}&start=case${w === 360 ? "&w=360" : ""}&capture=1`
      : url.pathToFileURL(path.join(UI, SOURCE[sub])).href + (sub === "home" ? `?capture=1&state=${state}` : `?capture=${state}`);
