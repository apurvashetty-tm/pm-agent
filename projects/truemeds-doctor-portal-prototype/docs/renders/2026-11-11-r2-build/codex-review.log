/* Shell styles (plan v3 B5, RULES §7). Tokens only: --tm-* from design-system/truemeds.css. No hex colours, no emoji. */

/* ---- base ---- */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  font-family: var(--tm-font-family-plus-jakarta-sans), system-ui, sans-serif;
  font-size: var(--tm-font-size-body-md);
  line-height: var(--tm-font-lineheight-md);
  color: var(--tm-content-primary);
  background: var(--tm-surface-secondary);
}
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
[hidden] { display: none !important; }

/* ---- stage and frame ---- */
/* Below 768px the app is the screen. From 768px it sits in a centred 390 : 844 frame (RULES §7.2, D-97). */
#stage { position: fixed; inset: 0; }
.shell-frame {
  position: fixed; inset: 0;
  display: flex; flex-direction: column;
  background: var(--tm-surface-primary);
  .shell-frame {
    position: relative; inset: auto;
    height: var(--frame-h); width: var(--frame-w);
    border-radius: var(--tm-core-radius-32);
    border: 1px solid var(--tm-border-default);
  }
  .review-panel { top: var(--frame-top); left: calc(50% + var(--frame-w) / 2 + 24px); width: min(420px, calc(50vw - var(--frame-w) / 2 - 36px)); max-height: none; }
  .rp-row > summary { min-height: 28px; }
  .review-panel label { margin: 2px 0; }   /* one column on the right, top edge = frame top (RULES §7.5, D-97) */
  .drawer-handle, .drawer-backdrop { display: none !important; }
  .shell-notice { position: absolute; }
}

/* ---- phone: the panel is a hidden drawer that slides up from the bottom (plan §4) ---- */
@media (max-width: 767px) {
  /* F-05: the app fills the space above the phone's keyboard (visual viewport, set by shell/keyboard.js; full screen without it). */
  .shell-frame { top: var(--app-vt, 0px); bottom: auto; height: var(--app-vh, 100%); }   /* raw-ok: fallbacks = the full screen (inset 0) */
  .review-panel {
    left: 0; right: 0; bottom: 0; top: auto;
    position: fixed;
    max-height: 80vh; overflow-y: auto; /* phone drawer: the one place controls scroll, so every control stays reachable */
    border-radius: var(--tm-core-radius-16) var(--tm-core-radius-16) 0 0;
    transform: translateY(100%);
    visibility: hidden;   /* closed: off screen and out of the tab order / accessibility tree (hidden after the slide) */
    transition: transform .2s ease, visibility 0s linear .2s;
    box-shadow: none;
  }
  body.drawer-open .review-panel { transform: translateY(0); visibility: visible; transition: transform .2s ease; }
  /* phone: every control in the drawer is a 48px target (RULES §9) */
  .review-panel select, .review-panel .tm-btn, .review-panel .rp-fill { min-height: 48px; }
