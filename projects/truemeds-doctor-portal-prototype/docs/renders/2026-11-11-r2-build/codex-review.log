   The screen fills the app frame (RULES §7). No Back — first screen when the app opens (D-47). */
.unlock-screen { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; position: relative;   /* raw-ok: 100% fill (geometry) */
  background: var(--tm-surface-brand-subtle); color: var(--tm-content-primary); font-family: var(--tm-font); }
/* D-81 F8: tile at the offer position (panel top + 32). It scrolls above the pinned bar on short phones (lane D). */
.unlock-screen .panel { overflow-y: auto; }
/* Round 4 item 1: the pinned footer is the real .tm-actionbar, a sibling below the panel. Two buttons (D-105). */
.unlock-screen .footer { flex: none; margin: 0; }
/* A-19 / D-108: a whole-screen notice ("isn't available") sits at the top of the panel; it is not in the bar. */
.unlock-screen .unlock-notice { margin: 0; }
.unlock-screen .unlock-notice .tm-icon { width: var(--tm-icon-size-md); height: var(--tm-icon-size-md); flex: none; }
.unlock-screen .prompt { margin: 0; display: flex; flex-direction: column; align-items: center; gap: var(--tm-space-lg); text-align: center; }
.unlock-screen .prompt-icon { width: var(--tm-icon-tile-size); height: var(--tm-icon-tile-size); display: grid; place-items: center; border-radius: var(--tm-radius-lg); background: var(--tm-surface-brand-subtle); color: var(--tm-content-brand); }
.unlock-screen .prompt-icon .tm-icon { width: var(--tm-icon-size-xl); height: var(--tm-icon-size-xl); }
/* Caption: its ink sits 16 under the tile (D-108 applied; text trimmed to the ink). */
.unlock-screen h2 { margin: 0; font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); text-box: trim-both cap text; }
.unlock-screen [hidden] { display: none !important; }
/* Home (v3, D-106) and Profile. Band and panel: band.css (D-107). Below the band, D-108 visible gaps: text blocks are trimmed to
   their ink (text-box cap / text) so the box gaps below are what the eye sees. Tokens only. The screen fills the app frame (RULES §7). */
.home-screen { height: 100%; position: relative; overflow: hidden; display: flex; flex-direction: column; background: var(--tm-surface-brand-subtle); color: var(--tm-content-primary); }   /* raw-ok: 100% fill (geometry) */
.home-bg { flex: 1; min-height: 0; display: flex; flex-direction: column; }
/* The content scrolls above the pinned bar, 16 clear of it at the end (§8.14). */
.home-screen .scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding-bottom: var(--tm-space-lg); }
/* A whole-screen notice (ending, ended) sits at the top of the panel, then 32 to the content (D-108). */
.home-screen .panel > .status { flex: none; margin: 0 0 var(--tm-space-2xl); }
/* Duration picker (setup and the add-time sheet, D-106): "Quick picks" → 32 → "Custom" → column heads 4 → wheel. */
.home-screen .group + .group { margin-top: var(--tm-space-2xl); }
.home-screen .lbl { margin: 0; font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); text-box: trim-both cap text; }
.home-screen .group > .lbl, .home-screen .lbl-row { margin-bottom: var(--tm-space-sm); }   /* group label → its control 8 */
.home-screen .lbl-row { display: flex; align-items: last baseline; justify-content: space-between; gap: var(--tm-space-sm); }
.home-screen .hint { margin: 0; flex: none; text-align: right; font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); color: var(--tm-content-secondary); text-box: trim-both cap text; }
.home-screen .presets { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--tm-space-sm); }
.home-screen .presets .tm-chip { justify-content: center; }
/* Column heads: their ink starts 8 under "Custom"; the wheel keeps its 4 (box) under them (component anatomy, D-40). */
.home-screen .col-heads { display: grid; grid-template-columns: 1fr 1fr; text-align: center; margin-bottom: var(--tm-space-xs); font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); color: var(--tm-content-secondary); }
.home-screen .col-heads > span { text-box: trim-start cap text; }
.home-screen .columns { position: relative; display: grid; grid-template-columns: 1fr 1fr; height: calc(3 * var(--tm-target-min)); }
.home-screen .wheel-band { position: absolute; left: 0; right: 0; top: var(--tm-target-min); height: var(--tm-target-min); border-radius: var(--tm-radius-md); background: var(--tm-surface-brand-subtle); pointer-events: none; }
.home-screen .wheel-band::after { content: ""; position: absolute; left: 50%; top: var(--tm-space-xs); bottom: var(--tm-space-xs); width: var(--tm-border-width-default); background: var(--tm-border-default); }   /* raw-ok: 50% centring (geometry) */
/* F-04: each column is a scroll container (three rows visible) that snaps one row into the band; wheel.js sets the value at rest. */
.home-screen .wheel { position: relative; z-index: var(--tm-layer-raised); display: flex; flex-direction: column; background: transparent;
  height: calc(3 * var(--tm-target-min)); overflow-y: auto; overscroll-behavior: contain; scroll-snap-type: y mandatory; scrollbar-width: none; touch-action: pan-y; }
.home-screen .wheel::-webkit-scrollbar { display: none; }
.home-screen .wheel.is-dragging { scroll-snap-type: none; cursor: grabbing; }
.home-screen .wheel.is-busy { overflow-y: hidden; }
.home-screen .wheel-item { flex: none; scroll-snap-align: center; height: var(--tm-target-min); border: 0; background: transparent; font: inherit; font-size: var(--tm-font-size-title-md); line-height: var(--tm-font-lineheight-lg); color: var(--tm-content-secondary); cursor: pointer; padding: 0; }
.home-screen .wheel-item.is-selected { color: var(--tm-content-brand); font-size: var(--tm-font-size-title-lg); line-height: var(--tm-font-lineheight-2xl); font-weight: var(--tm-font-weight-semibold); }
.home-screen .wheel-item--empty { height: var(--tm-target-min); scroll-snap-align: none; }
.home-screen .wheel-item:disabled { color: var(--tm-content-disabled); cursor: not-allowed; }
.home-screen .wheel-item.is-selected:disabled { color: var(--tm-content-brand); }   /* D-81 F9: the selected value keeps its brand text while busy */
/* Available card (D-106): one tm-card (as on the case page), rows of one anatomy: grey icon · 16/24 label · L9 value. */
.home-screen .home-card { padding: 0 var(--tm-space-lg); }
.home-screen .home-card + .picker { margin-top: var(--tm-space-2xl); }   /* ended Home: the count row → 32 → the picker */
.home-screen .srow { display: flex; align-items: flex-start; gap: var(--tm-space-md); width: 100%; padding: var(--tm-space-lg) 0; box-sizing: border-box;   /* raw-ok: 100% fill (geometry) */
  background: none; border: 0; margin: 0; font: inherit; color: inherit; text-align: left; }
.home-screen .srow + .srow { border-top: var(--tm-border-width-default) solid var(--tm-border-subtle); }
.home-screen .srow--link { cursor: pointer; }
.home-screen .srow--link:focus-visible { outline: var(--tm-focus-ring-width) solid var(--tm-border-focus); outline-offset: var(--tm-focus-ring-offset); }
.home-screen .srow__icon { flex: none; margin-top: 2px; color: var(--tm-content-secondary); }   /* raw-ok: 2px optical nudge, icon centred on the 24 label line */
.home-screen .srow__txt { flex: 1; min-width: 0; display: block; }
.home-screen .srow__label { display: block; margin: 0; font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); color: var(--tm-content-primary); }
/* Add time sits on the value line, centred on the timer (compact secondary, like View Rx). */
.home-screen .srow__line { display: flex; align-items: center; justify-content: space-between; gap: var(--tm-space-md); margin-top: var(--tm-space-xs); }
.home-screen .srow__value { margin: 0; }
.home-screen .srow__chev { flex: none; align-self: center; color: var(--tm-content-secondary); }
.home-screen .add-time { flex: none; }
/* Setup caption "Available until 7:45 PM": L3 centred, 8 above Set availability (bar caption). */
.home-screen .until { margin: 0; text-align: center; font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); color: var(--tm-content-secondary); text-box: trim-both cap text; }
.home-screen .until b { color: var(--tm-content-primary); font-weight: var(--tm-font-weight-semibold); }
.home-screen .tm-status-line { text-align: center; text-wrap: balance; }   /* A-11: Checking… centred like the case page */
/* Round 4 item 1: the pinned footer is the real action bar, edge to edge on the panel, on the phone's bottom edge. */
.home-screen .footer { flex: none; margin: 0 calc(-1 * var(--tm-space-page)) calc(-1 * var(--tm-space-xl)); }
.home-screen .footer > .tm-status-line { margin-bottom: 0; }
/* Toast sits above the whole bar, 16 over its top edge (feedback rules §5), never over the button. */
.home-screen .footer > .home-toast { position: absolute; bottom: calc(100% + var(--tm-space-lg)); white-space: nowrap; }   /* raw-ok: 100% = the bar's own height (geometry) */
/* Sheets sit inside the frame over the pinned bar (Round 6); the Home scrim is the light overlay of the approved pictures. */
.home-screen .app-overlay { background: rgb(0 0 0 / calc(var(--tm-overlay-subtle) * 1%)); }   /* raw-ok: scrim is black at the overlay-token opacity (SALT has no black semantic colour) */
/* Add-time error: inside the pinned actions, 16 above Add (8 actions gap + 8), left-aligned box (D-106). */
.home-screen .tm-sheet__actions > .sheet-feedback { margin: 0 0 var(--tm-space-sm); }

/* D-70 Profile page: task header with Back, grey page, white cards at the 16 page margin, Log out last. */
.home-screen.is-profile { background: var(--tm-surface-secondary); }
.profile-page { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--tm-surface-secondary); }
.profile-header { flex: none; background: var(--tm-surface-brand-subtle); padding: var(--tm-space-xs) var(--tm-space-page) var(--tm-space-xs) var(--tm-space-xs); }
.profile-body { flex: 1; overflow: auto; padding: var(--tm-space-lg) var(--tm-space-page) calc(var(--tm-space-xl) + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: var(--tm-space-lg); }
.profile-identity { display: flex; align-items: center; gap: var(--tm-space-md); padding: var(--tm-space-lg); }
.profile-avatar { flex: none; width: var(--tm-space-3xl); height: var(--tm-space-3xl); border-radius: var(--tm-radius-full); background: var(--tm-surface-brand-subtle); color: var(--tm-content-brand); display: flex; align-items: center; justify-content: center; font-weight: var(--tm-font-weight-semibold); }
.profile-page .pt-t { margin: 0; font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }
.profile-page .pt-d { margin: 0; font-size: var(--tm-font-size-body-md); line-height: var(--tm-font-lineheight-sm); color: var(--tm-content-secondary); }
.profile-earnings { padding: var(--tm-space-lg); }
.profile-label { margin: 0 0 var(--tm-space-sm); font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); font-weight: var(--tm-font-weight-semibold); color: var(--tm-content-primary); }   /* A-20 */
.profile-earnings-row { display: flex; gap: var(--tm-space-2xl); }
.profile-rows { padding: 0 var(--tm-space-lg); }
.profile-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: var(--tm-space-3xl); padding: var(--tm-space-sm) 0; background: none; border: 0; font: inherit; color: var(--tm-content-primary); cursor: pointer; text-align: left; }   /* raw-ok: 100% fill (geometry) */
.profile-row + .profile-row { border-top: var(--tm-border-width-default) solid var(--tm-border-subtle); }
.profile-row-label { display: flex; align-items: center; gap: var(--tm-space-sm); font-size: var(--tm-font-size-body-lg); line-height: var(--tm-font-lineheight-md); }
.profile-row .tm-toggle { flex: none; }
.profile-logout { margin-top: 0; }
