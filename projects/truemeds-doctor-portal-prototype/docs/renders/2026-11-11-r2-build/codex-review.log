  if (f.expired) return notice('neutral', M('home.expiredPending'), 'status');
  if (f.ended === 'idle') return notice('neutral', M('home.idleExpired'), 'status');
  if (f.ended === 'manual') return notice('neutral', M('home.manuallyEnded'), 'status');
