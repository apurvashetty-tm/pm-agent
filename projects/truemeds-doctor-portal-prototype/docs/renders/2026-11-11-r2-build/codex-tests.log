    now: () => t, tick: (ms) => { t += ms; }, value: (k) => value(k, "review"),
    db: { get: (k) => (mem.has(k) ? JSON.parse(mem.get(k)) : null), set: (k, v) => mem.set(k, JSON.stringify(v)) },
