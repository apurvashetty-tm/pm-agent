%%{init: {'theme':'base','themeVariables':{'fontFamily':'Helvetica, Arial, sans-serif','fontSize':'15px','primaryColor':'#ffffff','primaryBorderColor':'#9aa4b2','lineColor':'#6b7280','primaryTextColor':'#1f2328'}}}%%
flowchart LR
  R["1 · Ready to call"]:::n -->|"tap Call patient"| C["2 · Calling<br/><small>status line · script shown · no Callback</small>"]:::n
  R -->|"Back (before patient answers)"| L["7e · Leave this case?<br/><small>Release case → Home / Stay</small>"]:::n

  subgraph LAUNCH["Pilot launch flow · B (CW-F1)"]
    G0["B1 · Calling, before the gate<br/><small>neutral script · status line</small>"]:::n
    G1["B1 · Confirm prescription<br/><small>Confirm · Skip HA</small>"]:::n
    G2["B2 · Checking for a Health Advisor"]:::n
    G3["B3 · Forwarded, no HA free<br/><small>waits for the hang-up</small>"]:::warn
  end
  C -->|"Pilot Value Meds"| G0
  G0 -->|"gate passed, call live"| G1
  G1 -->|"Confirm"| G2
  G2 -->|"HA free"| T13
  G2 -->|"none free"| G3

  subgraph FAIL["Call doesn't connect"]
    NT["3 · Didn't go through<br/><small>doctor side · Call again</small>"]:::err
    DM["4 · You didn't answer<br/><small>doctor side · Call again</small>"]:::warn
    PU["9 · Patient unavailable<br/><small>patient side · system holds and retries</small>"]:::neu
  end
  C -->|"request / network error (doctor side)"| NT
  C -->|"doctor didn't pick up"| DM
  C -->|"patient-side failure, any time"| PU

  subgraph GATE["After the call · 50-second gate"]
    RW["5 · Getting call result<br/><small>only after a known hang-up</small>"]:::n
    EE["6 · Call too short<br/><small>Call again · Callback</small>"]:::warn
    V4["8a · Confirm prescription<br/><small>Cat4 / HA skipped · only button</small>"]:::n
    BL["8c · Confirm blocked<br/><small>medicine still Pending</small>"]:::err
    OK["10a · Prescription confirmed"]:::ok
    VF["8b · Confirm &amp; forward · Skip HA<br/><small>Non-Value Meds</small>"]:::n
    FW["10b · Forwarded to HA"]:::ok
  end
  C -->|"call ended (Pilot: hang-up event)"| RW
  C -->|"call ended (Cat4: result only)"| CK
  RW -->|"talk time under 50 s"| EE
  RW -->|"valid · Cat4"| V4
  V4 -->|"Confirm"| OK
  V4 -.->|"Pending medicine"| BL
  RW -->|"valid · Non-Value"| VF
  VF -->|"Confirm & forward (on the partner's result)"| FW

  subgraph S7["No call result"]
    Q["7b · Are you still on the call?<br/><small>only when the end can't be known</small>"]:::n
    CK["7c · Checking call result"]:::n
    RM["7d · Result not received<br/><small>Cat4: Confirm prescription · Pilot: Confirm &amp; forward<br/>+ Callback · Unavailable</small>"]:::warn
    SUB["7f · Waiting for the call record<br/><small>under the gate or no record → not confirmed → hold and retry</small>"]:::neu
  end
  C -->|"3 min, end unknown"| Q
  Q -->|"Yes"| C
  Q -->|"No, call ended"| CK
  CK -->|"nothing found"| RM
  RM -->|"Confirm"| SUB

  subgraph TR["Transfer case · Pilot Value Meds (later version, A)"]
    T11["11 · Calling (transfer)<br/><small>status line · no Callback</small>"]:::n
    T12["12 · Confirm &amp; transfer · Skip HA<br/><small>gate time + call live</small>"]:::n
    T13["13 · Transferring…<br/><small>Skip HA greyed</small>"]:::n
    T14["14 · Transferred to HA"]:::ok
    T15["15 · HA unavailable (transfer couldn't start)<br/><small>live: Waiting for the call to end…</small>"]:::warn
    T15A["15 · after the hang-up<br/><small>Request next case · Back to Home</small>"]:::neu
    T16["16 · Ended before the transfer<br/><small>Confirm &amp; forward · Skip HA</small>"]:::warn
    T17["17 · Skip HA, live<br/><small>Calling… → Getting call result… → Confirm</small>"]:::neu
  end
  C -->|"Value Meds case (A)"| T11
  T11 -->|"gate time since patient answered, call live"| T12
  T12 -->|"Confirm & transfer"| T13
  T13 -->|"HA's phone rings: doctor dropped"| T14
  T13 -->|"transfer can't start"| T15
  T15 -->|"hang-up reported"| T15A
  T12 -->|"call hung up"| T16
  T12 -->|"Skip HA"| T17

  classDef n fill:#ffffff,stroke:#9aa4b2,color:#1f2328
  classDef ok fill:#e8f3ee,stroke:#178755,color:#10603c
  classDef neu fill:#edeef1,stroke:#9aa4b2,color:#1f2328
  classDef warn fill:#fff7e8,stroke:#b57d0f,color:#6b4a05
  classDef err fill:#fdecec,stroke:#c62828,color:#8b1a1a
  style LAUNCH fill:#fafbfc,stroke:#d0d5dc
  style FAIL fill:#fafbfc,stroke:#d0d5dc
  style GATE fill:#fafbfc,stroke:#d0d5dc
  style S7 fill:#fafbfc,stroke:#d0d5dc
  style TR fill:#fafbfc,stroke:#d0d5dc
